{"utterances": [{"speaker": "A", "start": 8.57, "end": 10.43, "text": "\u067e\u06c1\u0644\u06cc \u0628\u0627\u0631 \u062f\u06a9\u06be\u0627 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0622\u067e"}, {"speaker": "A", "start": 11.13, "end": 23.99, "text": "\u06a9\u0627 \u0646\u0627\u0645 \u06c1\u06d2 \u0627\u0639\u062a\u0628\u0627\u0631 \u0645\u062d\u0645\u062f \u0627\u0639\u062a\u0628\u0627\u0631 \u062e\u0627\u0646 \u06cc\u06c1\u06cc \u06c1\u06d2 \u0646\u0627 \u0622\u067e \u06a9\u0627 \u0646\u0627\u0645 \u0627\u0686\u06be\u0627 \u0627\u0639\u062a\u0628\u0627\u0631 \u0635\u0627\u062d\u0628 \u0622\u067e \u062c\u0648 \u06c1\u06d2 \u0633\u062a\u0631\u06c1 \u0633\u0627\u0644 \u0633\u06d2 \u0622\u067e \u06a9\u0648 \u0634\u06af\u0631 \u06c1\u06d2 \u062c\u06cc \u062c\u06cc \u0627\u0648\u0631 \u0622\u067e \u06af\u0648\u0644\u06cc \u0688\u0627\u0624\u0646\u0644 \u0644\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba \u06c1\u0627\u06ba \u0627\u0686\u06be\u0627 \u0627\u0648\u0631 \u0627\u0628\u06be\u06cc \u062a\u06a9\u0644\u06cc\u0641\u06cc\u06ba \u06a9\u06cc\u0627 \u06a9\u06cc\u0627 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06cc\u06ba \u0622\u067e"}, {"speaker": "B", "start": 23.99, "end": 27.27, "text": "\u06a9\u0648 \u0627\u0628\u06be\u06cc \u062a\u06a9\u0644\u06cc\u0641 \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u06c1\u0627\u062a\u06be \u067e\u06cc\u0631\u0648\u06ba \u0645\u06cc\u06ba \u0628\u0627\u0644\u06a9\u0644 \u062f\u0645 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2"}, {"speaker": "A", "start": 27.27, "end": 29.71, "text": "\u062f\u0645 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0627\u0686\u06be\u0627 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2"}, {"speaker": "B", "start": 29.71, "end": 33.15, "text": "\u0627\u067e\u0646\u06d2 \u067e\u06cc\u0631\u0648\u06ba \u0633\u06d2 \u062c\u0648 \u06c1\u06d2 \u0646\u0627 \u0686\u0644"}, {"speaker": "A", "start": 33.15, "end": 34.85, "text": "\u0646\u06c1\u06cc\u06ba \u067e\u0627 \u0631\u06c1\u06d2 \u0622\u067e \u06c1\u0627\u06ba \u0635\u062d\u06cc\u062d \u06c1\u06d2"}, {"speaker": "B", "start": 34.85, "end": 38.83, "text": "\u0627\u0628\u06be\u06cc \u062f\u0645\u0627\u063a \u0686\u06be\u0648\u0679\u0627 \u067e\u06cc\u0634\u0627\u067e \u062c\u0648 \u06c1\u06d2 \u0646\u0627"}, {"speaker": "A", "start": 38.83, "end": 39.19, "text": "\u0622\u062f\u06be\u0627"}, {"speaker": "B", "start": 39.19, "end": 40.31, "text": "\u06af\u06be\u0646\u0679\u06c1 \u0628\u0639\u062f \u0622\u062a\u06cc \u06c1\u06d2"}, {"speaker": "A", "start": 40.31, "end": 43.11, "text": "\u06c1\u0631 \u0622\u062f\u06be\u06d2 \u06af\u06be\u0646\u0679\u06d2 \u0628\u0639\u062f \u0686\u06be\u0648\u0679\u0627 \u067e\u06cc\u0634\u0627\u067e \u0622\u062a\u06cc \u06c1\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0627\u0648\u0631"}, {"speaker": "B", "start": 43.11, "end": 45.89, "text": "\u06a9\u0645\u0632\u0648\u0631\u06cc"}, {"speaker": "A", "start": 45.89, "end": 50.31, "text": "\u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2 \u0628\u06c1\u062a \u0632\u06cc\u0627\u062f\u06c1 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u06cc\u06c1 \u06a9\u0641 \u0633\u06d2 \u0633\u0627\u0631\u06cc \u0686\u06cc\u0632\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u06c1\u0648\u0646\u0627 \u0634\u0631\u0648\u0639 \u06c1\u0648"}, {"speaker": "B", "start": 50.31, "end": 52.85, "text": "\u06cc\u06c1 \u0645\u06cc\u0631\u06d2 \u062e\u06cc\u0627\u0644 \u0645\u06cc\u06ba \u067e\u0627\u0646\u0686"}, {"speaker": "A", "start": 52.85, "end": 55.93, "text": "\u0686\u06be \u0645\u06c1\u06cc\u0646\u06d2 \u0633\u06d2 \u067e\u0627\u0646\u0686 \u0686\u06be \u0645\u06c1\u06cc\u0646\u06d2 \u0633\u06d2 \u06c1\u0648 \u06af\u06cc\u0627 \u06c1\u06d2 \u0634\u06af\u0631 \u062c\u0628 \u0628\u06be\u06cc \u0686\u06cc\u06a9"}, {"speaker": "B", "start": 55.93, "end": 70.59, "text": "\u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u0645\u0691\u0627 \u06c1\u0648\u0627 \u0622\u062a\u0627 \u06c1\u06d2 \u0646\u06c1\u06cc\u06ba \u067e\u06c1\u0644\u06d2 \u062c\u0648 \u06c1\u06d2 \u0646\u0627 \u062f\u0648 \u0688\u0627\u0626\u06cc \u0633\u0648 \u0622\u062a\u0627 \u062a\u06be\u0627 \u06c1\u0645\u0645 \u0627\u0648\u0631 \u0627\u06cc\u06a9 \u062f\u0641\u0639\u06c1 \u0686\u06cc\u06a9 \u06a9\u06cc\u0627 \u062a\u06be\u0627 \u062a\u0648 \u0686\u0627\u0631 \u0633\u0648 \u0622\u0679\u06be \u0627\u0633\u06cc \u0622\u06cc\u0627 \u062c\u0648 \u0622\u062e\u0631 \u0627\u067e\u0646\u06cc \u0628\u0627\u062a \u0686\u06cc\u06a9 \u06a9\u06cc\u0627 \u062a\u06be\u0627 \u06a9\u0633 \u0646\u06d2 \u0688\u0627\u06a9\u0679\u0631 \u0648\u0627\u062c\u062f"}, {"speaker": "A", "start": 70.59, "end": 71.51, "text": "\u06a9\u06d2 \u067e\u0627\u0633 \u0645\u06c1\u06cc\u062f"}, {"speaker": "B", "start": 71.51, "end": 72.37, "text": "\u0627\u0686\u06be\u0627"}, {"speaker": "A", "start": 72.37, "end": 72.95, "text": "\u0645\u06c1\u06cc\u062f \u06a9\u06d2 \u067e\u0627\u0633"}, {"speaker": "B", "start": 72.95, "end": 75.85, "text": "\u06c1\u0627\u06ba \u062a\u0648 \u0627\u0633 \u0646\u06d2 \u0628\u0648\u0644\u0627 \u0648\u06c1\u0627\u06ba \u062c\u0627 \u06a9\u06d2 \u062c\u0648 \u06c1\u06d2 \u0646\u0627"}, {"speaker": "A", "start": 75.85, "end": 82.57, "text": "\u0627\u0686\u06be\u0627 \u0622\u067e \u06a9\u0648 \u0627\u06af\u0631 \u0645\u06cc\u06ba \u0627\u0646\u0633\u0644\u06cc\u0646 \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u0648 \u062a\u0648 \u0644\u06af\u0627 \u0644\u06cc\u06ba \u06af\u06d2 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06af\u0626\u06d2 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0646\u06c1\u06cc\u06ba \u0644\u06af\u0627\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06ba \u06af\u06d2 \u06af\u0648\u0644\u06cc \u067e\u06c1 \u0631\u06c1\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06ba \u06af\u06d2"}, {"speaker": "B", "start": 82.57, "end": 84.19, "text": "\u0622\u062c \u0648\u0632\u0646"}, {"speaker": "A", "start": 85.15, "end": 85.93, "text": "\u0628\u06be\u06cc \u0628\u06c1\u062a \u06af\u0631 \u06af\u06cc\u0627 \u06c1\u06d2"}, {"speaker": "A", "start": 90.17, "end": 90.91, "text": "\u0644\u0627\u0632\u0645\u06cc \u062c\u0628"}, {"speaker": "B", "start": 90.91, "end": 92.05, "text": "\u06a9\u0645\u0632\u0648\u0631\u06cc \u0622\u062a\u0627 \u06c1\u06d2 \u062a\u0648"}, {"speaker": "A", "start": 92.05, "end": 96.5, "text": "\u0648\u0632\u0646 \u062a\u0648 \u06af\u0631\u06d2 \u06af\u0627 \u067e\u0634\u0627\u067e \u0628\u06be\u06cc \u0622\u067e \u0646\u06d2 \u06a9\u06c1\u0627 \u0645\u062c\u06be\u06d2 \u0628\u06c1\u062a \u0632\u06cc\u0627\u062f\u06c1 \u0622 \u0631\u06c1\u0627 \u06c1\u06d2 \u0646\u0627 \u0686\u06be\u0648\u0679\u0627 \u067e\u0634\u0627\u067e"}, {"speaker": "B", "start": 99.93, "end": 101.01, "text": "\u0645\u0631\u062f\u0627\u0646\u06c1"}, {"speaker": "A", "start": 101.01, "end": 102.09, "text": "\u06a9\u0645\u0632\u0648\u0631\u06cc \u0648\u06c1 \u0628\u06be\u06cc \u06c1\u0645 \u062f\u06cc\u06a9\u06be\u062a\u06d2"}, {"speaker": "B", "start": 102.09, "end": 102.17, "text": "\u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 102.17, "end": 103.29, "text": "\u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 105.82, "end": 108.42, "text": "\u067e\u06cc\u0679 \u0645\u06cc\u06ba \u062a\u06a9\u0644\u06cc\u0641 \u062c\u0644\u0646 \u0648\u063a\u06cc\u0631\u06c1 \u062a\u0648 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u0646\u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 108.42, "end": 112.98, "text": "\u0646\u06c1\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0633\u06cc\u0646\u06d2 \u0645\u06cc\u06ba \u0632\u06cc\u0627\u062f\u06c1 \u0628\u06be\u06cc \u0627\u06cc\u0633\u0627 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u06cc\u06c1 \u06cc\u06c1\u0627\u06ba \u062a\u06a9 \u06a9\u0646\u062f\u06d2 \u062a\u06a9"}, {"speaker": "A", "start": 112.98, "end": 113.68, "text": "\u06c1\u0627\u06ba \u06a9\u06c1"}, {"speaker": "B", "start": 113.68, "end": 115.92, "text": "\u06c1\u0645\u0627\u0631\u06d2 \u0628\u062f\u0646 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u06a9\u06cc\u0691\u06d2 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 115.92, "end": 117.44, "text": "\u06a9\u06cc\u0691\u06d2 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba \u06c1\u0627\u06ba"}, {"speaker": "B", "start": 117.44, "end": 122.72, "text": "\u0627\u06cc\u06a9 \u0646\u06c1\u06cc\u06ba \u0627\u06cc\u0633\u0627 \u0644\u06af \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u06c1\u0627\u06ba \u06c1\u0627\u06ba \u06cc\u06c1\u0627\u06ba \u062c\u0648 \u062c\u0648 \u06cc\u06c1\u0627\u06ba \u0646\u0627 \u0648\u06cc\u0688\u06cc\u0648 \u06a9\u0627 \u06a9\u0631\u0646\u0688 \u0644\u06af \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 124.8, "end": 129.66, "text": "\u0645\u06cc\u06ba \u06c1\u0645 \u062a\u0627\u06ba \u0688\u06cc\u0648\u06af\u06d2 \u0688\u06cc\u0648\u06af\u06d2 \u0645\u0631\u0688\u06cc\u0688 \u0627\u06cc\u0645 \u0688\u06cc\u0648\u06af\u06d2 \u0688\u06cc\u0648\u06af\u0644 \u067e\u0644\u0633 \u06c1\u06d2 \u0632\u06cc\u0646\u0688\u0644 \u06c1\u06d2 \u06cc\u06c1 \u0633\u0627\u0631\u06cc \u0686\u06cc\u0632\u06cc\u06ba \u06c1\u06cc\u06ba \u0679\u06be\u06cc\u06a9 \u06c1\u06d2"}, {"speaker": "B", "start": 129.66, "end": 133.88, "text": "\u06a9\u0648\u0626\u06cc \u0679\u06cc\u0633\u0679\u06cc\u06ba \u0648\u063a\u06cc\u0631\u06c1 \u06a9\u0631\u0648\u0627\u0626\u06cc\u06ba \u0622\u067e \u0646\u06d2 \u0627\u067e\u0646\u06d2 \u06c1\u0627\u06ba \u0648\u06c1 \u0627\u06cc\u0645 \u0622\u0631 \u0622\u0626\u06cc \u06a9\u06cc\u0627 \u062a\u06be\u0627"}, {"speaker": "A", "start": 133.88, "end": 134.6, "text": "\u06c1\u0627\u06ba \u0627\u0633"}, {"speaker": "B", "start": 134.6, "end": 136.52, "text": "\u0645\u06cc\u06ba \u062a\u0648 \u062a\u0642\u0631\u06cc\u0628\u0627 \u06a9\u0686\u06be \u0646\u06c1\u06cc\u06ba \u062a\u06be\u0627"}, {"speaker": "A", "start": 136.52, "end": 140.58, "text": "\u0627\u0686\u06be\u0627 \u062c\u0648 \u0688\u0627\u06a9\u0679\u0631 \u0628\u0627\u0632\u062c\u06cc \u06cc\u06c1\u06cc\u06ba \u06a9\u06cc \u06a9\u06cc\u0627 \u0688\u0627\u06a9\u0679\u0631 \u0646\u06d2 \u0628\u06be\u06cc\u062c\u0627 \u06c1\u06d2 \u0646\u0627 \u0645\u06cc\u0631\u06d2 \u067e\u0627\u0633."}, {"speaker": "A", "start": 141.3, "end": 145.65, "text": "\u0646\u06cc\u0627\u0631\u06cc \u0645\u06cc\u06ba \u062c\u0648 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba. \u0646\u06cc\u0627\u0631\u06cc \u0645\u06cc\u06ba \u0628\u06be\u06cc\u062c\u0627 \u06c1\u06d2. \u0635\u062d\u06cc\u062d \u06c1\u06d2. \u0622\u067e \u06a9\u0648\u0646 \u06c1\u06cc\u06ba \u0627\u0646 \u06a9\u06d2?"}, {"speaker": "A", "start": 146.59, "end": 166.55, "text": "\u0628\u06cc\u0679\u06d2 \u06c1\u06cc\u06ba. \u0627\u0686\u06be\u0627 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u0627\u0628\u06be\u06cc \u062c\u0648 \u06c1\u06d2 \u06c1\u0645 \u0627\u0646 \u06a9\u0648 \u06a9\u0686\u06be \u062f\u0648\u0627\u0626\u06cc\u06ba \u0634\u0631\u0648\u0639 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u0634\u06af\u0631 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0633\u0627\u0631\u06cc \u0686\u06cc\u0632\u06cc\u06ba \u062e\u0631\u0627\u0628 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06cc\u06ba. \u0634\u06af\u0631 \u06a9\u06cc\u0627 \u06a9\u0631\u062a\u06cc \u06c1\u06d2 \u06a9\u0648\u0626\u06cc \u0686\u06be\u0648\u0691\u062a\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u06a9\u0648\u0626\u06cc \u0631\u06cc\u0627\u06cc\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0634\u06af\u0631 \u0645\u06cc\u06ba \u0646\u0627. \u0648\u06c1 \u0622\u067e \u06a9\u0648 \u0679\u06cc\u0633 \u0646\u06cc\u0633 \u06a9\u0631 \u062f\u06cc\u062a\u06cc \u06c1\u06d2. \u0627\u0628 \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u06a9\u0628\u06be\u06cc \u06a9\u0628\u06be\u0627\u0631 \u062a\u0648 \u0627\u0646\u0633\u0644\u06cc\u0646 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u067e\u0691\u062a\u06cc \u06c1\u06d2. \u0622\u067e \u0645\u06cc\u0631\u06cc \u0628\u0627\u062a \u0633\u0645\u062c\u06be \u0644\u06cc\u0646\u0627 \u06a9\u06c1 \u06a9\u0628\u06be\u06cc \u06a9\u0628\u06be\u0627\u0631 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0636\u0631\u0648\u0631\u06cc \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u06af\u0648\u0644\u06cc\u0648\u06ba \u067e\u06c1 \u06a9\u0627\u0645 \u0646\u06c1\u06cc\u06ba \u0628\u0646\u062a\u0627 \u06c1\u06d2. \u0645\u0631\u06cc\u0636 \u06a9\u062a\u0646\u0627 \u0628\u06be\u06cc \u0627\u067e\u0646\u06d2 \u0622\u067e \u0633\u06d2 \u0644\u0691 \u0644\u06d2 \u06a9\u06c1 \u0628\u06be\u0626\u06cc \u0646\u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 166.55, "end": 170.63, "text": "\u0645\u06cc\u06ba \u062a\u0648 \u0644\u06af\u0627 \u0645\u062c\u06be\u06d2 \u0622\u067e \u06af\u0648\u0644\u06cc\u0627\u06ba \u062f\u0648 \u062a\u0648 \u06af\u0648\u0644\u06cc\u0627\u06ba \u067e\u06be\u0631 \u0627\u0633 \u06a9\u06d2 \u0633\u0627\u0626\u06cc\u0688 \u0627\u06cc\u0641\u06cc\u06a9\u0679 \u0634\u0631\u0648\u0639 \u06c1\u0648 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0632\u06cc\u0627\u062f\u06c1 \u062f\u0645\u0627\u0626\u06cc."}, {"speaker": "A", "start": 171.45, "end": 191.27, "text": "\u062a\u0648 \u0645\u06cc\u06ba \u0627\u0628\u06be\u06cc \u0627\u0646 \u06a9\u0648 \u0627\u06cc\u06a9 \u062f\u0648\u0627\u0626\u06cc \u0644\u06a9\u06be \u06a9\u0631 \u062f\u0648\u06ba \u06af\u0627 \u062a\u06cc\u0646 \u062f\u0648\u0627\u0626\u06cc \u0634\u06af\u0631 \u06a9\u06cc \u062f\u06d2 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u0627\u06af\u0631 \u0627\u0633 \u067e\u06c1 \u06a9\u0627\u0645 \u0628\u0646 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u0628\u06c1\u062a \u0627\u0686\u06be\u06cc \u0628\u0627\u062a \u06c1\u06d2. \u0627\u0648\u0631 \u0627\u06af\u0631 \u0627\u0633 \u067e\u06c1 \u0627\u0644\u0679\u0631\u0633\u0648\u0646 \u067e\u0631\u0648\u0633\u0679\u06cc\u0679 \u0628\u06be\u06cc \u0622\u0626\u06d2 \u06af\u0627 \u0633\u0627\u062a\u06be \u0645\u06cc\u06ba \u0633\u0648\u0644\u06cc\u0641\u0646 \u0641\u0627\u0626\u06cc\u0648\u0646 \u062c\u06cc \u0635\u0628\u062d \u0645\u06cc\u06ba \u0627\u06af\u0631 \u0627\u0633 \u067e\u06c1 \u06a9\u0627\u0645 \u0628\u0646 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u0634\u06af\u0631 \u06a9\u0646\u0679\u0631\u0648\u0644 \u06c1\u0648 \u062c\u0627\u062a\u06cc \u06c1\u06d2 \u067e\u0634\u0627\u067e \u06a9\u06cc \u0630\u0627\u062a\u06cc \u06c1\u0648 \u062c\u0627\u062a\u06cc \u06c1\u06d2 \u0628\u06c1\u062a\u0631 \u06a9\u0645\u0632\u0648\u0631\u06cc \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u062a\u06cc \u06c1\u06d2 \u062a\u0648 \u0628\u06c1\u062a \u0627\u0686\u06be\u06cc \u0628\u0627\u062a \u06c1\u06d2 \u06c1\u0645 \u06a9\u06c1\u06cc\u06ba \u06af\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0686\u0644\u0646\u06d2 \u062f\u0648 \u0627\u0648\u0631 \u0627\u06af\u0631 \u0634\u06af\u0631 \u06c1\u0627\u0626\u06d2 \u0631\u06c1\u062a\u06cc \u06c1\u06d2 \u062a\u0648 \u067e\u06be\u0631 \u0622\u067e \u06cc\u06c1 \u0627\u06cc\u06a9\u0633\u067e\u06cc\u06a9\u0679 \u0646\u06c1\u06cc\u06ba \u06a9\u0631"}, {"speaker": "A", "start": 191.27, "end": 211.24, "text": "\u0633\u06a9\u062a\u06d2 \u06a9\u06c1 \u06cc\u06c1 \u0633\u0628 \u0686\u06cc\u0632\u06cc\u06ba \u0628\u06c1\u062a\u0631 \u06c1\u0648\u06ba \u06af\u06d2 \u0622\u067e \u0633\u0645\u062c\u06be \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0645\u06cc\u0631\u06cc \u0628\u0627\u062a \u0645\u06cc\u06ba \u0645\u06cc\u0631\u06d2 \u067e\u0627\u0633 \u0645\u0631\u06cc\u0636 \u0622\u062a\u0627 \u06c1\u06d2 \u0645\u0631\u06cc\u0636 \u06a9\u06c1\u062a\u0627 \u06c1\u06d2 \u0688\u0627\u06a9\u0633 \u0635\u0627\u062d\u0628 \u0634\u06af\u0631 \u06a9\u0648 \u0686\u06be\u0648\u0691\u0648 \u0622\u067e \u0622\u067e \u0645\u062c\u06be\u06d2 \u0637\u0627\u0642\u062a \u06a9\u06cc \u062f\u0648\u0627\u0626\u06cc \u062f\u06d2 \u062f\u0648 \u0645\u062c\u06be\u06d2 \u067e\u0634\u0627\u067e \u06a9\u06cc \u062f\u0648\u0627\u0626\u06cc \u062f\u06d2 \u062f\u0648 \u0645\u062c\u06be\u06d2 \u06a9\u0645\u0632\u0648\u0631\u06cc \u06a9\u06cc \u062f\u0648\u0627\u0626\u06cc \u062f\u06d2 \u062f\u0648 \u0645\u062c\u06be\u06d2 \u0633\u0631 \u06a9\u06d2 \u062f\u0631\u062f \u06a9\u06cc \u062f\u0648\u0627\u0626\u06cc \u062f\u06d2 \u062f\u0648 \u0628\u06be\u0627\u0626\u06cc \u062a\u0648 \u0648\u06c1 \u062f\u0648\u0627\u0626\u06cc \u06a9\u0627\u0645 \u06c1\u06cc \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u06d2 \u06af\u06cc \u0646\u0627 \u062c\u0628 \u0634\u06af\u0631 \u0635\u062d\u06cc\u062d \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06af\u06cc \u0622\u067e \u06a9\u06cc \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u062a\u0648 \u0645\u06cc\u0631\u06cc \u0628\u06be\u06cc \u06a9\u0648\u0634\u0634 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u0648 \u0627\u0646\u0633\u0648\u0646\u06cc \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u0646\u06c1 \u067e\u0691\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0645\u06cc\u0631\u06cc \u0628\u06be\u06cc \u06cc\u06c1 \u062e\u0648\u0627\u06c1\u0634"}, {"speaker": "A", "start": 211.24, "end": 217.28, "text": "\u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u0648 \u0627\u0646\u0633\u0648\u0646\u06cc \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u0646\u06c1 \u067e\u0691\u06d2 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0627\u06cc\u06a9 \u067e\u0644\u06cc\u0646 \u0627\u067e\u0646\u0627 \u062f\u06d2 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u062f\u0633 \u062f\u0646 \u06a9\u0627 \u062a\u0648 \u062f\u0633 \u062f\u0646 \u0628\u0639\u062f \u0645\u062c\u06be\u06d2 \u0622\u067e \u062f\u0648\u0628\u0627\u0631\u06c1 \u0648\u06cc\u0688\u06cc\u0648 \u06c1\u0648\u06af\u0627 \u0644\u06a9\u06be"}, {"speaker": "B", "start": 217.28, "end": 218.24, "text": "\u062f\u06cc\u0646\u0627 \u0645\u06af\u0631"}, {"speaker": "A", "start": 218.24, "end": 228.5, "text": "\u0627\u06af\u0631 \u0648\u06c1 \u062f\u0633 \u062f\u0646 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0634\u06af\u0631 \u0627\u0686\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u0622\u062a\u06cc \u06c1\u06d2 \u062a\u0648 \u067e\u06be\u0631 \u0645\u06cc\u06ba \u06a9\u06cc\u0627 \u06a9\u0631\u0648\u06ba \u06af\u0627 \u067e\u06be\u0631 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0627\u0646\u0633\u0648\u0646\u06cc \u067e\u06c1 \u0644\u06d2 \u06a9\u0631 \u0622\u0624\u06ba \u06af\u0627 \u0645\u062c\u0628\u0648\u0631 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0622\u067e \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0622\u0624\u06ba \u06af\u0627 \u062a\u0648 \u067e\u06be\u0631 \u06c1\u0645 \u06a9\u06c1\u06cc\u06ba \u06af\u06d2 \u062e\u062f\u0627 \u062d\u0627\u0641\u0638 \u06a9\u06cc\u0627 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0632\u0628\u0631\u062f\u0633\u062a\u06cc \u062a\u0648"}, {"speaker": "B", "start": 228.5, "end": 232.54, "text": "\u06a9\u0631 \u0646\u06c1\u06cc\u06ba \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06cc\u06c1 \u0686\u0627\u0631\u0679 \u062c\u0648 \u062f\u06cc \u06c1\u06d2 \u0646\u0627 \u0627\u06af\u0631 \u0645\u06cc\u06ba \u0627\u0633 \u06a9\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0648\u06ba \u06af\u0627"}, {"speaker": "A", "start": 232.54, "end": 234.84, "text": "\u0628\u0627\u0644\u06a9\u0644 \u0628\u0627\u0644\u06a9\u0644 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u0645\u06cc\u06ba \u0646\u06d2 \u0622\u067e \u06a9\u0648 \u067e\u06c1\u0644\u06d2 \u06a9\u06cc\u0648\u06ba \u06af\u06cc\u0627 \u062a\u0648"}, {"speaker": "B", "start": 234.84, "end": 237.74, "text": "\u0627\u0646\u0634\u0627\u0621\u0627\u0644\u0644\u06c1 \u0627\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062c\u0648 \u06c1\u06d2 \u0646\u0627 \u0627\u0646\u0634\u0627\u0621\u0627\u0644\u0644\u06c1"}, {"speaker": "A", "start": 237.74, "end": 244.78, "text": "\u0627\u0648\u0631 \u0627\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0634\u06af\u0631 \u0646\u0627\u067e\u0646\u0627 \u0628\u06be\u06cc \u06c1\u06d2 \u0622\u067e \u0646\u06d2 \u0686\u06cc\u06a9 \u0628\u06be\u06cc \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u062a\u0648 \u0634\u06af\u0631 \u06a9\u0648 \u0646\u0627\u067e\u062a\u06d2 \u0628\u06be\u06cc \u0631\u06c1\u06cc\u06d2 \u06af\u0627 \u06a9\u06c1 \u06a9\u0633 \u0637\u0631\u062d \u0633\u06d2 \u0634\u06af\u0631 \u0628\u06cc\u0627\u0626\u06cc\u0641 \u06a9\u0631 \u0631\u06c1\u06cc \u06c1\u06d2 \u06a9\u0633 \u0637\u0631\u062d \u0633\u06d2 \u0627\u0633 \u06a9\u0648 \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2 \u06a9\u06c1 \u0646\u06c1\u06cc\u06ba \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2"}, {"speaker": "B", "start": 244.78, "end": 248.36, "text": "\u0627\u0628\u06be\u06cc \u062c\u0628 \u06a9\u06cc\u0627 \u062a\u06be\u0627 \u062a\u0648 \u0679\u06cc\u0633\u0679 \u06a9\u06cc\u0627 \u062a\u0648 \u062a\u0648 \u062a\u06cc\u0646 \u0633\u0648"}, {"speaker": "B", "start": 248.92, "end": 250.72, "text": "\u067e\u0627\u0646\u0686 \u0633\u0627 \u0627\u0686\u06be\u0627"}, {"speaker": "A", "start": 250.72, "end": 254.54, "text": "\u06a9\u0648\u0626\u06cc \u0628\u0644\u0688 \u067e\u06cc\u0634\u0631 \u06a9\u06cc \u062f\u0648\u0627\u0626\u06cc \u06a9\u06be\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0628\u06cc \u067e\u06cc \u06a9\u0648 \u06a9\u0645\u0633\u062a\u0627 \u0646\u06c1\u06cc\u06ba \u0631\u06c1\u062a\u0627 \u0646\u0627"}, {"speaker": "B", "start": 254.54, "end": 255.74, "text": "\u0648\u0646 \u0641\u0648\u0631\u0679\u06cc"}, {"speaker": "A", "start": 255.74, "end": 275.52, "text": "\u0627\u06cc\u0679\u06cc \u0622 \u0631\u06c1\u0627 \u06c1\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0627\u0648\u0631 \u06a9\u0648\u0626\u06cc \u062d\u0627\u062c\u06cc \u0635\u0627\u062d\u0628 \u0628\u0633 \u06cc\u06c1\u06cc \u06c1\u06d2 \u0633\u0627\u0631\u06cc \u0634\u06a9\u0627\u06cc\u062a \u0627\u0628 \u062f\u0633 \u062f\u0646 \u0628\u0639\u062f \u0622\u067e \u0646\u06d2 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0645\u062c\u06be\u06d2 \u062f\u06a9\u06be\u0627 \u0631\u06c1\u0627 \u06c1\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0646\u0627 \u0627\u0686\u06be\u06cc \u0634\u06af\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0635\u062d\u06cc\u062d \u06c1\u06d2 \u062a\u0648 \u0627\u0628 \u0622\u067e \u0646\u06d2 \u0645\u062c\u06be\u06d2 \u06a9\u0645\u0632\u0648\u0631\u06cc \u0628\u062a\u0627\u0626\u06cc \u0622\u067e \u0646\u06d2 \u0645\u062c\u06be\u06d2 \u0628\u062a\u0627\u06cc\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0645\u062c\u06be\u06d2 \u0686\u0648\u0679\u06cc\u0627\u06ba \u062c\u06cc\u0633\u06cc \u0631\u0646\u06af\u062a\u06cc \u06c1\u06cc\u06ba \u0648\u06cc\u0633\u0627 \u0645\u062d\u0633\u0648\u0633 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2 \u062a\u06a9\u0644\u06cc\u0641\u06cc\u06ba \u062c\u0633\u0645 \u0645\u06cc\u06ba \u0628\u06c1\u062a \u06c1\u06cc\u06ba \u06cc\u06c1 \u06c1\u06d2 \u0627\u0648\u0631 \u06a9\u0648\u0626\u06cc \u0634\u06a9\u0627\u06cc\u062a \u062a\u0648 \u0627\u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06cc\u06ba \u0622\u067e \u06a9\u0648"}, {"speaker": "A", "start": 275.52, "end": 275.94, "text": "\u062f\u06cc\u06a9\u06be \u0644\u06cc\u06ba"}, {"speaker": "B", "start": 275.94, "end": 281.44, "text": "\u0646\u06c1\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0628\u0633 \u06cc\u06c1 \u06c1\u0627\u062a\u06be \u067e\u06cc\u0631 \u062c\u0648 \u06c1\u06d2 \u0646\u0627 \u06cc\u06c1 \u06cc\u06c1 \u0686\u06cc\u0632 \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0627\u0679\u06be\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06cc \u06c1\u06d2"}, {"speaker": "A", "start": 281.44, "end": 292.27, "text": "\u0645\u06cc\u062a\u06be\u06cc \u06a9\u0648 \u0628\u0627\u0644 \u06a9\u0631 \u062f\u0648 \u0628\u06cc\u0679\u06cc \u06a9\u0648 \u0627\u0679\u06be\u0627 \u062a\u0648 \u0628\u0633 \u0627\u0646\u0634\u0627\u0621 \u0627\u0644\u0644\u06c1 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u062f\u0633 \u062f\u0646 \u0628\u0639\u062f \u062f\u0648\u0628\u0627\u0631\u06c1 \u062f\u06cc\u06a9\u06be \u0644\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba \u0635\u062d\u06cc\u062d \u06c1\u06d2 \u0627\u0646 \u06a9\u06d2 \u062c\u0648 \u0622\u067e \u06a9\u0648 \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u0688\u0627\u0626\u06cc\u0679 \u0628\u062a\u0627\u0626\u06cc \u06c1\u06d2 \u0633\u0645\u062c\u06be \u0645\u06cc\u06ba \u06c1\u06cc\u06ba \u0622\u067e"}, {"speaker": "B", "start": 292.27, "end": 293.81, "text": "\u06a9\u0648 \u06c1\u0627\u06ba \u06c1\u0627\u06ba \u0633\u0645\u062c\u06be\u062a\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 293.81, "end": 299.13, "text": "\u06c1\u0627\u06ba \u0645\u0634\u06a9\u0644 \u062a\u0648 \u0646\u06c1\u06cc\u06ba \u0644\u06af\u06cc \u06af\u06cc \u0635\u0627\u062d\u0628 \u062c\u0648 \u0628\u062a\u0627\u0626\u06cc \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0644\u06cc\u06ba \u06af\u06d2 \u0646\u0627 \u0622\u067e \u0627\u0633 \u06a9\u0648 \u0627\u0646\u0634\u0627\u0621"}, {"speaker": "B", "start": 299.13, "end": 301.35, "text": "\u0627\u0644\u0644\u06c1 \u062c\u0648 \u0645\u0634\u06a9\u0644"}, {"speaker": "A", "start": 301.35, "end": 303.53, "text": "\u0627\u0633 \u06a9\u0648 \u0628\u06be\u06cc \u0622\u0633\u0627\u0646 \u06a9\u0631 \u062f\u06cc\u06ba \u0628\u0633 \u06cc\u06c1\u0627\u06ba \u067e\u06c1 \u062a\u0639\u0644\u06cc\u0670 \u0644\u06af\u0627 \u06a9\u06d2"}, {"speaker": "B", "start": 303.53, "end": 304.41, "text": "\u0635\u062d\u06cc\u062d \u06c1\u06d2 \u0679\u06be\u06cc\u06a9"}, {"speaker": "A", "start": 304.41, "end": 308.69, "text": "\u06c1\u06d2 \u0622\u062c\u06cc \u0633\u0631 \u0627\u0646\u0634\u0627\u0621 \u0627\u0644\u0644\u06c1 \u0628\u0633 \u0622\u067e \u0628\u06cc\u0679\u06be\u06cc\u06ba \u0645\u06cc\u06ba \u067e\u0631\u0686\u0627\u0646 \u0628\u06be\u06cc \u062c\u0627\u062a\u0627 \u06c1\u0648\u06ba \u0627\u0648\u06a9\u06d2 \u0627\u0644\u0644\u06c1 \u062d\u0627\u0641\u0638"}], "language": "auto", "duration_s": 310.2, "num_segments": 73}