{"utterances": [{"speaker": "A", "start": 5.93, "end": 9.57, "text": "\u0627\u0646 \u06a9\u0627 \u0648\u0632\u0646 \u0628\u06be\u06cc \u0627\u0648\u0631 \u0627\u0646 \u06a9\u06cc \u06a9\u0645\u0631 \u0645\u06cc\u06ba \u062f\u0631\u0633\u062a\u06d2 \u0645\u06cc\u06ba \u0646\u06d2 \u06cc\u06c1 \u0679\u06cc\u0633\u0679 \u06a9\u0631\u0627\u0626\u06d2 \u06c1\u0627\u06ba"}, {"speaker": "B", "start": 9.57, "end": 15.85, "text": "\u0622\u067e \u0646\u06d2 \u0627\u0686\u06be\u0627 \u06c1\u0648\u0627 \u06a9\u0631\u0648\u0627\u0644\u06cc \u06c1\u06d2 \u0633\u0627\u0631\u06d2 \u0679\u06cc\u0633\u0679 \u0631\u06cc\u067e\u0648\u0631\u0679\u0633\u0648\u06ba \u0645\u06cc\u0631\u06d2 \u067e\u0627\u0633 \u0622\u06af\u0626\u06d2 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u0627\u0633 \u0628\u0686\u06d2 \u06a9\u0627 \u062c\u0648 \u0627\u0646\u0633\u0648\u0644\u06cc\u0646 \u06c1\u06d2 \u0648\u06c1 \u0628\u06c1\u062a \u0628\u0691\u0627 \u06c1\u0648\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 17.8, "end": 19.74, "text": "\u0628\u06cc\u0679\u0627 \u0627\u0646 \u06a9\u0648 \u0628\u0648\u0644\u0646\u0627 \u067e\u0627\u0646\u0686 \u0645\u0646\u0679 \u0628\u0639\u062f \u062f\u0633 \u0645\u0646\u0679 \u0628\u0639\u062f \u06a9\u0631 \u0644\u06cc\u06ba"}, {"speaker": "B", "start": 20.25, "end": 26.64, "text": "\u0627\u0633 \u06a9\u0627 \u062c\u0648 \u0627\u0646\u0633\u0648\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u067e\u0648\u0686\u06be \u0644\u0648 \u06a9\u06c1\u0627\u06ba \u0633\u06d2 \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0627\u0646\u0633\u0648\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0627\u0633 \u06a9\u0627 29 .2 \u067e\u0631 \u0627\u0648\u067e\u0631 \u06c1\u06d2 \u062c\u0648 \u0627\u0633 \u0648\u06cc\u0631\u06cc \u06c1\u06d2 \u0628\u06c1\u062a \u06c1\u0627\u06ba \u06c1\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0648\u0627\u0626\u0679\u06cc\u0645\u0646 \u0688\u06cc\u0632 \u0628\u0686\u06d2 \u06a9\u0627 \u06a9\u0645 \u06c1\u06d2"}, {"speaker": "A", "start": 26.64, "end": 28.88, "text": "\u0648\u0627\u0626\u0679\u06cc\u0645\u0646 \u0688\u06cc\u0632 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u067e\u0631\u06cc\u0634\u0627\u0646 \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u0646\u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 28.88, "end": 31.92, "text": "\u0645\u06cc\u06ba \u062a\u0648 \u0627\u0633 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u067e\u0631\u06cc\u0634\u0627\u0646 \u06c1\u0648\u06ba \u0622\u067e \u06a9\u0648 \u067e\u0631\u06cc\u0634\u0627\u0646 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2 \u0627\u0646\u0633\u0648\u0644\u06cc\u0646 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2"}, {"speaker": "B", "start": 32.46, "end": 33.72, "text": "\u0627\u0646\u0633\u0648\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0628\u06c1\u062a \u0628\u0691\u0627 \u06c1\u0648\u0627 \u06c1\u06d2 \u0627\u0633 \u06a9\u0627"}, {"speaker": "A", "start": 34.2, "end": 38.7, "text": "\u062a\u0648 \u062f\u0648\u0633\u062a\u0648 \u0627\u06cc\u0633\u06d2 \u062a\u0648 \u06a9\u06c1\u0646\u06cc \u06c1\u06d2 \u06a9\u06c1 \u0686\u06cc\u0646\u06cc \u0628\u06be\u0627\u06af \u0631\u06c1\u06cc \u06c1\u06d2 \u0645\u06cc\u0631\u06cc \u0633\u0627\u062a\u06be \u0645\u06cc\u06ba \u06a9\u06cc\u0648\u06ba \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u06cc\u0633\u0627"}, {"speaker": "B", "start": 39.42, "end": 40.7, "text": "\u0641\u06cc\u0632\u06cc\u06a9\u0644 \u0627\u06cc\u06a9\u0679\u06cc\u0648\u0679\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06af\u06cc \u06c1\u06d2"}, {"speaker": "A", "start": 40.7, "end": 41.18, "text": "\u0686\u0644\u0646\u0627"}, {"speaker": "B", "start": 41.18, "end": 41.76, "text": "\u067e\u06be\u0646\u0688\u0646\u0627 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2"}, {"speaker": "A", "start": 41.76, "end": 47.82, "text": "\u0628\u06c1\u062a \u06c1\u06d2 \u06cc\u06c1 \u062a\u0648 \u06c1\u0627\u0641\u06cc \u06c1\u06d2 \u0627\u0646 \u06a9\u0627 \u062a\u0648 \u0628\u06c1\u062a \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u06d2 \u0633\u0631 \u0648\u06c1 \u06c1\u0627\u0626\u0679 \u0627\u067e \u06a9\u0627 \u0628\u0648\u0686\u06be\u0646\u06d2 \u06a9\u06d2 50 \u0627\u06cc\u0645 \u062c\u06cc \u06c1\u06d2 \u06c1\u0627\u0641 \u06a9\u0631"}, {"speaker": "B", "start": 47.82, "end": 49.8, "text": "\u062f\u06cc\u06ba \u0627\u0633 \u06a9\u0648 \u06c1\u0627\u0641 \u06a9\u0631 \u06a9\u06d2 \u0679\u0648\u0626\u0646\u0679\u06cc \u067e\u0627\u0626\u06cc \u06a9\u0631 \u062f\u06cc\u06ba \u0633\u0631"}, {"speaker": "A", "start": 49.8, "end": 53.22, "text": "\u06c1\u0627\u0626\u0679 \u0627\u067e \u06a9\u0627 \u0628\u0648\u0686\u06be\u0646\u06d2 \u06a9\u06d2 50 \u0627\u06cc\u0645 \u062c\u06cc \u06c1\u06d2 \u0627\u0633 \u06a9\u06cc \u0627\u06cc\u062c"}, {"speaker": "B", "start": 53.22, "end": 54.08, "text": "\u06a9\u062a\u0646\u06cc \u06c1\u06d2 \u0628\u0686\u06d2 \u06a9\u06cc"}, {"speaker": "A", "start": 54.96, "end": 57.02, "text": "\u0641\u0648\u0631\u0679\u06cc\u0646 \u067e\u0644\u0633 \u06c1\u06d2 \u0641\u0648\u0631\u0679\u06cc\u0646 \u067e\u0644\u0633 \u06c1\u06d2"}, {"speaker": "B", "start": 58.66, "end": 59.56, "text": "\u0641\u0648\u0631\u0679\u06cc\u0646 \u067e\u0644\u0633 \u06c1\u06d2"}, {"speaker": "B", "start": 61.0, "end": 64.66, "text": "\u0627\u0648\u0631 \u0627\u06cc\u0634\u0648 \u06a9\u06cc\u0648\u06ba \u06a9\u0631\u0648\u0627\u0646\u0627 \u067e\u0691\u0627 \u0622\u067e \u06a9\u0648 \u06cc\u06c1 \u0633\u0627\u0631\u06d2 \u0679\u06cc\u0633\u0679 \u0627\u0633"}, {"speaker": "A", "start": 64.66, "end": 70.12, "text": "\u06a9\u0648 \u0628\u062f\u0646 \u0628\u06c1\u062a \u0628\u0691\u06be \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u0633 \u06a9\u06cc \u0627\u06cc\u06a9 \u0633\u0627\u0644 \u0688\u06cc\u0691\u06be \u0633\u0627\u0644 \u067e\u06c1\u0644\u06d2 \u0646\u06d2 \u0688\u0627\u06a9\u0633\u0679\u0631 \u0627\u0633 \u06a9\u06cc \u0648\u0688\u06cc\u0627 \u0646\u06c1\u06cc\u06ba \u0631\u06a9\u06be \u062f\u06cc"}, {"speaker": "A", "start": 70.72, "end": 79.5, "text": "\u0645\u06cc\u06ba \u0646\u06d2 \u0627\u0645\u0627\u0645 \u0644\u06cc\u0646\u0646\u06af \u0645\u06cc\u06ba \u0688\u0627\u06a9\u0679\u0631 \u06a9\u0648 \u062f\u06a9\u06be\u0627 \u06c1\u06d2 \u0648\u06c1 \u0646\u06d2 \u067e\u062a\u06c1 \u0646\u06c1\u06cc\u06ba \u067e\u062a\u06c1 \u062c\u0627\u0646\u06d2 \u06a9\u0648\u0646 \u06a9\u0648\u0646 \u0633\u06d2 \u0679\u06cc\u0633\u0679 \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u067e\u06be\u0631 \u0648\u06c1 \u0646\u06d2 \u067e\u062a\u06c1 \u0646\u06c1\u06cc\u06ba \u06a9\u0648\u0646 \u0633\u06d2 \u0688\u0648\u0632 \u06c1\u06d2 \u0627\u0633 \u06a9\u0627 \u0628\u06cc \u067e\u06cc \u0628\u06c1\u062a \u0628\u0691\u06be \u06af\u06cc\u0627 \u06c1\u06d2 \u0627\u0633"}, {"speaker": "B", "start": 79.5, "end": 81.88, "text": "\u06a9\u0648 \u0628\u06cc \u067e\u06cc \u0631\u06c1\u062a\u0627 \u06c1\u06d2 \u06a9\u06cc\u0627 \u0646\u06c1\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0627\u06cc\u0633\u0627 \u0646\u06c1\u06cc\u06ba \u0631\u06c1\u062a\u0627 \u0627\u0633 \u06a9\u06cc"}, {"speaker": "A", "start": 81.88, "end": 94.28, "text": "\u06af\u06be\u062a\u06cc \u0645\u06cc\u06ba \u0627\u062a\u0646\u0627 \u0634\u062f\u06cc\u062f \u062f\u0631\u0627\u0635\u0644 \u06af\u06be\u0631 \u0645\u06cc\u06ba \u0622\u067e\u0631\u06cc\u0679\u0631\u0632 \u062a\u06be\u06d2 \u0627\u0645\u06cc \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u062a\u0648 \u0645\u06cc\u06ba \u0646\u06d2 \u0686\u06cc\u06a9 \u06a9\u06cc\u0627 \u062a\u0648 \u0645\u06cc\u06ba \u062a\u0648 \u067e\u0631\u06cc\u0634\u0627\u0646 \u06c1\u0648 \u06af\u0626\u06cc \u067e\u06be\u0631 \u0627\u06cc\u06a9 \u0688\u0627\u06a9\u0679\u0631 \u0645\u0644\u06d2 \u06c1\u0645 \u0627\u06cc\u0645 \u0627\u06cc\u0648 \u067e\u06cc\u062a\u0631 \u06a9\u06cc \u0627\u06cc\u06a9 \u0633\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u0644\u06cc\u0627 \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u0627\u0633 \u06a9\u06d2 \u06c1\u0631 \u0628\u0627\u0631 \u067e\u06cc\u0633 \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0628\u0686\u06d2 \u06a9\u06d2 \u0644\u06cc\u06a9\u0646 \u0645\u0627 \u0634\u0627\u0621 \u0627\u0644\u0644\u06c1 \u0627\u0633 \u06a9\u0627 \u062c\u0648 \u0645\u0633\u0626\u0644\u06c1 \u06c1\u06d2"}, {"speaker": "B", "start": 94.28, "end": 106.84, "text": "\u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0628\u0691\u06be\u0627 \u06c1\u0648\u0627 \u06c1\u06d2 \u0627\u0633 \u06a9\u0627 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0628\u0691\u06be\u0627 \u06c1\u0648\u0627 \u0645\u0637\u0644\u0628 \u06a9\u06cc\u0627 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0646\u06d2 \u0648\u06c1 \u0628\u0627\u062a \u0644\u06cc\u0627 \u062a\u0648 \u0628\u06c1\u062a \u06a9\u0686\u06be \u06a9\u06be\u0627\u062a\u0627 \u067e\u06cc\u062a\u0627 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u06a9\u06c1 \u0627\u06cc\u0633\u0627 \u06a9\u06be\u0627 \u0631\u06c1\u0627 \u06c1\u0648 \u0686\u06cc\u0646\u06cc \u06a9\u06be\u0627 \u0631\u06c1\u0627 \u06c1\u0648 \u0645\u06af\u0631 \u0627\u0633 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0627\u0646\u0641\u0631\u0686\u0646\u06cc\u0679\u0644\u06cc \u06c1\u06d2 \u0628\u0691\u06be\u0627 \u06c1\u0648\u0627 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0627\u0628 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u06a9\u06cc\u0627 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0645\u0633\u062a\u0642\u0644 \u0637\u0648\u0631 \u067e\u0631"}, {"speaker": "B", "start": 106.84, "end": 126.74, "text": "\u0628\u0691\u06be\u0627 \u0631\u06c1\u06d2 \u062a\u0648 \u06c1\u0645 \u0645\u0637\u0644\u0628 \u0628\u062a\u0627 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0627\u0633 \u06a9\u06cc \u06cc\u06c1 \u0641\u06cc\u0632\u06cc\u0648\u0644\u0648\u062c\u06cc \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u06cc\u06c1 \u06a9\u0648\u0644\u06cc\u0633\u0679\u0631\u0648\u0644 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u06a9\u0648 \u0628\u06be\u06cc \u062e\u0631\u0627\u0628 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u0633\u0627\u0631\u06cc \u0686\u06cc\u0632\u0648\u06ba \u06a9\u0648 \u062a\u0648 \u0627\u0628 \u0627\u0633 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u06c1\u0645 \u06cc\u06c1 \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u0646\u06d2 \u0628\u0686\u06d2"}, {"speaker": "B", "start": 126.74, "end": 129.4, "text": "\u06a9\u06cc \u0641\u06cc\u0632\u06cc\u06a9\u0644 \u0627\u06cc\u06a9\u0679\u06cc\u0648\u06cc\u0679\u06cc \u062c\u062a\u0646\u06cc \u0645\u06cc\u06ba \u0627\u0633 \u06a9\u0648 \u0688\u0628\u0644 \u06a9\u0631 \u062f\u06cc\u06ba \u0645\u0644\u0679\u06cc \u067e\u0644\u0627\u0626\u06d2 \u06a9\u0631 \u062f\u06cc\u06ba"}, {"speaker": "A", "start": 129.4, "end": 130.52, "text": "\u06cc\u0639\u0646\u06cc \u0627\u06af\u0631 \u06cc\u06c1"}, {"speaker": "B", "start": 130.52, "end": 135.18, "text": "\u0648\u0627\u06a9 \u06a9\u0631\u0646\u0627 \u0634\u0631\u0648\u0639 \u06a9\u0631 \u062f\u06cc\u06ba \u0633\u0627\u0626\u06cc\u06a9\u0644\u0646\u06af \u0634\u0631\u0648\u0639 \u06a9\u0631 \u062f\u06cc\u06ba \u0633\u0648\u0626\u06cc\u0645\u0646\u06af \u0634\u0631\u0648\u0639 \u06a9\u0631 \u062f\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0628\u06be\u06cc \u0627\u0633 \u06a9\u0648 \u0641\u06cc\u0632\u06cc\u06a9\u0644 \u0627\u06cc\u06a9\u0679\u06cc\u0648\u06cc\u0679\u06cc \u0645\u06cc\u06ba \u0622\u067e \u0627\u0633 \u06a9\u0648 \u0627\u0646\u0648\u0627\u0644\u0641 \u06a9\u0631 \u062f\u06cc\u06ba"}, {"speaker": "A", "start": 135.18, "end": 139.22, "text": "\u0627\u0686\u06be\u06d2 \u0633\u0627\u0626\u06cc\u06a9\u0644 \u0628\u06be\u06cc \u0686\u0644\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0648\u06cc\u0688\u0645\u06cc\u0679\u0646 \u0628\u06be\u06cc \u06a9\u06be\u06cc\u0644\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u0627\u06cc\u06a9\u0679\u06cc\u0648\u06cc\u0679\u06cc"}, {"speaker": "B", "start": 139.22, "end": 154.88, "text": "\u06c1\u06d2 \u0627\u0633 \u06a9\u0648 \u0688\u0628\u0644 \u06a9\u0631 \u062f\u06cc\u06ba \u0627\u0628 \u06cc\u0627 \u062a\u0648 \u0627\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0688\u0628\u0644 \u06a9\u0631 \u062f\u06cc\u06ba \u06cc\u0627 \u067e\u06be\u0631 \u0627\u0633 \u0645\u06cc\u06ba \u0627\u06cc\u0688 \u0622\u0646 \u06a9\u0631 \u062f\u06cc\u06ba \u062c\u06cc\u0633\u06d2 \u0648\u0627\u06a9 \u0634\u0631\u0648\u0639 \u06a9\u0631\u0648\u0627 \u062f\u06cc\u06ba \u0627\u0633 \u06a9\u0648 \u0622\u067e \u0628\u0648\u0644\u06cc\u06ba \u067e\u0686\u06cc\u0633 \u0633\u06d2 \u0633\u06cc\u0633 \u0645\u0646\u0679 \u0648\u0627\u06a9 \u06a9\u0631\u06cc\u06ba \u0627\u0628 \u06cc\u06c1 \u0627\u0633 \u06a9\u0627 \u0627\u067e\u0646\u0627 \u0627\u0633 \u06a9\u0648 \u0633\u0648\u0686\u0646\u0627 \u06c1\u0648\u06af\u0627 \u06a9\u06c1 \u0645\u06cc\u0631\u06d2 \u0644\u0626\u06d2 \u06a9\u062a\u0646\u06cc \u062e\u0637\u0631\u0646\u0627\u06a9 \u0686\u06cc\u0632 \u06c1\u06d2 \u06cc\u06c1 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0628\u0691\u06be\u0646\u0627 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u06cc\u06c1 \u0645\u062c\u06be\u06d2 \u0634\u06af\u0631 \u06a9\u0631\u0648\u0627 \u062f\u06d2 \u06af\u06cc \u067e\u06be\u0631 \u0622\u06af\u06d2 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 155.96, "end": 156.28, "text": "\u0627\u0648\u0631"}, {"speaker": "B", "start": 156.28, "end": 159.18, "text": "\u0627\u0646\u0633\u0644\u06cc\u0646 \u06a9\u0648 \u06a9\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u06c1\u0645 \u062f\u0648\u0627\u0626\u06cc\u0627\u06ba \u0628\u06be\u06cc \u0644\u06a9\u06be\u062a\u06d2 \u06c1\u06cc\u06ba \u06c1\u0645 \u0634\u0631\u0648\u0639 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0686\u06be\u06d2"}, {"speaker": "A", "start": 159.18, "end": 160.9, "text": "\u0644\u0648\u06af \u0633\u0648\u0627\u0644 \u0648\u0632\u0646 \u0628\u06be\u06cc \u0627\u0633 \u06a9\u06cc\u0648\u06ba \u0633\u06d2 \u0628\u0691\u06be\u0627 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u0633\u06cc"}, {"speaker": "B", "start": 160.9, "end": 163.1, "text": "\u0648\u062c\u06c1 \u0633\u06d2 \u062c\u0628 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0628\u0691\u06be\u0627 \u0631\u06c1\u06d2 \u06af\u0627 \u062a\u0648 \u0627\u0633 \u06a9\u0627 \u0648\u06cc\u0688 \u0628\u06be\u06cc \u0628\u0691\u06be\u0627\u0626\u06d2 \u06af\u0627"}, {"speaker": "B", "start": 163.85, "end": 164.55, "text": "\u0627\u0646\u0633\u0644\u06cc\u0646 \u06a9\u06cc\u0627 \u06c1\u06d2"}, {"speaker": "A", "start": 165.43, "end": 165.75, "text": "\u0627\u0646\u0633\u0644\u06cc\u0646"}, {"speaker": "B", "start": 165.75, "end": 167.83, "text": "\u0627\u06cc\u06a9 \u0627\u06cc\u0633\u0627 \u0622\u0631\u0645\u0648\u0646 \u06c1\u06d2 \u062c\u0648 \u0648\u06cc\u0688 \u06a9\u0648 \u0628\u0691\u06be\u0627\u062a\u0627 \u06c1\u06d2"}, {"speaker": "A", "start": 167.83, "end": 168.59, "text": "\u062a\u0648 \u0627\u0633"}, {"speaker": "B", "start": 168.59, "end": 188.53, "text": "\u06a9\u06cc \u0628\u0627\u0688\u06cc \u0645\u06cc\u06ba \u0627\u0646\u0633\u0644\u06cc\u0646 \u0627\u0636\u0627\u0641\u06cc \u06c1\u0648 \u06af\u06cc\u0627 \u06c1\u06d2 \u0645\u06cc\u06ba \u0627\u0633 \u06a9\u0648 \u06af\u0644\u0648\u06a9\u0648 \u0641\u06cc\u062c \u062f\u0648\u06ba \u06af\u0627 \u0688\u0627\u0626\u06cc \u0633\u0648 \u0627\u06cc\u0645 \u062c\u06cc \u06a9\u06cc \u0645\u06cc\u06ba \u0634\u06af\u0631 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0644\u06cc\u062a\u0627 \u06c1\u06d2 \u0627\u06cc\u06a9 \u0686\u0645\u0686 \u06c1\u06d2 \u0622\u062f\u06be\u0627 \u0686\u0645\u0686 \u062f\u0648 \u0686\u0645\u0686 \u06c1\u06d2 \u0627\u06cc\u06a9 \u0686\u0645\u0686 \u0627\u06cc\u06a9 \u0686\u0645\u0686 \u06c1\u06d2"}, {"speaker": "B", "start": 188.53, "end": 192.59, "text": "\u0622\u062f\u06be\u0627 \u0622\u062f\u06be\u0627 \u06c1\u06d2 \u0627\u06cc\u06a9 \u0686\u0648\u062a\u06be\u0627 \u06c1\u06cc \u062c\u0648 \u0628\u06be\u06cc \u0627\u0633 \u06a9\u06cc \u0631\u06cc\u06a9\u0648\u0627\u0626\u0631\u0645\u0646\u0679 \u0627\u0633 \u06a9\u0648 \u0622\u067e \u06a9\u0645 \u06a9\u0631\u06cc\u06ba \u06c1\u0627\u0641 \u067e\u0631 \u0644\u06cc\u06ba"}, {"speaker": "B", "start": 193.7, "end": 200.7, "text": "\u0628\u0627\u0642\u06cc \u062c\u0648 \u06c1\u06d2 \u06a9\u0686\u06be \u0688\u0627\u0626\u06cc\u0679 \u0645\u06cc\u06ba \u0627\u0648\u0631 \u0628\u06be\u06cc \u0686\u06cc\u0632\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0628\u062a\u0627\u0626\u06cc \u062c\u0627\u0626\u06cc\u06ba \u06af\u06cc \u0631\u0645\u0634\u0627 \u0628\u06be\u06cc \u0622\u067e \u06a9\u0648 \u0633\u0645\u062c\u06be\u0627\u0626\u06cc\u06ba \u06af\u06cc \u0688\u0627\u0626\u06cc\u0679 \u06a9\u0627 \u0648\u06c1 \u0628\u06be\u06cc \u0622\u067e \u0633\u0645\u062c\u06be \u06a9\u06d2 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u06a9\u06c1 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u0648\u06af \u0627\u0633 \u06a9\u0648 \u06a9\u06cc\u0633\u06d2 \u06a9\u0645 \u06a9\u0631\u0646\u0627 \u06c1\u06d2"}, {"speaker": "A", "start": 200.7, "end": 201.34, "text": "\u0627\u0686\u06be\u06d2 \u0686\u0627\u0648\u0644"}, {"speaker": "B", "start": 201.34, "end": 202.68, "text": "\u0644\u06d2 \u0644\u06cc\u06ba"}, {"speaker": "B", "start": 203.3, "end": 204.8, "text": "\u0628\u0631\u06cc\u0627\u0646\u06cc \u0641\u0627\u0631\u0645 \u0645\u06cc\u06ba \u0646\u06c1 \u0644\u06cc\u06ba \u0648\u06c1"}, {"speaker": "A", "start": 204.8, "end": 205.4, "text": "\u0645\u0646\u0639 \u06a9\u0631\u062a\u06d2"}, {"speaker": "B", "start": 205.4, "end": 205.46, "text": "\u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 205.46, "end": 206.92, "text": "\u0645\u062c\u06be\u06d2"}, {"speaker": "B", "start": 209.82, "end": 212.3, "text": "\u0628\u0631\u06cc\u0627\u0646\u06cc \u0627\u06af\u0631 \u06a9\u06be\u0627\u062a\u06d2 \u062a\u0648 \u062f\u0648 \u06c1\u0641\u062a\u06d2 \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u0628\u0631\u06cc\u0627\u0646\u06cc"}, {"speaker": "A", "start": 212.3, "end": 213.5, "text": "\u0648\u06c1 \u0646\u0642\u0635\u0627\u0646 \u062f\u06d2 \u06af\u0627 \u0645\u06cc\u06ba \u0628\u0631\u06cc\u0627\u0646\u06cc\u043d\u0438"}, {"speaker": "B", "start": 213.5, "end": 214.22, "text": "\u06a9\u06be\u0627\u0646\u0627 \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u062f\u06cc\u06ba"}, {"speaker": "A", "start": 214.22, "end": 214.86, "text": "\u0645\u06cc\u06ba"}, {"speaker": "B", "start": 214.86, "end": 220.5, "text": "\u0648\u0627\u0626\u0679\u0627\u0645\u0646 \u0688\u06cc\u0648 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0631\u06cc\u067e\u06cc\u0679 \u06a9\u0631\u0627\u0624\u06ba \u06af\u0627 \u0627\u0646 \u06a9\u0627 \u062a\u0642\u0631\u06cc\u0628\u0627 \u0686\u06be \u06c1\u0641\u062a\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u0627\u0646\u0633\u0644\u06cc\u0646 \u0688\u0648\u0628\u0627\u0631\u06c1 \u0631\u06cc\u067e\u06cc\u0679 \u06a9\u0631\u0627\u0624\u06ba \u06af\u0627 \u0686\u06be \u06c1\u0641\u062a\u06d2 \u06a9\u06d2 \u0628\u0639\u062f"}, {"speaker": "B", "start": 221.21, "end": 224.89, "text": "\u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0627\u0646\u0634\u0627\u0621 \u0627\u0644\u0644\u06c1 \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0632\u06cc\u0627\u062f\u06c1 \u062f\u0648\u0627\u0626\u06cc \u06c1\u06cc\u06ba \u0686\u06be\u0648\u0679\u06cc \u0639\u0645\u0631 \u06c1\u06d2 \u062f\u06cc\u0646\u06af\u06cc \u0646\u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 226.13, "end": 229.43, "text": "\u067e\u0631\u06cc\u0634\u0627\u0646 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u06cc \u06c1\u0627\u0641\u06cc\u0632 \u06c1\u06cc\u06ba \u067e\u0631 \u0644\u0648\u0679 \u0646\u06c1\u06cc\u06ba \u062a\u06be\u0631\u0648\u0627"}, {"speaker": "B", "start": 229.43, "end": 233.37, "text": "\u062c\u06cc\u062a\u0646\u0627 \u06c1\u06d2 \u06c1\u0627\u06ba"}, {"speaker": "A", "start": 233.37, "end": 244.95, "text": "\u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u06a9\u0645\u0631 \u0645\u06cc\u06ba \u062f\u0631\u062f \u0627\u0645\u06cc \u06af\u06be\u0679\u0646\u0648\u06ba \u0645\u06cc\u06ba \u062f\u0631\u062f \u0627\u0645\u06cc \u067e\u0631\u06cc\u0634\u0627\u0646\u06cc \u062a\u0648 \u0628\u0686\u06d2 \u0648\u0627\u0644\u06cc \u0639\u0645\u0631 \u06c1\u06d2 \u06a9\u0645\u0631 \u0645\u06cc\u06ba \u062f\u0631\u062f \u0628\u06cc\u0679\u06be\u0627 \u0622\u0646\u0627 \u062c\u0627\u0626\u06d2 \u067e\u06be\u0631 \u0627\u0645\u06cc \u06a9\u06cc\u0641 \u0644\u0627\u0646\u06af \u062f\u06d2 \u062f\u06cc\u06ba \u0627\u0645\u06cc \u06a9\u0627\u0631\u0688 \u0628\u0648\u0644 \u062f\u06d2 \u062f\u06cc\u06ba \u0645\u06cc\u06ba \u0646\u06d2 \u06a9\u06c1\u0627 \u0628\u06be\u0627\u0626\u06cc \u0645\u06cc\u06ba \u0627\u0646\u06c1\u06cc\u06ba \u06a9\u06d2 \u067e\u0627\u0633 \u062c\u0627 \u0631\u06c1\u06cc \u06c1\u0648\u06ba \u062a\u0648 \u06a9\u0633\u06cc \u06a9\u0627 \u067e\u062a\u06c1 \u0646\u06c1\u06cc\u06ba \u062a\u06be\u0627 \u0688\u06cc"}, {"speaker": "B", "start": 244.95, "end": 250.11, "text": "\u0645\u06cc\u0633 \u0679\u06cc\u067e\u0644\u06cc\u0648 \u0646\u0645\u0634\u0627 \u0627\u0628\u06be\u06cc \u0634\u0631\u0648\u0639 \u06a9\u0631\u06cc\u06ba \u06af\u06d2 \u062f\u0633 \u062f\u0646 \u06a9\u06d2 \u0628\u0639\u062f \u0688\u06cc \u0645\u06cc\u0633 \u0679\u06cc\u067e\u0644\u06cc\u0648 \u0688\u06cc\u0644\u06cc \u0644\u06cc\u06ba \u06af\u06d2 \u0627\u0686\u06be\u06d2 \u06c1\u0641\u062a\u06d2"}, {"speaker": "A", "start": 250.11, "end": 262.45, "text": "\u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba \u062f\u0633 \u062f\u0646 \u06a9\u06d2 \u0628\u0639\u062f \u0686\u06be\u06d2 \u06c1\u0641\u062a\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 267.15, "end": 270.15, "text": "\u0628\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0628\u0633 \u062a\u0645\u06c1\u06cc\u06ba \u062a\u06be\u0648\u0691\u0627 \u0633\u0627 \u0627\u0645\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062a\u0639\u0627\u0648\u0646 \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u06c1\u0627\u06ba \u0628\u06cc\u0679\u0627"}, {"speaker": "A", "start": 270.15, "end": 273.69, "text": "\u067e\u06be\u0631 \u0645\u06cc\u06ba \u0646\u0627 \u0633\u0646\u06af\u0644 \u06c1\u0648\u06ba \u062c\u0646 \u06a9\u06d2 \u0648\u0627\u0644\u062f \u06c1\u06cc\u06ba \u0633\u0646\u06af\u0644 \u0628\u06c1\u062a\u0631 \u06c1\u06cc\u06ba \u06c1\u0627\u06ba \u062a\u0648 \u0648\u06c1"}, {"speaker": "B", "start": 274.96, "end": 276.78, "text": "\u0628\u06cc\u0633 \u0633\u0631 \u06a9\u0645\u067e\u0631\u0646\u0633 \u0646\u0627\u067e \u0644\u06cc\u06ba \u06af\u06d2 \u0628\u0686\u06d2 \u06a9\u06cc"}, {"speaker": "A", "start": 276.78, "end": 277.58, "text": "\u0627\u0648\u0631"}, {"speaker": "B", "start": 277.58, "end": 281.9, "text": "\u0628\u0627\u0642\u06cc \u0631\u06cc\u067e\u0648\u0631\u0679\u0646\u06af \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u06a9\u0631\u0648\u0627\u0626\u06cc \u06c1\u0648\u0626\u06cc \u06c1\u06d2 \u0633\u0627\u0631\u06cc \u0627\u0633 \u06a9\u06d2 \u0644\u0627\u0646\u06d2 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u062c\u0648 \u0646\u06cc\u06a9\u0633 \u0679\u06cc\u0633\u0679 \u06c1\u06d2 \u0648\u06c1 \u06a9\u0631\u0648\u0627 \u06a9\u06d2 \u062f\u06cc\u06ba \u06af\u06d2"}, {"speaker": "A", "start": 281.9, "end": 287.62, "text": "\u0627\u0686\u06be\u0627 \u067e\u0631\u06cc\u0631\u06cc\u0633 \u0628\u06be\u06cc \u0645\u06cc\u06ba \u0646\u06d2 \u062f\u06a9\u06be\u0627 \u062f\u06cc\u0627 \u06c1\u0627\u06ba \u0648\u06c1 \u0633\u0628 \u0622\u06af\u0626\u06cc \u0633\u0627\u0631\u06cc \u0686\u06cc\u0632\u06cc\u06ba \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06d2 \u0639\u0644\u0627\u0648\u06c1 \u06a9\u0648\u0626\u06cc \u0679\u06cc\u0633\u0679 \u06a9\u0686\u06be \u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 287.62, "end": 290.98, "text": "\u0627\u0628\u06be\u06cc \u06a9\u0686\u06be \u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0646\u0627 \u0627\u067e\u0646\u06d2 \u0628\u06cc\u06a9\u0627\u0631 \u0632\u06cc\u0627\u062f\u06c1 \u062c\u06be\u0646\u0688\u0688 \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0646\u0627"}, {"speaker": "A", "start": 290.98, "end": 292.62, "text": "\u06a9\u0686\u06be"}, {"speaker": "B", "start": 292.62, "end": 293.38, "text": "\u06c1\u06d2 \u06a9\u06c1\u0627\u06ba \u0633\u06d2 \u06a9\u0631\u0646\u0627 \u0622\u067e \u062c\u0648"}, {"speaker": "A", "start": 293.38, "end": 298.08, "text": "\u0679\u06cc\u0633\u0679 \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u062a\u0648 \u0645\u062c\u06be\u06d2 \u06a9\u0633\u06cc \u0627\u0686\u06be\u06cc \u062c\u06af\u06c1 \u0628\u062a\u0627\u0626\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u0627\u06cc\u06a9 \u06a9\u0645 \u06c1\u0648 \u0633\u06a9\u06d2 \u0627\u06af\u0631 \u0622\u067e \u06cc\u06c1\u0627\u06ba \u06a9\u06d2 \u0639\u0644\u0627\u0648\u06c1 \u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u06cc\u06ba"}, {"speaker": "B", "start": 298.08, "end": 298.96, "text": "\u062c\u06d2 \u0688\u06cc \u0633\u06cc \u0635\u062d\u06cc\u062d \u06c1\u06d2"}, {"speaker": "A", "start": 298.96, "end": 300.26, "text": "\u0635\u062d\u06cc\u062d \u06c1\u06d2 \u062c\u06d2"}, {"speaker": "B", "start": 300.26, "end": 301.64, "text": "\u0688\u06cc \u0633\u06cc \u0633\u06d2 \u06a9\u0631\u0648\u0627 \u0644\u06cc\u0627 \u06a9\u0631\u06cc\u06ba \u0679\u06be\u06cc\u06a9"}, {"speaker": "A", "start": 301.64, "end": 302.46, "text": "\u06c1\u06d2"}, {"speaker": "B", "start": 302.46, "end": 303.4, "text": "\u0627\u0648\u0631 \u062a\u0648 \u06a9\u0686\u06be \u0646\u06c1\u06cc\u06ba \u0628\u06cc\u0679\u0627"}, {"speaker": "A", "start": 303.4, "end": 308.1, "text": "\u0627\u0686\u06be\u0627 \u06c1\u0627\u06ba \u06cc\u06c1 \u06a9\u06be\u0627\u0646\u0627 \u06a9\u06be\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0648\u06c1 \u0628\u06be\u0648\u06a9 \u0644\u06af\u062a\u06cc \u06c1\u06d2 \u062a\u0648 \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u0645\u06cc\u06ba \u0648\u06cc\u0688\u06cc\u0648 \u0645\u06cc\u06ba \u062c\u0646\u0631\u0644 \u06c1\u0648 \u06af\u0626\u06cc \u06c1\u06d2"}, {"speaker": "B", "start": 308.1, "end": 308.88, "text": "\u0648\u06c1"}, {"speaker": "A", "start": 308.88, "end": 309.82, "text": "\u067e\u0627\u0631\u0648\u0631 \u0644\u06af\u062a\u06cc \u06c1\u06d2"}, {"speaker": "B", "start": 309.82, "end": 312.48, "text": "\u0627\u0686\u06be\u0627"}, {"speaker": "A", "start": 312.48, "end": 319.84, "text": "\u06cc\u06c1 \u0631\u0627\u062a \u06a9\u0648 \u06a9\u06be\u0627\u0646\u0627 \u06a9\u06be\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0622\u0679\u06be \u0628\u062c\u06d2 \u0646\u0627 \u0622\u0679\u06be \u0633\u0627\u0691\u06be\u06d2 \u0622\u0679\u06be \u06a9\u06d2 \u062f\u0644 \u0645\u06cc\u06ba \u06c1\u0645 \u06a9\u06be\u0627\u0646\u0627 \u06a9\u06be\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0644\u06cc\u06a9\u0646 \u06cc\u06c1 \u0635\u0628\u062d \u0646\u0627\u0634\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0679\u0648\u0626\u0646\u0679\u06cc \u067e\u0627\u0626\u06cc \u0633\u0627\u06c1\u0648 \u062f\u06cc \u0631\u06c1\u06cc \u06c1\u06d2 \u0648\u06c1 \u06a9\u06c1\u062a\u06cc \u06c1\u06d2 \u0641\u0641\u0679\u06cc \u06c1\u0627\u0641\u062a \u0646\u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 319.84, "end": 320.76, "text": "\u0641\u0641\u0679\u06cc \u06a9\u0648 \u06c1\u0627\u0641 \u06a9\u0631\u0648"}, {"speaker": "A", "start": 320.76, "end": 331.46, "text": "\u0679\u0648\u0626\u0646\u0679\u06cc \u067e\u0627\u0626\u06cc \u067e\u0648\u0644\u06cc \u06a9\u0631\u0648 \u0622\u0679\u06be \u062f\u0644\u06d2 \u0631\u0627\u062a \u06a9\u0648 \u06a9\u06be\u0627\u0646\u0627 \u06a9\u06be\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0622\u0679\u06be \u0633\u0627\u0691\u06be\u06d2 \u06a9\u06be\u0627\u062a\u06d2 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u06a9\u06be\u0627\u0646\u06d2 \u067e\u06be\u0631 \u06cc\u06c1 \u0635\u0628\u062d \u0646\u0627\u0634\u062a\u06d2 \u06a9\u0627 \u06a9\u0646\u0628\u06cc \u062e\u0648\u0627\u06c1\u0634 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u06cc \u06a9\u06be\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u0686\u06be \u06a9\u06be\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u0645\u06cc\u06ba"}, {"speaker": "B", "start": 331.46, "end": 333.12, "text": "\u06a9\u0631\u0648\u0627\u062a\u0627 \u06c1\u0648\u06ba \u0646\u0627 \u0688\u0627\u0626\u06cc\u0679 \u0645\u06cc\u06ba \u0628\u06be\u06cc \u06a9\u0631\u0648\u0627\u062a\u0627 \u06c1\u0648\u06ba \u0627\u0633 \u06a9\u06cc"}, {"speaker": "A", "start": 333.12, "end": 333.82, "text": "\u0627\u0686\u06be\u0627 \u0688\u0627\u0626\u06cc\u0679"}, {"speaker": "B", "start": 333.82, "end": 343.84, "text": "\u0645\u06cc\u06ba \u06a9\u0631\u0648\u0627\u062a\u0627 \u06c1\u0648\u06ba \u0627\u0646\u06cc\u0634\u0627 \u06a9\u0648 \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u062a\u06be\u0648\u0691\u0627 \u0633\u0627 \u0648\u06c1 \u06cc\u06c1 \u0648\u06cc\u0688 \u06af\u0626\u06d2 \u06c1\u06cc\u06ba \u0627\u0633 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0633\u0628 \u0688\u0627\u0626\u06cc\u0679 \u0628\u062a\u0627 \u062f\u06cc\u062a\u0627 \u06c1\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0628\u06cc\u0679\u0627 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0622\u067e \u0628\u0633 \u0628\u06cc\u0679\u06be\u0648 \u0622\u06c1 \u06a9\u0686\u06be \u067e\u0648\u0686\u06be\u0646\u0627 \u062a\u0648 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0622\u067e \u06a9\u0648 \u0627\u0648\u0631 \u0645\u062c\u06be \u0633\u06d2"}, {"speaker": "A", "start": 343.84, "end": 349.06, "text": "\u0646\u06c1\u06cc\u06ba \u0628\u06cc\u0679\u0627 \u0628\u0633 \u06a9\u0645\u0631 \u0645\u06cc\u06ba \u0628\u06c1\u062a"}, {"speaker": "B", "start": 349.06, "end": 350.36, "text": "\u062f\u0631\u062f \u06c1\u06d2"}, {"speaker": "A", "start": 351.1, "end": 353.76, "text": "\u0627\u0628\u06be\u06cc \u0628\u06be\u06cc \u067e\u0691\u06be \u0646\u06c1\u06cc\u06ba \u067e\u0627 \u0631\u06c1\u06d2 \u062a\u06be\u06d2 \u062a\u0648 \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u06a9\u06c1\u0627"}, {"speaker": "B", "start": 353.76, "end": 356.62, "text": "\u0645\u062c\u06be\u06d2 \u0628\u06c1\u062a \u0628\u06cc\u0679\u06cc \u06c1\u0648\u062a\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 358.9, "end": 361.5, "text": "\u0688\u0627\u06a9\u0633 \u06c1\u0627\u0641 \u0627\u06cc\u0645 \u062c\u06cc \u0679\u0648 \u0627\u06cc\u0645 \u062c\u06cc \u06a9\u06cc \u06c1\u0627\u0641 \u06a9\u0631 \u0631\u06c1\u06cc"}, {"speaker": "A", "start": 361.5, "end": 364.04, "text": "\u06c1\u06d2 \u062a\u0648 \u0688\u0627\u06a9\u0633\u0648\u06ba \u06cc\u06c1 \u062f\u0631\u062f \u0627\u0646 \u06a9\u06cc \u06c1\u0688\u06cc\u0648\u06ba \u0645\u06cc\u06ba \u06a9\u0645 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0679\u0648\u0627\u0626\u0679\u0631 \u0628\u06cc\u0679\u06cc"}, {"speaker": "B", "start": 364.04, "end": 364.86, "text": "\u0635\u062d\u06cc\u062d \u06c1\u0648\u06af\u0627 \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2"}, {"speaker": "A", "start": 364.86, "end": 366.28, "text": "\u0627\u0633\u06cc \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u06c1\u06d2 \u0646\u0627 \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2"}, {"speaker": "B", "start": 366.28, "end": 367.48, "text": "\u0648\u06cc\u0688 \u0635\u062d\u06cc\u062d \u06c1\u0648\u06af\u0627 \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2"}, {"speaker": "A", "start": 367.48, "end": 368.9, "text": "\u0627\u0646\u0634\u0627\u0621\u0627\u0644\u0644\u06c1 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0628\u06cc\u0679\u0627 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2"}, {"speaker": "B", "start": 368.9, "end": 370.86, "text": "\u0686\u0644\u0648 \u0633\u0628 \u0628\u06cc\u0679\u06be\u0648 \u06af\u0648\u0634\u062a \u06a9\u0631\u06cc\u06ba \u0648\u0627\u0644\u06a9 \u0648 \u0633\u0644\u0627\u0645"}], "language": "auto", "duration_s": 372.7, "num_segments": 109}