{"utterances": [{"speaker": "A", "start": 12.54, "end": 13.94, "text": "\u0645\u0648\u0633\u06cc\u0642\u06cc"}, {"speaker": "A", "start": 14.88, "end": 15.9, "text": "\u0645\u0648\u0633\u06cc\u0642\u06cc"}, {"speaker": "B", "start": 20.46, "end": 21.16, "text": "\u0645\u0648\u0633\u06cc\u0642\u06cc"}, {"speaker": "B", "start": 22.34, "end": 23.8, "text": "\u0645\u0648\u0633\u06cc\u0642\u06cc"}, {"speaker": "A", "start": 28.3, "end": 30.86, "text": "\u0645\u0648\u0633\u06cc\u0642\u06cc \u0645\u0648\u0633\u06cc\u0642\u06cc"}, {"speaker": "B", "start": 30.86, "end": 31.62, "text": "\u0645\u0648\u0633\u06cc\u0642\u06cc"}, {"speaker": "A", "start": 31.62, "end": 33.84, "text": "\u0645\u0648\u0633\u06cc\u0642\u06cc \u0645\u0648\u0633\u06cc\u0642\u06cc"}, {"speaker": "A", "start": 37.52, "end": 43.86, "text": "\u0645\u0648\u0633\u06cc\u0642\u06cc \u0645\u0648\u0633\u06cc\u0642\u06cc \u0645\u0648\u0633\u06cc\u0642\u06cc \u0645\u0648\u0633\u06cc\u0642\u06cc \u0645\u0648\u0633\u06cc\u0642\u06cc"}, {"speaker": "A", "start": 45.3, "end": 53.09, "text": "\u0645\u0648\u0633\u06cc\u0642\u06cc \u0645\u0648\u0633\u06cc\u0642\u06cc \u067e\u0631 \u0622\u06af\u06cc\u0627 \u0648\u06c1 \u0628\u06be\u06cc \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u06af\u06cc\u0627 \u0627\u0648\u0631 \u0634\u0648\u06af\u0631\u0632 \u0627\u0628 \u0627\u0646 \u06a9\u06cc \u0648\u06cc\u0633\u06cc \u06c1\u0627\u0626\u06d2 \u062c\u0627 \u0631\u06c1\u06cc \u06c1\u06cc\u06ba \u0645\u06cc\u06ba \u0646\u06d2 \u0627\u0646 \u06a9\u0648 \u0627\u0646\u0633\u0644\u06cc\u0646 \u06a9\u0627 \u06a9\u06c1\u0627 \u062a\u06be\u0627"}, {"speaker": "B", "start": 53.09, "end": 56.93, "text": "\u0627\u0648\u0631 \u06cc\u06c1 \u0627\u0646\u0633\u0644\u06cc\u0646 \u06a9\u06cc \u06c1\u06d2 \u06cc\u06c1 \u0631\u06cc\u0688\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0686\u06be\u06d2"}, {"speaker": "A", "start": 56.93, "end": 68.51, "text": "\u0622\u067e \u06a9\u06cc\u0627 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u067e\u06be\u0631 \u062a\u0648 \u06cc\u06c1\u06cc \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u0641\u0648\u0631 \u062a\u06be\u0631\u0679\u06cc \u0633\u06a9\u0633 \u06a9\u06cc \u0634\u0648\u06af\u0631 \u0622 \u0631\u06c1\u06cc \u06c1\u06d2 \u0622\u067e \u06a9\u06cc\u0633\u06d2 \u0622\u067e \u0627\u067e\u0646\u06d2 \u0622\u067e \u06a9\u0648 \u062a\u0648 \u0648\u06c1\u06cc \u0628\u0627\u062a \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0622\u0646\u06a9\u06be \u067e\u0631 \u067e\u0679\u06cc \u0645\u0627\u0646\u0646\u06d2 \u0627\u0648\u0631 \u06a9\u06be\u0627\u0626\u06cc \u06a9\u06cc \u0637\u0631\u0641 \u062c\u0627\u0626\u06cc\u06ba \u062a\u06cc\u0632\u06cc \u0633\u06d2 \u0622\u067e"}, {"speaker": "A", "start": 70.26, "end": 75.82, "text": "\u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0634\u0648\u06af\u0631 \u06a9\u06cc \u067e\u06cc\u0686\u06cc\u0632\u062a\u06cc \u0628\u0691\u06cc \u06af\u0646\u062f\u06cc \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u0634\u0648\u06af\u0631 \u062c\u0628 \u0622\u067e \u067e\u06cc\u0686\u06cc\u0632\u062a\u06cc \u0622\u062a\u06cc \u06c1\u06d2 \u0622\u067e \u06a9\u06d2 \u0627\u0648\u067e\u0631 \u0627\u0628\u06be\u06cc \u0622\u0646\u06a9\u06be\u0648\u06ba \u0645\u06cc\u06ba \u06a9\u06cc\u0627 \u0645\u0633\u0626\u0644\u06c1 \u0622 \u0631\u06c1\u0627 \u06c1\u06d2 \u0622\u067e \u06a9\u06d2 \u062a\u0648"}, {"speaker": "B", "start": 75.82, "end": 77.32, "text": "\u067e\u06be\u0631"}, {"speaker": "A", "start": 77.32, "end": 78.4, "text": "\u06cc\u06c1 \u062e\u0631\u0627\u0628 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0645\u0648\u0679\u06cc\u06c1"}, {"speaker": "A", "start": 78.94, "end": 92.45, "text": "\u06a9\u062a\u0646\u06d2 \u067e\u06cc\u0634\u0646\u0679 \u06c1\u0645 \u0646\u06d2 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06c1\u06cc\u06ba \u06a9\u06c1 \u062c\u0646 \u06a9\u06cc \u0622\u0646\u06a9\u06be\u06cc\u06ba \u0645\u0648\u0679\u06cc\u06c1 \u06a9\u0627 \u0622\u067e\u0631\u06cc\u0634\u0646 \u06a9\u0631\u0648\u0627\u06cc\u0627 \u06c1\u06d2 \u06cc\u0627 \u0646\u06c1 \u0628\u06be\u06cc \u06a9\u0631\u0648\u0627\u06cc\u0627 \u062a\u0648 \u0627\u0646 \u06a9\u06cc \u0622\u0646\u06a9\u06be\u06cc\u06ba \u067e\u06be\u0631 \u0686\u0644\u06cc \u06af\u0626\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u067e\u0627 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0622\u067e \u0641\u0648\u0631 \u062a\u06be\u0631\u0679\u06cc \u0633\u06a9\u0633 \u0622\u067e \u06a9\u0648 \u062a\u0648 \u0633\u0648\u0686\u0648 \u0646\u0627 \u0622\u067e \u0627\u067e\u0646\u0627 \u062f\u0645\u0627\u063a \u0628\u06be\u06cc \u0644\u06af\u0648 \u0627\u0648\u0631 \u0688\u0627\u06a9\u0679\u0631 \u0646\u06c1\u06cc\u06ba \u0628\u06be\u06cc \u0628\u062a\u0627 \u0631\u06c1\u0627 \u062a\u06be\u0627 \u0622\u067e \u0627\u067e\u0646\u06cc \u0630\u06c1\u0646 \u0633\u06d2 \u0633\u0648\u0686\u0648 \u0646\u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 92.45, "end": 94.77, "text": "\u0622 \u0631\u06c1\u06cc"}, {"speaker": "A", "start": 94.77, "end": 97.17, "text": "\u06c1\u0648\u06af\u06cc \u0622\u067e \u06a9\u06cc \u0622\u067e \u06a9\u06cc \u0627\u06cc\u0679 \u067e\u0627\u0626\u0646\u0679 \u067e\u0627\u0626\u06cc\u0648 \u0627\u06cc\u0645 \u0627\u0644\u062a\u064a"}, {"speaker": "B", "start": 97.17, "end": 99.91, "text": "\u0627\u0628\u06be\u06cc \u0628\u0691\u06d2 \u06af\u0626\u06d2 \u06a9\u06cc\u0633\u06d2 \u0628\u0691\u0627"}, {"speaker": "A", "start": 99.91, "end": 102.55, "text": "\u06af\u06cc\u0627 \u067e\u06be\u0631 \u0622\u062c \u06cc\u06c1 \u062a\u0648 \u06a9\u06cc\u0627 \u062e\u0631\u0627\u0628 \u06c1\u06d2 \u0622\u067e \u06a9\u0627"}, {"speaker": "B", "start": 102.55, "end": 105.47, "text": "\u0646\u06c1\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u062f\u0648 \u0633\u06d2 \u0679\u06cc\u06a9 \u062f\u06cc\u0626\u06d2"}, {"speaker": "A", "start": 105.47, "end": 114.29, "text": "\u062f\u06cc\u06a9\u06be\u0648 \u0622\u067e \u067e\u062a\u06c1 \u0645\u06cc\u06ba \u0645\u06cc\u06ba \u062a\u0648 \u0622\u067e \u0622\u067e \u06a9\u0648 \u0627\u067e\u0646\u06d2 \u0633\u0627\u062a\u06be \u062c\u06cc\u0633\u0679\u06cc \u0641\u0627\u0626\u06cc \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u0646\u0627 \u0645\u06cc\u0631\u06d2 \u0633\u0627\u062a\u06be \u062a\u0648 \u0646\u06c1\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0627\u067e\u0646\u06d2 \u0627\u067e\u0646\u06cc \u0627\u0645\u06cc \u06a9\u06cc \u0622\u067e \u06a9\u06cc \u0648\u0627\u0644\u062f\u06c1 \u06c1\u06cc\u06ba \u06a9\u06d2 \u0633\u0627\u062a\u06be \u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 114.29, "end": 115.03, "text": "\u0648\u0627\u0644\u062f\u06c1"}, {"speaker": "A", "start": 115.03, "end": 122.23, "text": "\u062a\u0648 \u0622\u067e \u06a9\u0648 \u0627\u0646 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062c\u06cc\u0633\u0679\u06cc \u0641\u0627\u0626\u06cc \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u0646\u0627 \u06c1\u0627\u06ba \u062c\u06cc \u0627\u0628\u06be\u06cc \u06a9\u06cc\u0627 \u067e\u0631\u0627\u0645\u0627\u0646 \u0622\u0626\u06cc \u06c1\u06d2 \u0622\u067e \u06a9\u0648 \u06a9\u06cc\u0627 \u0645\u0633\u0626\u0644\u06c1 \u0622 \u0631\u06c1\u0627 \u06c1\u06d2 \u0622\u067e \u06a9\u0648"}, {"speaker": "B", "start": 122.23, "end": 123.57, "text": "\u062a\u0628\u06cc\u062a \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u06af\u06be\u0691 \u0628\u0691\u06cc"}, {"speaker": "A", "start": 124.15, "end": 126.39, "text": "\u062a\u0628\u06cc\u062a \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u06af\u0691\u06be \u0628\u0691\u06cc \u06c1\u06d2 \u06a9\u0648\u0626\u06cc \u0628\u06d2 \u0686\u06cc\u0646\u06cc \u06c1\u06d2 \u06a9\u0686\u06be \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 126.39, "end": 130.07, "text": "\u0646\u06c1\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0622\u067e \u0646\u06d2 \u06a9\u06c1\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u0688\u06cc\u0631\u06c1 \u0645\u06c1\u06cc\u0646\u06d2 \u0628\u0639\u062f \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0631\u06cc\u06ba \u0646\u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 130.07, "end": 138.81, "text": "\u06cc\u06c1 \u0635\u0631\u0641 \u0622\u067e \u06a9\u0648 \u0633\u0645\u062c\u06be\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u062f\u06cc\u06a9\u06be\u0648 \u0627\u0646 \u06a9\u06d2 \u0679\u0631\u0627\u0626\u06cc \u06af\u0644\u06cc\u0633\u0631\u0627\u0626\u0679 \u0628\u06be\u06cc \u0628\u0691\u06d2 \u0631\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0633\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u062e\u0627\u0644\u0642 \u0627\u06cc\u0641\u06cc\u0646\u0648 \u06af\u06cc\u0679 \u0644\u06d2 \u062f\u06cc\u06ba \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u06cc\u06c1 \u0627\u0628\u06be\u06cc \u0628\u06be\u06cc \u06c1\u0627\u0626\u06d2 \u06c1\u06cc\u06ba \u0688\u06cc\u0631\u06c1 \u0633\u0648 \u0633\u06d2 \u0646\u06cc\u0686\u06d2 \u0646\u06c1\u06cc\u06ba \u0622\u0626\u06d2 \u062c\u0648 \u0622\u0646\u06d2 \u0686\u0627\u06c1\u06cc\u06d2 \u062c\u0648 \u0641\u06af\u0631 \u0622\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2"}, {"speaker": "A", "start": 139.48, "end": 140.88, "text": "\u0648\u06c1 \u0627\u0633\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u06a9\u06c1 \u0634\u06af\u0631 \u06c1\u0627\u0626\u06d2"}, {"speaker": "A", "start": 142.17, "end": 145.65, "text": "\u0648\u06c1\u0627\u06ba \u062f\u06cc\u06a9\u06be \u0644\u0648 \u0627\u06af\u0631 \u0627\u06cc\u06a9 \u06c1\u0641\u062a\u06c1 \u0627\u0648\u0631 \u0686\u06cc\u06a9 \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u06a9\u0631 \u0644\u0648 \u0631\u0648\u0632\u06c1 \u0631\u06a9\u06be\u06cc\u062a\u06cc \u0631\u0645\u0636\u0627\u0646 \u0645\u06cc\u06ba \u0622\u067e"}, {"speaker": "B", "start": 146.91, "end": 148.49, "text": "\u0631\u0648\u0632\u06c1 \u0631\u06a9\u06be\u062a\u06cc \u06c1\u06cc\u06ba \u0631\u0648\u0632\u06c1 \u0631\u06a9\u06be\u062a\u06cc"}, {"speaker": "A", "start": 148.49, "end": 148.65, "text": "\u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 149.35, "end": 150.91, "text": "\u062a\u0648 \u0631\u0645\u0636\u0627\u0646 \u06a9\u0627 \u067e\u06cc\u0627\u0646\u06d2 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u06c1\u0648\u062a\u0627 \u06c1\u06d2"}, {"speaker": "A", "start": 151.85, "end": 160.79, "text": "\u067e\u06cc\u067e\u0631 \u062a\u06be\u0627 \u06c1\u06d2 \u0646\u0627 \u067e\u06cc\u0688 \u0648\u0627\u0644\u0627 \u0646\u06a9\u0627\u0644 \u062f\u06cc\u062c\u0626\u06d2 \u06af\u0627 \u062a\u0648 \u0627\u0646 \u06a9\u06cc \u0631\u0645\u0636\u0627\u0646 \u0645\u06cc\u06ba \u0631\u0645\u0636\u0627\u0646 \u062f\u06cc\u0646\u0631\u0644 \u062c\u0648 \u06c1\u06d2 \u0646\u0627 3 \u0627\u06cc\u0645 \u062c\u06cc \u0622\u062f\u06be\u06cc \u0633\u06cc\u0644\u06cc \u0645\u06cc\u06ba \u06c1\u0648\u06af\u06cc 3 \u0627\u06cc\u0645 \u062c\u06cc \u06a9\u06cc \u0627\u0648\u0631 \u0688\u06cc\u0648\u0644 \u067e\u0633 \u0633\u06cc\u0644\u06cc \u0645\u06cc\u06ba \u06c1\u0648\u06af\u0627"}, {"speaker": "A", "start": 161.69, "end": 164.75, "text": "\u0627\u0648\u0631 \u0627\u0641\u0637\u0627\u0631 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u06cc\u06c1 \u0648\u06c1 \u0644\u06cc\u0646\u06d2 \u06a9\u06cc \u0688\u06cc\u0648\u0644 \u067e\u0633"}, {"speaker": "B", "start": 164.75, "end": 167.03, "text": "\u06c1\u0627\u0641 \u0679\u06cc\u067e\u0644\u0679 \u0633\u06cc\u0644\u06cc \u0645\u06cc\u06ba \u06c1\u0648\u06af\u06cc \u0688\u06cc\u0648\u0644"}, {"speaker": "A", "start": 167.03, "end": 169.49, "text": "\u0688\u06cc\u0648\u0644 \u062c\u0648 \u06c1\u06d2 \u0648\u06c1 \u0641\u0644 \u0679\u06cc\u067e\u0644\u0679 \u06c1\u0648\u06af\u06cc \u0633\u06cc\u0644\u06cc \u0645\u06cc\u06ba"}, {"speaker": "B", "start": 169.99, "end": 170.47, "text": "\u0627\u0648\u0631"}, {"speaker": "A", "start": 170.47, "end": 174.07, "text": "\u0627\u0633\u06cc \u0637\u0631\u062d \u067e\u06be\u0631 \u0633\u06cc\u0644\u06cc \u06a9\u06d2 \u0627\u0641\u0637\u0627\u0631 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u06cc\u06c1 \u0648\u06c1 \u0644\u06cc\u0646\u06d2 \u06a9\u06cc \u0688\u06cc\u0648\u0644 \u067e\u0633"}, {"speaker": "A", "start": 174.89, "end": 184.53, "text": "\u0627\u0648\u0631 \u0632\u06cc\u0646\u0631\u0644 \u062c\u0648 \u06c1\u06d2 \u0648\u06c1 \u0644\u06cc\u0646\u06d2 \u06a9\u06cc \u0641\u0644 \u0679\u06cc\u067e\u0644\u0679 \u06c1\u0627\u0641 \u0679\u06cc\u067e\u0644\u0679 1 \u0679\u06cc\u067e\u0644\u0679 \u0641\u0644 \u0679\u06cc\u067e\u0644\u0679 \u0644\u06cc\u06ba \u06af\u06d2 \u0622\u067e \u06a9\u0627 \u0627\u0641\u0637\u0627\u0631 \u0627\u0648\u0631 \u0688\u06cc\u0646\u0631 \u0645\u06cc\u06ba \u0641\u0631\u0642 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u0627\u06cc\u06a9 \u062c\u06cc\u0633\u0627 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u0627\u0641\u0637\u0627\u0631 \u0688\u06cc\u0646\u0631 \u0646\u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 184.53, "end": 185.27, "text": "\u0641\u0631\u0642 \u06c1\u0648\u062a\u0627 \u06c1\u06d2"}, {"speaker": "A", "start": 185.27, "end": 188.37, "text": "\u06cc\u06c1 \u0648\u0642\u062a \u0637\u0648\u0631 \u067e\u0631 \u0628\u0691\u0627 \u06c1\u06d2\u061f \u062f\u06cc\u0646\u0631 \u06c1\u06d2 \u06cc\u0627 \u0627\u0641\u062a\u0627\u0631 \u06c1\u06d2\u061f \u0627\u0641\u062a\u0627\u0631"}, {"speaker": "B", "start": 188.37, "end": 190.15, "text": "\u067e\u0691\u06be\u0627 \u06c1\u06d2 \u0633\u0628\u0632\u06c1"}, {"speaker": "A", "start": 190.15, "end": 197.55, "text": "\u0627\u0641\u062a\u0627\u0631 \u067e\u0691\u06be\u0627 \u06c1\u06d2 \u062a\u0648 \u06c1\u0645 \u0632\u06cc\u0646\u0631\u0644 \u06a9\u0648 \u0627\u0641\u062a\u0627\u0631 \u0645\u06cc\u06ba \u062f\u06d2 \u062f\u06cc\u06ba \u0627\u0648\u0631 \u0627\u0645\u0634\u06c1 \u0632\u06cc\u0646\u0631\u0644 \u06a9\u0648 \u0627\u0641\u062a\u0627\u0631 \u0645\u06cc\u06ba \u062f\u06cc\u06ba \u0627\u0648\u0631 \u0688\u06cc\u0648\u0644 \u06a9\u0648 \u0688\u06cc\u0646\u0631 \u0645\u06cc\u06ba \u062f\u06cc\u06ba"}, {"speaker": "A", "start": 198.21, "end": 199.93, "text": "\u0648\u06c1 \u062a\u0627\u0631\u06cc\u062e \u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be \u0644\u06cc\u06ba"}, {"speaker": "A", "start": 201.09, "end": 220.89, "text": "\u0628\u0627\u0642\u06cc \u062f\u0648\u0627\u0626\u06cc\u0648\u06ba \u0631\u0645\u0636\u0627\u0646 \u0645\u06cc\u06ba \u0635\u0628\u062d \u06a9\u06cc \u062f\u0648\u0627\u0626\u06cc \u06c1\u06d2 \u0635\u0628\u062d \u06af\u06be\u0646\u0679\u0627\u060c \u0635\u0628\u062d \u06af\u06be\u0646\u0679\u06cc\u060c \u0635\u0628\u062d \u06af\u06be\u0646\u0679\u0627\u060c \u0635\u0628\u062d \u06af\u06be\u0646\u0679\u0627\u060c \u0635\u0628\u062d \u06af\u06be\u0646\u0679\u06cc \u062a\u0645\u0627\u0645 \u0627\u0633 \u06a9\u06d2 \u067e\u0627\u0633 \u062f\u0648\u0627\u0626\u06cc \u062a\u0631\u062a\u06cc\u0628 \u06c1\u06d2 \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u062a\u0648 \u0648\u06c1 \u0645\u06cc\u06ba \u0628\u06be\u06cc \u0622\u067e \u06a9\u0648 \u0628\u0646\u0627 \u062f\u0648\u06ba \u06af\u0627 \u06a9\u0631\u062a\u06cc \u0631\u0645\u0636\u0627\u0646\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u067e \u0686\u0627\u06c1\u0648 \u067e\u06c1 \u0627\u06cc\u06a9 \u06c1\u0641\u062a\u06c1 \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be \u0644\u06cc\u06ba \u0627\u0646 \u06a9\u06cc \u0634\u0648\u06af\u0631\u0632 \u06a9\u0648 \u0627\u0648\u0631 \u067e\u06be\u0631 \u0622\u067e \u0644\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba \u0631\u06cc\u0634 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06cc \u0622\u0631\u0646\u06af\u06cc \u0645\u06cc\u06ba \u0622\u067e \u0622 \u06a9\u0631 \u0628\u062a\u0627 \u062c\u0627\u0646\u0627 \u0627\u06af\u0631 \u0631\u06cc\u0688\u06cc \u0646\u06c1\u06cc\u06ba \u0622\u0631\u06c1\u06cc \u0633\u06d2 \u0627\u06af\u0631 \u0627\u0633\u06cc \u0637\u0631\u062d \u062a\u06cc\u0646 \u0633\u0648 \u0633\u0627\u0631\u06d2 \u062a\u06cc\u0646 \u0633\u0648 \u0686\u0627\u0631 \u0633\u0648 \u0631\u06c1 \u0631\u06c1\u06cc \u06c1\u06d2 \u062a\u0648 \u067e\u06be\u0631 \u0622\u067e \u06a9\u06d2 \u0644\u06cc\u06d2"}, {"speaker": "A", "start": 220.89, "end": 226.27, "text": "\u0628\u062a\u0627 \u062c\u0627\u0646\u0627 \u062c\u0633\u0679\u06cc\u0641\u0627\u0626\u06cc \u0627\u0646 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u0627\u0646\u0635\u0627\u0641 \u0627\u0646 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u0622\u06a9\u06d2 \u0627\u0646 \u06a9\u06cc \u062c\u0646\u06c1\u06cc\u06ba \u0686\u0644\u06cc \u062c\u0627\u0626\u06cc\u06ba \u06af\u06cc \u067e\u06be\u0631 \u0622\u067e \u0627\u0641\u0633\u0648\u0633 \u06a9\u0631\u0648 \u06a9\u06c1"}, {"speaker": "A", "start": 227.37, "end": 237.55, "text": "\u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u062a\u0646\u06cc \u0628\u0627\u0631 \u0627\u06cc\u0633\u0627 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0644\u0648\u06af \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u06c1\u0627\u06ba \u0627\u0628 \u06c1\u0645 \u0627\u0646\u0633\u0627\u0646\u06cc \u0634\u0631\u0648\u0639 \u06a9\u0631 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0622\u067e \u06a9\u0648 \u0622\u06a9\u06d2 \u0686\u0644\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u067e\u06be\u0631 \u0641\u0627\u0626\u062f\u06c1 \u06a9\u06cc\u0627 \u06c1\u06d2 \u0622\u067e \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba \u0633\u0628 \u06a9\u0686\u06be \u0686\u0644 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba \u0622\u067e \u0633\u06d2 \u0627\u0646\u0633\u0627\u0646\u06cc \u06a9\u06d2 \u062e\u0648\u0641 \u0633\u06d2"}, {"speaker": "B", "start": 237.55, "end": 238.11, "text": "\u06cc\u06c1"}, {"speaker": "A", "start": 238.11, "end": 242.27, "text": "\u0631\u0633 \u0644\u06d2 \u0631\u06c1\u06cc \u06c1\u06cc\u06ba \u0627\u067e\u0646\u0627 \u0627\u0679\u06be\u0627 \u0631\u06c1\u06cc \u06c1\u06cc\u06ba \u06a9\u06cc\u0627"}, {"speaker": "A", "start": 242.78, "end": 244.62, "text": "\u06a9\u0631\u06cc\u06ba \u067e\u06be\u0631 \u0627\u0628\u06be\u06cc \u0627\u0628\u06be\u06cc \u06af\u0648\u0644\u06cc \u067e\u06c1 \u0631\u06c1\u0646 \u062f\u06cc\u06ba"}, {"speaker": "B", "start": 244.62, "end": 246.56, "text": "\u0627\u0648\u0631 \u0627\u06af\u0631"}, {"speaker": "A", "start": 246.56, "end": 247.8, "text": "\u0646\u06c1\u06cc\u06ba \u06c1\u0648\u0627 \u062a\u0648 \u067e\u06be\u0631 \u06a9\u06cc\u0627 \u06a9\u0631\u06cc\u06ba \u06af\u06cc \u0622\u067e"}, {"speaker": "B", "start": 247.8, "end": 250.14, "text": "\u06a9\u0631 \u0644\u06cc\u06ba \u06af\u06cc \u067e\u06be\u0631"}, {"speaker": "A", "start": 250.14, "end": 258.8, "text": "\u0627\u0628\u06be\u06cc \u0622\u067e \u0648\u06c1 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u06cc\u06ba \u06af\u06cc \u062c\u0648 \u0645\u06cc\u06ba \u0628\u0648\u0644\u062a\u0627 \u06c1\u0648\u06ba \u0627\u0628\u06be\u06cc \u062a\u0648 \u0622\u067e \u0648\u06c1 \u06a9\u0631\u06cc\u06ba \u06af\u06d2 \u062c\u0648 \u0622\u067e \u06a9\u0648 \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u0627\u0686\u06be\u0627 \u0645\u062c\u06be\u06d2 \u0627\u0648\u0631 \u0648\u0627\u067e\u0633 \u0633\u06d2 \u0628\u062a\u0627 \u062f\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0634\u06a9\u0627\u06cc\u062a \u06a9\u0648\u0626\u06cc \u0637\u0628\u06cc\u0639\u062a \u0645\u06cc\u06ba \u06af\u0631\u0628\u0691\u06cc \u06a9\u0648\u0626\u06cc \u062a\u06cc\u0686\u06cc\u0646\u06cc \u06a9\u0686\u06be \u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0646\u0627"}, {"speaker": "B", "start": 258.8, "end": 261.88, "text": "\u0628\u06c1\u062a \u06a9\u0645 \u06c1\u06d2 \u0634\u06a9\u0631"}, {"speaker": "A", "start": 261.88, "end": 264.0, "text": "\u06a9\u0631 \u062f\u06cc\u062a\u0627 \u06c1\u06d2 \u0646\u0627 \u0645\u0637\u0644\u0639\u06c1 \u0622\u062a\u06cc \u06c1\u06d2 \u06a9\u06cc\u0627 \u06c1\u0648\u062a\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 264.0, "end": 267.52, "text": "\u0645\u0637\u0644\u0639\u06c1 \u0622\u062a\u06cc \u06c1\u06d2 \u0628\u0633 \u0679\u06be\u06cc\u06a9 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u06cc\u06c1 \u062c\u0627\u062a\u0627 \u06c1\u06d2"}, {"speaker": "A", "start": 267.52, "end": 269.12, "text": "\u06c1\u0631 \u0648\u0642\u062a \u0646\u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 269.12, "end": 272.26, "text": "\u06c1\u0631 \u0648\u0642\u062a \u0646\u06c1\u06cc\u06ba \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062c\u0644\u0646\u06d2 \u06a9\u0627 \u0628\u06be\u0648\u0644\u062a\u06cc"}, {"speaker": "A", "start": 272.26, "end": 272.6, "text": "\u06c1\u06d2 \u0622\u067e \u06a9\u0648"}, {"speaker": "B", "start": 272.6, "end": 274.16, "text": "\u062c\u0628 \u06a9\u06be\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u0645\u06cc\u06ba"}, {"speaker": "A", "start": 274.16, "end": 283.7, "text": "\u0622\u067e \u06a9\u0648 \u0627\u06cc\u06a9 \u06af\u0648\u0644\u06cc \u0644\u06a9\u06be \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba \u0648\u06c1 \u062f\u06d2 \u062f\u06cc\u0627 \u06a9\u0631\u06cc\u06ba \u062c\u0628 \u06a9\u06be\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u062c\u0644\u0646 \u06c1\u0648 \u06c1\u0648\u0646\u0631\u06cc\u0679 \u06a9\u0631 \u062f\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u0648\u06c1 \u0644\u06d2 \u0644\u06cc\u0627 \u06a9\u0631\u06cc\u06ba \u062c\u0628 \u062c\u0628 \u06c1\u0648 \u062a\u0648 \u0644\u06d2 \u0644\u06cc\u0627 \u0628\u0633 \u0628\u0627\u0642\u06cc \u0648\u06c1 \u06c1\u0632 \u0628\u06be\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2 \u0628\u0627\u0642\u06cc \u062f\u0648\u0627\u0626\u06cc\u06ba \u0633\u0627\u0631\u06cc \u0635\u062d\u06cc\u062d \u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 284.26, "end": 295.74, "text": "\u06a9\u0627\u0644\u06cc\u0633\u0679\u0631\u0648\u0644 \u0634\u06af\u0631 \u0633\u0627\u0631\u06cc \u062f\u0648\u0627\u0626\u06cc\u06ba \u0648\u06cc\u0633\u06cc \u0686\u0644\u062a\u06cc \u0631\u06c1\u06cc\u06ba \u06af\u06cc \u0628\u0644\u0688 \u067e\u06cc\u0634\u0631 \u06a9\u06cc \u062f\u0628\u0627\u0626\u06cc \u0628\u06be\u06cc \u0648\u06cc\u0633\u06cc \u0686\u0644\u062a\u06cc \u0631\u06c1\u06d2 \u06af\u06cc \u0628\u0644\u0688 \u067e\u06cc\u0634\u0631 \u0627\u0645\u06cc \u06a9\u0627 \u062a\u06be\u0648\u0691\u0627 \u0633\u0627 \u0644\u0648\u06c1\u0631 \u0633\u0627\u0626\u0679 \u06a9\u0627 \u06c1\u06d2 \u062a\u0648 \u06cc\u06c1 \u0628\u06be\u06cc \u0630\u0631\u0627 \u0622\u067e \u062f\u06cc\u06a9\u06be \u0644\u06cc\u0627 \u06a9\u0631\u0648 \u0628\u0644\u0688 \u067e\u06cc\u0634\u0631 \u0627\u06af\u0631 \u0644\u0648\u06c1\u0631 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2 \u062a\u0648 \u06c1\u0645 \u0644\u0648\u06a9\u06cc\u0645 \u0688\u0627\u0626\u06cc\u0648 \u06a9\u0648 \u06a9\u0645 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06cc\u06c1"}, {"speaker": "B", "start": 295.74, "end": 296.42, "text": "\u0622\u067e \u06a9\u0627 \u06a9\u0627\u0645"}, {"speaker": "A", "start": 296.42, "end": 297.86, "text": "\u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u062f\u06cc\u06a9\u06be\u0648 \u0645\u06cc\u06ba \u0645\u0631\u062f"}, {"speaker": "B", "start": 297.86, "end": 299.96, "text": "\u06c1\u0648\u06ba \u0645\u06cc\u06ba \u0645\u0631\u062f \u06c1\u0648\u06ba \u0627\u0646 \u06a9\u0648 \u0628\u062a\u0627\u0626\u06cc\u06ba \u06af\u06be\u0631 \u0645\u06cc\u06ba"}, {"speaker": "A", "start": 299.96, "end": 312.04, "text": "\u0628\u062a\u0627\u0626\u06cc\u06ba \u06a9\u06c1 \u0645\u0648\u0644\u0627 \u0688\u0627\u06a9\u0679\u0631 \u0635\u0627\u062d\u0628 \u0646\u06d2 \u06a9\u06c1\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0627\u0646 \u06a9\u0627 \u0628\u0644\u0688 \u067e\u06cc\u0634\u0631 \u0628\u06be\u06cc \u0627\u06af\u0631 \u06c1\u0648 \u0633\u06a9\u062a\u06d2 \u062a\u0648 \u0635\u0628\u062d \u0634\u0627\u0645 \u06a9\u0648 \u06c1\u0648\u0646\u0631\u06cc\u0679\u0631 \u06a9\u0631 \u0644\u06cc\u06ba \u0645\u0634\u06cc\u0646 \u06c1\u06d2 \u062c\u06cc \u062c\u06cc \u062a\u0648 \u0627\u0646 \u06a9\u0648 \u0628\u0648\u0644\u0646\u0627 \u06c1\u06d2 \u0627\u06cc\u06a9 \u0686\u0627\u0631\u0688 \u0628\u0646\u0627 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0646\u0627\u0646\u0634\u0627\u06c1 \u0628\u06be\u06cc \u0622\u067e \u06a9\u0648 \u0633\u0645\u062c\u06be\u0627 \u062f\u06cc\u06ba \u06af\u06d2 \u0627\u06cc\u06a9 \u0686\u0627\u0631\u0688 \u0628\u0646\u0627 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0627\u0633 \u0645\u06cc\u06ba \u0635\u0628\u062d \u0634\u0627\u0645 \u06a9\u0648 \u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u06a9\u0627\u0645 \u062c\u0628 \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u0648\u0646\u0627 \u067e\u0648\u0631\u0627 \u067e\u0648\u0631\u0627 \u06a9\u0627\u0645 \u06a9\u0631\u0648 \u0622\u062f\u06be\u0627 \u0622\u062f\u06be\u0627 \u06a9\u0627\u0645 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0648"}, {"speaker": "A", "start": 312.58, "end": 327.64, "text": "\u0635\u062d\u06cc\u062d \u06c1\u06d2 \u062a\u0648 \u0627\u0646\u0634\u0627\u0621 \u0627\u0644\u0644\u06c1 \u0628\u0627\u0642\u06cc \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0628\u06cc\u0646 \u0631\u0645\u0636\u0627\u0646 \u06a9\u0627 \u0628\u06be\u06cc \u0628\u0646\u0627 \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba \u0627\u0648\u0631 \u0627\u0628\u06be\u06cc \u062f\u0648\u0627\u0626\u06cc\u0627\u06ba \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0644\u06a9\u06be \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba \u0627\u0648\u0631 \u0627\u0628 \u0628\u0627\u0642\u06cc \u0633\u0628 \u0633\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0633\u0627\u0631\u06cc \u0686\u06cc\u0632\u06cc\u06ba \u0627\u06cc\u06a9 \u062c\u0627\u0644\u0646 \u06a9\u06cc \u062f\u0648\u0627\u0626\u06cc \u0628\u06be\u06cc \u0644\u06a9\u06be \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba \u062a\u0648 \u062c\u0648 \u0622\u067e \u0631\u0648\u0632 \u0628\u06be\u06cc \u0631\u06c1\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u0631\u0648\u0632 \u0628\u06be\u06cc \u0631\u06c1 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06cc\u0627 \u062c\u0628 \u062c\u0627\u0644\u0646 \u06c1\u0648\u062a\u0627 \u0628\u06be\u06cc \u0644\u06d2 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0679\u06be\u06cc\u06a9 \u06c1\u06d2"}, {"speaker": "B", "start": 327.64, "end": 330.16, "text": "\u0627\u06af\u0631 \u0635\u0628\u062d \u0634\u0627\u0645 \u0622\u06cc\u0627 \u062a\u0648 \u067e\u06be\u0631 \u0686\u0644\u0646\u06d2 \u062f\u06cc\u06ba"}, {"speaker": "A", "start": 330.16, "end": 343.9, "text": "\u06af\u06d2 \u062f\u0648\u0627\u0626\u06cc\u0627\u06ba \u06c1\u0627\u06ba \u067e\u06be\u0631 \u062a\u06cc\u0645 \u0645\u06c1\u06cc\u0646\u06d2 \u0628\u0639\u062f \u0622\u0626\u06cc\u06d2 \u06af\u0627 \u062a\u06cc\u0645 \u0645\u06c1\u06cc\u0646\u06d2 \u0628\u0639\u062f \u062c\u0628 \u0622\u0626\u06cc\u06ba \u06af\u06d2 \u062f\u0648\u0628\u0627\u0631\u06c1 \u062a\u0648 \u06a9\u0648\u0644\u06cc\u0633\u0679\u0631\u0648\u0644 \u06a9\u0631\u0648\u0627 \u06a9\u0631\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u0627\u06cc\u062c\u0648\u06cc\u0646\u0633\u06cc \u06a9\u0631\u0648\u0627 \u06a9\u0631\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u0627\u0648\u0631 \u06cc\u0648\u0646\u06cc\u0646 \u0688\u06cc \u0622\u0631 \u0679\u06cc\u0645 \u0645\u06cc\u06ba \u0627\u0648\u0631 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u0627 \u062a\u0648 \u0622\u067e \u0645\u062c\u06be\u06d2 \u06c1\u0641\u062a\u06d2 \u0628\u0639\u062f \u0628\u062a\u0627\u0624 \u06af\u06d2 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0627\u0646 \u06a9\u06cc \u0622\u0646\u06a9\u06be\u0648\u06ba \u06a9\u0627 \u0645\u0639\u0627\u0645\u0644\u06c1 \u06c1\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0646\u0627\u0645\u0634\u0627\u06c1 \u0628\u06be\u06cc \u0622\u067e \u06a9\u0648 \u0633\u0627\u0631\u06cc \u0633\u06d2 \u0628\u062a\u0627\u0626\u06cc\u06ba"}], "language": "auto", "duration_s": 346.4, "num_segments": 92}