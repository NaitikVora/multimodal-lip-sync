{"utterances": [{"speaker": "A", "start": 3.26, "end": 8.8, "text": "\u06cc\u06c1 \u0645\u06cc\u0631\u06d2 \u0628\u0691\u06d2 \u0628\u06cc\u0679\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u06cc\u06c1 \u062a\u06cc\u0631\u06c1 \u0633\u0627\u0644 \u06a9\u06d2 \u06c1\u06cc\u06ba\u060c"}, {"speaker": "B", "start": 8.8, "end": 11.92, "text": "\u062a\u06cc\u0631\u06c1 \u0633\u0627\u0644 \u06a9\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0645\u06cc\u0631 \u0645\u062c\u06be\u06d2 \u0646\u0627\u0645 \u06c1\u06d2\u060c \u062c\u06cc"}, {"speaker": "A", "start": 11.92, "end": 13.46, "text": "\u062f\u0648 \u06c1\u0631\u0627\u0631 \u0628\u0627\u0631\u06c1 \u0645\u06cc\u06ba \u067e\u06cc\u062f\u0627 \u06c1\u0648\u0626\u06d2 \u06c1\u06cc\u06ba\u060c"}, {"speaker": "B", "start": 13.46, "end": 14.38, "text": "\u0645\u06cc\u06ba"}, {"speaker": "A", "start": 14.38, "end": 22.64, "text": "\u0646\u06d2 \u0627\u0646 \u06a9\u06d2 \u0628\u0633 \u06a9\u0686\u06be \u0627\u067e\u0646\u06d2 \u0634\u06a9 \u0648 \u062c\u0648\u0627\u0628 \u06a9\u06d2 \u0633\u0644\u0633\u0644\u06d2 \u0645\u06cc\u06ba \u0628\u0686\u0648\u06ba \u06a9\u06d2 \u0627\u067e\u0646\u06d2 \u0686\u06cc\u0632 \u06a9\u0631\u0627\u0646\u06d2 \u06c1\u06cc\u06ba\u060c \u0645\u0633\u0644\u0645 \u06a9\u0627 \u0628\u06be\u06cc \u0627\u0648\u0631 \u0627\u0645\u06cc\u0631 \u06a9\u0627 \u0628\u06be\u06cc\u060c"}, {"speaker": "B", "start": 22.64, "end": 24.16, "text": "\u06cc\u06c1 \u0627\u0645\u06cc\u0631 \u06c1\u06d2 \u0646\u0627\u060c"}, {"speaker": "A", "start": 24.16, "end": 26.88, "text": "\u06cc\u06c1 \u0627\u0645\u06cc\u0631 \u06c1\u06d2\u060c \u06cc\u06c1 \u0686\u06be\u0648\u0679\u0627 \u0648\u0627\u0644\u0627 \u0645\u0633\u0644\u0645 \u06c1\u06d2\u060c \u06cc\u06c1 \u0622\u06cc\u0627 \u06c1\u06d2\u060c"}, {"speaker": "B", "start": 26.88, "end": 28.78, "text": "\u0633\u0631\u06d2 \u0645\u06cc\u06ba \u0627\u0633 \u06a9\u0648 \u062f\u06cc\u06a9\u06be \u0644\u0648\u06ba \u06af\u0627\u060c \u067e\u06be\u0631 \u0627\u0633 \u06a9\u06cc \u0628\u06be\u06cc \u062f\u06cc\u06a9\u06be \u0644\u06cc\u06ba\u060c"}, {"speaker": "B", "start": 29.5, "end": 38.5, "text": "\u0627\u0686\u06be\u0627 \u0627\u0633 \u06a9\u0627 \u0627\u0646\u0633\u0679\u0631\u0646\u06cc \u0644\u06cc\u0648\u0644 \u0633\u06cc\u0648\u0646\u0679\u06cc\u0646 \u067e\u0648\u0627\u0626\u0646\u0679 \u0627\u06cc\u0679 \u0632\u06cc\u0631\u0648 \u067e\u06c1 \u0622 \u0631\u06c1\u0627 \u06c1\u06d2\u060c \u0628\u0691\u0627 \u06c1\u0648\u0627 \u06c1\u06d2\u060c \u062a\u06be\u0648\u0691\u0627 \u062a\u06be\u0627 \u0627\u0648\u0631 \u0627\u06cc\u0686 \u0628\u06cc \u0648\u06cc\u0646\u0633\u06cc \u0627\u0633 \u06a9\u0627 \u0641\u0627\u0626\u06cc\u0648 \u067e\u0648\u0627\u0626\u0646\u0679 \u0641\u0627\u0626\u06cc\u0648 \u067e\u06c1 \u0622 \u0631\u06c1\u0627 \u06c1\u06d2\u060c"}, {"speaker": "B", "start": 39.53, "end": 41.85, "text": "\u06a9\u06cc\u0627 \u0627\u06cc\u0634\u0648 \u06c1\u06d2\u060c \u067e\u0631\u06cc\u0634\u0627\u0646 \u06a9\u06cc\u0648\u06ba \u06a9\u0631\u0648\u0627\u06cc\u0627 \u0622\u067e \u06a9\u06d2\u061f"}, {"speaker": "A", "start": 41.85, "end": 58.15, "text": "\u0645\u06cc\u06ba \u0646\u06d2 \u0627\u0633 \u0644\u06cc\u06d2 \u06a9\u0631\u0646\u0627\u06cc\u0627 \u06a9\u06c1 \u0627\u0633 \u06a9\u0648 \u0628\u0691\u06cc \u06c1\u06cc\u0679 \u06c1\u0648\u0626\u06cc \u06c1\u06d2\u060c \u062a\u0648 \u062a\u06be\u0648\u0691\u06d2 \u0627\u0633 \u06a9\u0627 \u06c1\u06cc\u0631 \u0628\u06c1\u062a \u06af\u06be\u0646\u06d2 \u062a\u06be\u06d2\u060c \u06c1\u06cc\u0631 \u0644\u0648\u0633 \u0628\u06be\u06cc \u06a9\u0627\u0641\u06cc \u06c1\u0648\u0627 \u06c1\u06d2 \u0627\u0633 \u06a9\u0627 \u0646\u0627\u060c \u0627\u0633 \u06a9\u0648 \u0688\u06cc\u0646\u06af\u06cc \u0627\u0648\u0631 \u0686\u06a9\u0646 \u06af\u0648\u0646\u06cc\u0627 \u0627\u06cc\u06a9 \u0633\u0627\u062a\u06be \u06c1\u0648 \u06af\u06cc\u0627 \u062a\u06be\u0627\u060c \u06a9\u0686\u06be \u0633\u0627\u0644 \u067e\u06c1\u0627\u0691\u06cc \u067e\u06cc\u0686\u06be\u06d2\u060c \u06a9\u0686\u06be \u0633\u0627\u0644\u060c \u06a9\u0686\u06be \u062a\u06be\u0648\u0691\u0627 \u0633\u0627 \u0627\u0633 \u06a9\u0627 \u0648\u06cc\u0688 \u0628\u06be\u06cc \u0628\u0691\u06be \u0631\u06c1\u0627 \u06c1\u06d2 \u0646\u0627\u060c \u0648\u06cc\u0688"}, {"speaker": "B", "start": 58.15, "end": 58.97, "text": "\u06af\u06cc\u0646 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u0633 \u06a9\u0627\u060c"}, {"speaker": "A", "start": 58.97, "end": 75.49, "text": "\u0648\u06cc\u0688 \u06af\u06cc\u0646\u060c \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0627\u0633 \u06a9\u06cc \u0632\u06cc\u0627\u062f\u06c1 \u0627\u06cc\u06a9\u0679\u06cc\u0648\u0679\u06cc \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u06d2 \u0646\u06c1\u06cc\u06ba\u060c \u0686\u06be\u0648\u0679\u0627 \u0622\u0644 \u06c1\u06d2 \u0648\u06c1 \u062a\u0648 \u0628\u0627\u06c1\u0631 \u06a9\u06be\u06cc\u0644\u062a\u0627 \u06c1\u06d2 \u062e\u0648\u0628 \u0645\u06cc\u06ba \u0648\u06c1\u060c \u0627\u0633 \u06a9\u06cc \u0632\u06cc\u0627\u062f\u06c1 \u0633\u06cc \u0627\u0648\u0631 \u06a9\u0686\u06be \u06cc\u06c1 \u06a9\u06c1\u062a\u0627 \u06c1\u06d2 \u0646\u0627\u060c \u0633\u0648 \u0633\u0627\u0644 \u0645\u06cc\u06ba \u0641\u0627\u0646\u0648\u06cc\u0633\u0648\u0627\u0626\u0631 \u0628\u06be\u06cc \u06c1\u0648 \u06af\u06cc\u0627 \u062a\u06be\u0627\u060c \u0627\u0633 \u06a9\u06d2 \u0628\u0627\u0644 \u0628\u06be\u06cc \u0628\u06c1\u062a \u06af\u06be\u0631\u0646\u06d2 \u0644\u06af\u06d2 \u0648\u06c1\u060c \u062a\u0648 \u0645\u062c\u06be\u06d2 \u06a9\u0686\u06be \u0634\u06a9\u0648\u0634 \u0648 \u0628\u0627\u062a \u0633\u06d2 \u067e\u06cc\u062f\u0627 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2\u060c \u06a9\u06cc\u0627 \u0634\u06a9\u0648\u0634 \u0648 \u0628\u0627\u062a\u060c"}, {"speaker": "B", "start": 75.49, "end": 76.15, "text": "\u0634\u06a9\u0631 \u06a9\u06d2\u060c"}, {"speaker": "A", "start": 76.15, "end": 80.75, "text": "\u06c1\u0627\u06ba\u060c \u0648\u06c1\u06cc \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0688\u0627\u06a9\u0679\u0631 \u0645\u06cc\u06ba \u062c\u0628 \u067e\u06cc\u0679 \u0645\u06cc\u06ba \u062a\u06be\u06d2 \u0646\u0627 \u06cc\u06c1 \u062f\u0648\u0646\u0648\u06ba \u0645\u06cc\u0631\u06d2\u060c"}, {"speaker": "B", "start": 80.75, "end": 81.39, "text": "\u062a\u0648"}, {"speaker": "A", "start": 81.39, "end": 86.69, "text": "\u0627\u0633 \u06a9\u06cc \u0631\u0627\u0628\u0637\u06c1 \u0645\u062c\u06be\u06d2 \u06c1\u0644\u06a9\u0627 \u0633 \u0633\u0648 \u0627\u0646\u062f\u0627\u0632\u06c1 \u06c1\u0648\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u0688\u0627\u06a9\u0679\u0631 \u0646\u06d2 \u06a9\u06c1\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u0622\u067e \u067e\u0631\u06cc\u0632 \u06a9\u0631\u06cc\u06ba\u060c \u0645\u062c\u06be\u06d2 \u06a9\u0648\u0646\u0679\u06cc\u06a9\u0679"}, {"speaker": "B", "start": 86.69, "end": 89.11, "text": "\u0646\u0645\u0628\u0631 \u0628\u062a\u0627\u0626\u06d2 \u06af\u0627\u060c \u0622\u067e \u06a9\u06d2 \u0628\u062a\u0627 \u062f\u06cc\u06ba\u060c"}, {"speaker": "A", "start": 89.11, "end": 89.77, "text": "\u0632\u06cc\u0631\u0648\u060c"}, {"speaker": "B", "start": 89.77, "end": 92.23, "text": "\u062a\u06be\u0631\u06cc\u060c \u0641\u0648\u0631\u060c"}, {"speaker": "A", "start": 92.23, "end": 99.87, "text": "\u0679\u0648\u060c \u0679\u0648\u060c \u0646\u0627\u0626\u0646\u060c \u0679\u0648\u060c \u0648\u0646\u060c \u0641\u0627\u0626\u0631\u060c \u0646\u0627\u0626\u0646\u060c \u0679\u0648\u060c"}, {"speaker": "A", "start": 101.28, "end": 104.6, "text": "\u062a\u0648 \u06a9\u0686\u06be \u062a\u06be\u0648\u0691\u06d2 \u0633\u06d2 \u0645\u062c\u06be\u06d2 \u0634\u06a9\u0648\u0634 \u0648 \u0628\u0627\u062a \u0633\u06d2 \u067e\u06cc\u062f\u0627 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2\u060c \u0627\u0633 \u06a9\u0627 \u0627\u0646\u0633\u0644\u06cc\u0646"}, {"speaker": "B", "start": 104.6, "end": 109.52, "text": "\u0627\u0628\u06be\u06cc \u0628\u0691\u0627 \u06c1\u0648\u0627 \u0622 \u0631\u06c1\u0627 \u06c1\u06d2\u060c \u0628\u0627\u0642\u06cc \u062a\u0648 \u0628\u0686\u06c1 \u0635\u062d\u06cc\u062d \u06c1\u06d2 \u0622\u067e \u06a9\u0648\u060c \u06a9\u0648\u0626\u06cc \u0645\u0633\u0626\u0644\u06c1 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u0627\u0648\u0631 \u06cc\u06c1 \u06c1\u0627\u0631\u0645\u0648\u0646\u0644 \u0686\u06cc\u0646\u062c\u0632 \u06a9\u0648 \u0622\u062a\u06cc \u06c1\u06cc\u06ba \u0627\u0633 \u0627\u06cc\u062c \u06a9\u06d2 \u0644\u06cc\u06d2 \u0646\u0627\u060c \u06cc\u06c1"}, {"speaker": "A", "start": 109.52, "end": 111.62, "text": "\u067e\u0631\u0648\u067e\u0679\u06cc \u06a9\u06cc \u0627\u06cc\u062c \u0645\u06cc\u06ba \u06c1\u06d2\u060c \u06c1\u0627\u06ba\u060c \u0628\u0627\u0644\u06a9\u0644"}, {"speaker": "B", "start": 111.62, "end": 117.86, "text": "\u0628\u0627\u0644\u06a9\u0644 \u0627\u0633 \u0648\u062c\u06c1 \u0633\u06d2 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u062f\u0648\u0633\u0631\u0627 \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u0627\u0646\u0633\u0644\u06cc\u0646 \u062a\u06be\u0648\u0691\u0627 \u0633\u0627 \u0628\u0691\u0627 \u06c1\u0648\u0627 \u06c1\u06d2\u060c \u0627\u0646\u0633\u0644\u06cc\u0646 \u0627\u0633 \u0644\u06cc\u06d2 \u0628\u0691\u0627 \u06c1\u0648\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0622\u062c \u06a9\u0627 \u0646\u0627\u0645 \u062d\u0627\u0644 \u06c1\u06d2 \u062c\u0646\u06af \u0641\u0648\u0688 \u062c\u0627\u0646\u0627 \u06c1\u0631 \u0627\u06cc\u06a9 \u06a9\u06d2 \u0627\u06cc\u06a9\u0633\u0633 \u0645\u06cc\u06ba \u0622 \u06af\u06cc\u0627 \u0646\u0627\u060c"}, {"speaker": "A", "start": 117.86, "end": 118.38, "text": "\u06c1\u0627\u06ba\u060c \u06a9\u06c1"}, {"speaker": "B", "start": 118.38, "end": 123.54, "text": "\u06c1\u0631 \u0627\u06cc\u06a9 \u0628\u0686\u06c1 \u0628\u0631\u06af\u0631 \u06a9\u06be\u0627 \u0644\u06cc\u062a\u0627 \u06c1\u06d2\u060c \u06c1\u0631 \u0628\u0686\u06c1 \u067e\u06cc\u0632\u0627 \u06a9\u06be\u0627 \u0644\u06cc\u062a\u0627 \u06c1\u06d2\u060c \u0641\u0631\u0646\u0686 \u0641\u0627\u0626\u0632 \u06a9\u06be\u0627 \u0644\u06cc\u06d2\u060c \u06a9\u06cc\u0686\u067e \u0644\u06d2 \u0644\u06cc\u06d2\u060c \u0628\u0648\u0644\u0688\u0631\u0646\u06af \u0644\u06d2 \u0644\u06cc\u06d2\u060c"}, {"speaker": "A", "start": 123.54, "end": 124.7, "text": "\u06c1\u0627\u06ba\u060c \u0645\u06cc\u06ba \u0627\u0633 \u06a9\u0648\u060c"}, {"speaker": "B", "start": 124.7, "end": 125.52, "text": "\u06c1\u0627\u06ba\u060c \u06c1\u0627\u06ba\u060c"}, {"speaker": "A", "start": 125.52, "end": 133.18, "text": "\u0686\u06be\u0648\u06a9 \u0686\u06be\u0648\u06a9 \u06c1\u0648 \u062c\u0627\u0624\u060c \u06a9\u0648\u0626\u06cc \u0628\u0627\u062a \u0646\u06c1\u06cc\u06ba\u060c \u0633\u0631 \u0645\u06cc\u06ba \u0627\u0633 \u06a9\u0648 \u06cc\u06c1\u06cc \u0633\u0645\u062c\u06be\u0627 \u062f\u0648\u06ba \u06a9\u06c1 \u0646\u0627 \u062a\u0645 \u0627\u0628\u06be\u06cc \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u06a9\u0646\u0679\u0631\u0648\u0644 \u06a9\u0631\u0648\u060c \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u06cc\u06c1 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u06c1\u06cc \u0628\u0691\u06be\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u067e\u06be\u0631\u060c \u0627\u0646\u0633\u0644\u06cc\u0646"}, {"speaker": "B", "start": 133.18, "end": 137.28, "text": "\u0628\u0691\u06be\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u067e\u06be\u0631 \u0622\u067e \u06a9\u0648 \u0634\u06af\u0631 \u06a9\u06cc \u0637\u0631\u0641 \u0644\u06d2 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0628 \u0627\u0633 \u0645\u06cc\u06ba \u06a9\u0686\u06be \u06a9\u0631\u0646\u0627 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u0627\u0633 \u06a9\u0648 \u062f\u0648\u0627\u0626\u06cc \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c"}, {"speaker": "A", "start": 137.28, "end": 140.64, "text": "\u062f\u0648\u0627\u0626\u06cc \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06d2 \u067e\u0627\u0633 \u0627\u067e\u0646\u06cc \u062a\u0633\u0644\u06cc\u0642 \u0646\u06c1\u06cc\u06ba \u0622\u0626\u06cc \u06c1\u0648\u06ba \u06a9\u06c1 \u0622\u067e \u0645\u062c\u06be\u06d2 \u0628\u062a\u0627\u0626\u06cc\u06d2\u060c"}, {"speaker": "B", "start": 140.64, "end": 149.6, "text": "\u0627\u0633 \u06a9\u0648 \u0635\u0631\u0641 \u0622\u067e \u0646\u06d2 \u062a\u06be\u0648\u0691\u0627 \u0633\u0627 \u06cc\u06c1 \u0627\u0633 \u06a9\u0648 \u0645\u0648\u0679\u06cc\u0648\u06cc\u0679 \u06a9\u0631\u0648\u0627\u0646\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0628\u06be\u0627\u0626\u06cc \u062a\u0645 \u0627\u067e\u0646\u06cc \u0688\u0627\u0626\u06cc\u0679 \u06a9\u0648 \u0686\u06cc\u0646\u062c \u06a9\u0631\u0648\u060c \u0627\u0628 \u06cc\u06c1 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u06cc\u06c1 \u0627\u06cc\u0633\u06cc \u0627\u06cc\u062c \u0645\u06cc\u06ba \u06c1\u06d2 \u06a9\u06c1 \u0628\u0686\u06d2 \u062c\u0648 \u0646\u0627 \u0627\u067e\u0646\u0627 \u0633\u0646\u062a\u06d2 \u0646\u06c1\u06cc\u06ba \u06c1\u06cc\u06ba \u0631\u0628 \u043d\u0430\u0448\u0435\u0433\u043e\u067e\u0627 \u06a9\u06cc\u0645\u0627\u0626\u06cc"}, {"speaker": "A", "start": 149.6, "end": 153.66, "text": "\u0622\u062a\u0627 \u06c1\u06d2 \u06a9\u06cc\u0648\u06ba \u0645\u0648\u0644\u0679\u06cc\u0688 \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u06c1\u0645 \u0627\u0633 \u067e\u0631 \u0628\u0627\u0632 n\u00e3o \u0639\u0645\u0644"}, {"speaker": "B", "start": 153.66, "end": 169.04, "text": "\u067e\u06cc\u0627\u0644\u062a\u06cc\u06ba \u0688\u0627\u0626\u06cc\u06ba\u061f \u06c1\u0645\u0627\u0631\u06cc \u0639\u0645\u0644 \u0633\u06d2 \u0642\uc6d0\uc774 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u06c1\u0627\u06ba \u0627\u0633 \u06a9\u06cc\u0645\u06cc\u0627\u06ba \u0628Phoul \u06a9\u06cc \u0622\u062a\u06cc \u06c1\u06d2\u061f \u0628\u0627\u0644\u06a9\u0644 \u0627\u0642\u062a\u0635\u0627\u062f\u061f \u06cc\u06c1 \u0648\u0627\u0642\u0639\u06cc \u0646\u06c1\u06cc\u06ba\u060c \u0627\u0628 \u06c1\u0645\u0627\u0631\u06cc \u0639\u0645\u0644 \u067e\u06cc\u0627\u0644\u062a\u06cc\u06ba \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u06c1\u0645\u0627\u0631\u06cc \u0641\u0639\u0644 \u0627\u0686\u06be\u06d2 \u06c1\u0648\u06a9\u0627 \u06c1\u06d2\u060c turtle \u0645\u0644\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u062a\u0648 \u0633\u0628 \u06a9\u0648\u0646\u06cc \u06a9\u0648 \u0645\u0679\u06a9 \u0631\u06c1\u06cc \u06c1\u06d2\u061f \u062a\u0648 refund \u0645\u0644\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06a9\u06c1\u0627\u06ba \u0627\u067e\u0646\u06cc \u0645 \u0648\u0627\u0644\u06a9ft \u0645\u0648\u062c\u0648\u062f \u06c1\u06d2 c\u1ea7n\u0648\u0641 \u0637\u0631\u062d\u061f \u0627\u06af\u0631 cue \u0631\u0648\u06cc \u062a\u06cc\u0632 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0648\u0627\u0642\u0639 Nem"}, {"speaker": "A", "start": 169.04, "end": 173.96, "text": "hal \u0633\u062e\u0645 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u0627\u0646 \u06a9\u0627 \u0633\u0631\u0634\u0627\u0646\u06cc \u0627\u0648\u0631"}, {"speaker": "B", "start": 173.96, "end": 175.38, "text": "\u0627\u062f\u06be\u0631"}, {"speaker": "A", "start": 175.38, "end": 178.46, "text": "\u0645\u06cc"}, {"speaker": "A", "start": 180.86, "end": 200.82, "text": "\u0688\u0627\u06a9\u0633\u0627 \u0645\u062c\u06be\u06d2 \u0627\u0633\u06cc \u0644\u0626\u06d2 \u0648\u062c\u06c1 \u0633\u06d2 \u0634\u06a9 \u0631\u06c1\u0627 \u062a\u06be\u0627 \u06af\u0631\u062f\u0646 \u06a9\u0627\u0644\u06cc \u06c1\u0648 \u0631\u06c1\u06cc \u062a\u06be\u06cc \u0686\u06be\u0648\u0679\u06d2 \u0648\u0627\u0644\u06d2 \u06a9\u06cc \u0648\u06c1 \u06a9\u0627\u0644\u0627 \u06c1\u06cc \u06c1\u06d2 \u0627\u0633 \u06a9\u0627 \u067e\u06a9\u0627 \u0631\u0646\u06af \u06c1\u06d2 \u0627\u0686\u06be\u0627 \u0627\u0633 \u06a9\u06d2 \u0627\u062f\u06be\u0631 \u0622\u0631\u0645 \u06af\u0648\u0632 \u0628\u06be\u06cc \u06a9\u0627\u0644\u06d2 \u06c1\u0648 \u0631\u06c1\u06d2 \u062a\u06be\u06d2 \u0627\u0633 \u0645\u06cc\u06ba \u0645\u062c\u06be\u06d2 \u0627\u06cc\u06a9 \u0645\u0633\u062a\u06c1 \u0646\u0638\u0631 \u0622\u06cc\u0627 \u062a\u0648 \u0648\u06c1 \u0628\u06be\u06cc \u06a9\u06c1\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0648\u06c1 \u06a9\u0627\u0644\u0627 \u06c1\u06d2 \u0648\u06c1 \u0627\u067e\u0646\u06d2 \u062f\u06af\u06cc\u0627\u0644 \u0645\u06cc\u06ba \u06af\u06cc\u0627 \u0627\u0633 \u06a9\u0627 \u0631\u0646\u06af \u067e\u06a9\u0627 \u06a9\u0627\u0644\u0627 \u06c1\u06d2 \u06cc\u06c1 \u062c\u0648 \u06c1\u06d2 \u0627\u0633 \u06a9\u0627 \u06a9\u0627\u0641\u06cc \u0641\u06cc\u0631 \u0628\u0686\u0627 \u06c1\u06d2 \u06cc\u06c1 \u06a9\u0686\u06be \u0627\u06cc\u0633\u0627 \u06c1\u0648\u0627"}, {"speaker": "A", "start": 200.82, "end": 204.9, "text": "\u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u0628\u06be\u06cc \u0644\u06cc\u06a9\u0646 \u0627\u0633 \u06a9\u06d2 \u062c\u0648 \u0628\u0627\u0644 \u06af\u0631 \u0631\u06c1\u0627 \u06c1\u06d2 \u0688\u0627\u06a9\u0633\u0627 \u067e\u0631\u0648\u067e\u0679\u06cc \u067e\u06cc \u0627\u06cc\u0686 \u0645\u06cc\u06ba \u06c1\u06d2 \u0646\u0627 \u0627\u0633 \u06a9\u0648"}, {"speaker": "B", "start": 204.9, "end": 210.02, "text": "\u06a9\u0648\u0626\u06cc \u0648\u0627\u0626\u0679\u06cc\u0645\u0646 \u0688\u06cc \u0648\u063a\u06cc\u0631\u06c1 \u0628\u06be\u06cc \u0633\u0679\u0627\u0631\u0679 \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u06d2 \u0646\u0627 \u0688\u06cc \u0645\u06cc\u06a9\u0633 \u0679\u06cc\u0628\u0644\u06cc\u0679 \u062a\u0648 \u0627\u0648\u0631 \u06a9\u0648\u0626\u06cc \u06af\u06cc \u06a9\u0645\u067e\u0644\u06cc\u06a9\u0633 \u0634\u0631\u0648\u0639 \u06a9\u0631 \u062f\u06cc\u0646\u0627 \u0627\u0633 \u06a9\u0648 \u0622\u067e"}, {"speaker": "A", "start": 210.02, "end": 210.88, "text": "\u06a9\u06cc\u0627 \u0639\u06cc\u062c \u06c1\u06d2"}, {"speaker": "B", "start": 210.88, "end": 219.88, "text": "\u0628\u06cc\u0679\u0627 \u0622\u067e \u06a9\u06cc \u062a\u06cc\u0631\u06c1 \u0633\u0627\u0644 \u0645\u06cc\u06ba \u0646\u0627 \u0627\u06cc\u06a9 \u0644\u0627\u0626\u06cc\u0633\u0648\u0648\u06cc\u0679 \u0633\u06cc\u0631\u067e \u0644\u06a9\u06be \u06a9\u0631 \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba \u062f\u0648 \u0688\u06cc \u0633\u067e\u0648\u0646\u0688 \u062f\u0648 \u0633\u06cc\u0648\u0646\u0688 \u067e\u0627\u0626\u06cc\u0648 \u0627\u06cc\u06a9 \u0688\u06cc\u0691\u06be \u0686\u0645\u0686 \u062f\u06cc\u0646\u0627 \u0627\u0633 \u06a9\u0627 \u0633\u0642\u0631\u06cc\u0628\u0627\u064b \u0627\u0633 \u06a9\u0648 \u062f\u0648 \u0645\u06c1\u06cc\u0646\u06d2 \u067e\u0644\u0627\u06cc\u0627 \u0648\u06c1\u0627\u06ba"}, {"speaker": "A", "start": 219.88, "end": 231.06, "text": "\u0641\u0646\u06af\u0633 \u06c1\u0648 \u0631\u06c1\u0627 \u062a\u06be\u0627 \u0688\u0627\u06a9\u0633\u0627 \u0627\u0633 \u06a9\u06d2 \u0633\u0631 \u0645\u06cc\u06ba \u0633\u0631 \u0645\u06cc\u06ba \u06c1\u0648 \u0631\u06c1\u0627 \u062a\u06be\u0627 \u067e\u06be\u0631 \u0648\u06c1 \u0645\u06cc\u06ba \u0646\u06d2 \u06a9\u0648\u0626\u06cc \u0627\u0633 \u06a9\u06d2 \u06a9\u06cc\u067e\u0633\u0648\u0644 \u0644\u0627\u0626\u06d2 \u0641\u0646\u06af\u0633 \u06a9\u06d2 \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u0688\u0627\u06a9\u0633\u0627 \u0627\u0633 \u06a9\u0627 \u0635\u062d\u06cc\u062d \u06c1\u0648 \u06af\u06cc\u0627 \u0628\u0627\u0644 \u0628\u06be\u06cc \u06a9\u0631 \u0631\u06c1\u06d2 \u062a\u06be\u06d2 \u062a\u0648 \u0645\u062c\u06be\u06d2 \u0630\u0631\u0627 \u0627\u0633 \u0637\u0631\u0641 \u06a9\u0627 \u0627\u0634\u0627\u0631\u06c1 \u0645\u0644\u0627 \u062f\u06cc\u06a9\u06be\u0648"}, {"speaker": "B", "start": 231.06, "end": 238.8, "text": "\u0628\u06cc\u0679\u0627 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0645\u0646\u0639 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0631\u06c1\u0627 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u06cc\u06c1 \u0646\u06c1\u06cc\u06ba \u06a9\u06c1\u06c1 \u0631\u06c1\u0627 \u06a9\u06c1 \u0622\u067e \u06cc\u06c1 \u0646\u06c1 \u06a9\u06be\u0648 \u0648\u06c1 \u0646\u06c1 \u06a9\u06be\u0648 \u062e\u062a\u0645 \u06a9\u0631 \u062f\u0648 \u06cc\u06c1 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0631\u06c1\u0627 \u0645\u06af\u0631 \u0622\u067e \u06a9\u0679 \u0688\u0627\u0624\u0646 \u06a9\u0631 \u062f\u0648 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0622\u067e \u06a9\u06cc \u0645\u062f\u062f \u06a9\u0648 \u0634\u06af\u0631 \u0631\u06c1\u06cc \u06c1\u06d2 \u0646\u0627"}, {"speaker": "A", "start": 238.8, "end": 239.2, "text": "\u06c1\u0627\u06ba"}, {"speaker": "B", "start": 239.2, "end": 246.02, "text": "\u062a\u0648 \u0622\u067e \u062a\u0648 \u0646\u06c1\u06cc\u06ba \u0686\u0627\u06c1\u0648 \u06af\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u0648 \u0628\u06be\u06cc \u0634\u06af\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u0646\u0627 \u062f\u0645\u0627\u0626\u06cc\u0627\u06ba \u0644\u0648 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u0648 \u06a9\u062a\u0646\u06d2 \u0686\u06be\u0646\u062c\u0691 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba \u0634\u06af\u0631 \u06a9\u06d2 \u0622\u067e \u06a9\u06d2 \u0627\u0646\u062f\u0631"}, {"speaker": "B", "start": 246.78, "end": 263.92, "text": "\u0679\u06cc\u0646\u0688\u0646\u0633\u06cc \u06c1\u06d2 \u0627\u0646 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u06c1\u0645\u0645 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0627\u0646 \u06a9\u0648 \u0634\u06af\u0631 \u06c1\u06d2 \u062a\u0648 \u0622\u067e \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0628\u06be\u06cc \u0634\u06af\u0631 \u06a9\u06d2 \u062c\u0627\u0646\u0633\u0632 \u0628\u0691\u06be \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u0648 \u0627\u06cc\u06a9 \u062c\u0648 \u062c\u0646\u06af \u0641\u0648\u0688 \u06c1\u06d2 \u0627\u0633 \u06a9\u0648 \u062c\u062a\u0646\u0627 \u06a9\u0679 \u0688\u0627\u0624\u0646 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u0648 \u06a9\u0628\u06be\u06cc \u067e\u0627\u0631\u0679\u06cc \u06c1\u0648\u0626\u06cc \u062f\u0648\u0633\u062a\u0648\u06ba \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0686\u0644\u06d2 \u06af\u0626\u06d2 \u0645\u06cc\u06ba \u0645\u0646\u0639 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0631\u06c1\u0627 \u0645\u06af\u0631 \u0622\u067e \u0646\u06d2 \u0627\u0633 \u06a9\u0648 \u0628\u0646\u0627 \u0644\u06cc\u0627 \u062a\u0648 \u06cc\u06c1 \u067e\u06be\u0631 \u0622\u067e \u06a9\u0648 \u06a9\u06be\u06cc\u0686 \u06a9\u06d2 \u0634\u06af\u0631 \u06a9\u06cc \u0637\u0631\u0641 \u0644\u06d2 \u06a9\u0631 \u062c\u0627\u0626\u06d2 \u0627\u0648\u0631"}, {"speaker": "A", "start": 263.92, "end": 265.36, "text": "\u0648\u06cc\u0679 \u06a9\u0645 \u06a9\u0645 \u06a9\u06cc\u0648\u06ba \u0627\u0648\u0631"}, {"speaker": "B", "start": 265.36, "end": 280.88, "text": "\u0648\u06cc\u0679 \u06a9\u0645 \u0645\u0637\u0644\u0628 \u0648\u06cc\u0679 \u0627\u0633 \u0637\u0631\u062d \u0633\u06d2 \u06a9\u0631\u0648 \u06a9\u06c1 \u0648\u06cc\u0679 \u06a9\u0645 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0648 \u0648\u06cc\u0679 \u0622\u067e \u06a9\u0627 \u062c\u06cc\u0633\u0627 \u06c1\u06d2 \u0635\u062d\u06cc\u062d \u06c1\u06d2 \u0645\u06af\u0631 \u0641\u06cc\u0632\u06cc\u06a9\u0644 \u0627\u06cc\u06a9\u0679\u06cc\u0648\u06cc\u0679\u06cc \u06a9\u0648 \u06c1\u06cc \u06a9\u0631\u0648 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0622\u062c \u06a9\u0644 \u06c1\u0645\u0627\u0631\u06d2 \u06c1\u0645\u0627\u0631\u06d2 \u0648\u0642\u062a\u0648\u06ba \u0645\u06cc\u06ba \u062a\u0648 \u06c1\u0645 \u0644\u0648\u06af \u062c\u0627\u062a\u06d2 \u062a\u06be\u06d2 \u0633\u0627\u0626\u06cc\u06a9\u0644\u0646\u06af \u0628\u06be\u06cc \u0686\u0644\u0627\u062a\u06d2 \u062a\u06be\u06d2 \u06af\u0631\u06cc\u06a9\u0679 \u0628\u06be\u06cc \u06a9\u06be\u06cc\u0644\u062a\u06d2 \u062a\u06be\u06d2 \u0627\u0628 \u0622\u062c \u06a9\u0644 \u0648\u06c1 \u0679\u0631\u06cc\u0646\u0688 \u0646\u06c1\u06cc\u06ba \u0631\u06c1\u0627 \u0646\u0627 \u062a\u0648 \u0645\u06cc\u06ba \u0622\u067e \u0633\u06d2 \u06a9\u06c1\u06c1 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u062a\u06be\u0648\u0691\u06cc \u0641\u06cc\u0632\u06cc\u06a9\u0644 \u0627\u06cc\u06a9\u0679\u06cc\u0648\u06cc\u0679\u06cc \u06a9\u0648\u0626\u06cc \u0628\u06be\u06cc \u0627\u067e\u0646\u06d2 \u0627\u067e\u0646\u06d2 \u0627\u067e\u0646\u06d2 \u0627\u067e\u0646\u06d2"}, {"speaker": "A", "start": 280.88, "end": 285.64, "text": "\u0645\u0648\u0628\u0627\u0626\u0644 \u0644\u06d2 \u06a9\u06d2 \u0628\u06cc\u0679\u06be\u0648 \u0645\u062c\u06be \u0633\u06d2 \u0628\u06c1\u062a\u0631"}, {"speaker": "B", "start": 285.64, "end": 292.5, "text": "\u06c1\u0648 \u06af\u0626\u06d2 \u062a\u0648 \u06cc\u06c1 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0622\u067e \u06a9\u06cc \u0628\u0691\u06be\u062a\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc \u0635\u062d\u06cc\u062d \u06c1\u06d2 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u067e\u0631\u06cc\u0634\u0627\u0646 \u0646\u06c1\u06cc\u06ba \u067e\u0631\u06cc\u0634\u0627\u0646 \u06c1\u0627\u06ba \u06c1\u0627\u06ba \u0627\u0648\u0631"}, {"speaker": "A", "start": 292.5, "end": 297.46, "text": "\u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u06cc\u06c1 \u062c\u0648 \u067e\u0631\u0648\u067e\u06cc\u0679\u06cc \u06a9\u06cc \u0627\u06cc\u062c \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u0627\u0633 \u0645\u06cc\u06ba \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0627\u0648\u067e\u0631 \u062c\u0627\u062a\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 297.46, "end": 299.7, "text": "\u0636\u0631\u0648\u0631\u06cc \u0646\u06c1\u06cc\u06ba \u0636\u0631\u0648\u0631\u06cc"}, {"speaker": "A", "start": 299.7, "end": 305.02, "text": "\u0646\u06c1\u06cc\u06ba \u0627\u0686\u06be\u0627 \u0688\u0627\u06a9\u0633 \u0635\u0627\u062d\u0628 \u0627\u0633 \u06a9\u0627 \u06a9\u062a\u0646\u0627 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2 \u0627\u0646\u0633\u0644\u06cc\u0646 \u0644\u06cc\u0648\u0644 \u0633\u062a\u0631\u06c1 \u06c1\u06d2 \u062f\u0633 \u0633\u06d2 \u06a9\u0645 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2 \u062c\u06cc\u0633\u06d2 \u0627\u0633 \u06a9\u0627 \u0633\u0627\u062a\u06be \u067e\u06c1"}, {"speaker": "B", "start": 305.02, "end": 306.06, "text": "\u0622 \u0631\u06c1\u0627 \u06c1\u06d2 \u0628\u0686\u06d2"}, {"speaker": "A", "start": 306.06, "end": 312.3, "text": "\u06a9\u0627 \u0633\u0627\u062a\u06be \u067e\u06c1 \u0622 \u0631\u06c1\u0627 \u0627\u0686\u06be\u0627 \u06a9\u0686\u06be \u0644\u0648\u06af \u06a9\u06c1\u06c1 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0628\u06cc\u0633 \u0633\u06d2 \u06a9\u0645 \u0635\u062d\u06cc\u062d \u0645\u0627\u0646\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u0628\u0686\u06cc\u0633 \u0633\u06d2 \u06a9\u0645 \u06c1\u0645"}, {"speaker": "B", "start": 312.3, "end": 314.98, "text": "\u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0627\u0646\u0633\u0644\u06cc\u0646 \u067e\u0646\u062f\u0631\u06c1 \u0633\u06d2 \u0627\u0648\u067e\u0631 \u0686\u0648\u062f\u06c1 \u0633\u06d2 \u0627\u0648\u067e\u0631 \u062e\u0631\u0627\u0628 \u06c1\u06d2"}, {"speaker": "A", "start": 315.46, "end": 316.74, "text": "\u067e\u0646\u062f\u0631\u06c1 \u0633\u06d2 \u0627\u06af\u0631"}, {"speaker": "B", "start": 316.74, "end": 318.48, "text": "\u0622\u067e \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u062a\u0648 \u0628\u06cc\u0633 \u0628\u0627\u0626\u06cc\u0633 \u06a9\u06cc \u0628\u0644\u06cc\u0648\u06cc \u06c1\u06d2 \u0646\u0627"}, {"speaker": "A", "start": 318.48, "end": 318.9, "text": "\u06c1\u0627\u06ba \u0645\u06af\u0631"}, {"speaker": "B", "start": 318.9, "end": 319.94, "text": "\u0641\u0641\u0644\u06cc\u0646 \u0633\u06d2 \u0627\u0648\u067e\u0631 \u062e\u0631\u0627\u0628 \u06c1\u06d2"}, {"speaker": "A", "start": 319.94, "end": 326.6, "text": "\u0641\u0641\u0644\u06cc\u0646 \u0633\u06d2 \u0627\u0648\u067e\u0631 \u062e\u0631\u0627\u0628 \u06c1\u06d2 \u06c1\u0627\u06ba \u0648\u06c1 \u0645\u06cc\u0679 \u06af\u0648\u0644 \u0645\u06cc\u06ba \u067e\u0691\u06be \u0631\u06c1\u06cc \u06a9\u0686\u06be \u0628\u06cc\u0633 \u06a9\u06c1\u06c1 \u0631\u06c1\u06d2 \u062a\u06be\u06d2 \u06a9\u0686\u06be \u06a9\u06c1\u06c1 \u0631\u06c1\u06d2 \u062a\u06be\u06d2 \u0641\u0641\u0679\u06cc\u0646 \u0633\u06d2 \u0627\u0648\u067e\u0631 \u06a9\u06be\u0627 \u0631\u06c1\u06d2 \u062a\u06be\u06d2"}, {"speaker": "B", "start": 326.6, "end": 328.4, "text": "\u06c1\u0627\u06ba"}, {"speaker": "A", "start": 328.88, "end": 329.52, "text": "\u0641\u0641\u0679\u06cc\u0646 \u0633\u06d2 \u0627\u0648\u067e\u0631"}, {"speaker": "B", "start": 329.52, "end": 331.86, "text": "\u06c1\u06d2 \u0641\u0641\u0679\u06cc\u0646 \u0628\u06cc\u0633 \u0646\u06c1\u06cc\u06ba \u0628\u06cc\u0633 \u06a9\u0648 \u0628\u06c1\u062a \u0627\u0648\u067e\u0631 \u0686\u0644\u0627 \u06af\u06cc\u0627"}, {"speaker": "A", "start": 331.86, "end": 332.8, "text": "\u0641\u0641\u0679\u06cc\u0646"}, {"speaker": "B", "start": 332.8, "end": 339.6, "text": "\u0633\u06d2 \u0631\u06a9\u06be\u06cc\u06ba \u06c1\u0627\u06ba \u0641\u0641\u0679\u06cc\u0646 \u0633\u06d2 \u0646\u06cc\u0686\u06d2 \u06a9\u0627 \u0679\u0627\u06a9 \u0631\u06a9\u06be\u06cc\u06ba \u062f\u0648 \u0645\u06c1\u06cc\u0646\u06d2 \u0628\u0639\u062f \u062f\u0648\u0628\u0627\u0631\u06c1 \u0627\u06cc\u06a9 \u0645\u06c1\u06cc\u0646\u06d2 \u067e\u0631 \u0627\u06cc\u06a9 \u06a9\u0631\u0648\u0627 \u0644\u06cc\u062c\u06cc\u06d2 \u06af\u0627 \u0627\u0633 \u06a9\u0627 \u062e\u0627\u0644\u06cc \u0645\u06cc\u0679 \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u06d2 \u0646\u0627 \u06c1\u0645\u06cc\u0634\u06c1 \u0641\u0627\u0633\u0679\u0646\u06af \u06c1\u06d2"}, {"speaker": "A", "start": 339.6, "end": 344.94, "text": "\u0635\u062d\u06cc\u062d \u0628\u06cc\u0679\u0627 \u0627\u0648\u0631 \u067e\u0686\u06be\u0644\u06d2 \u062f\u0646 \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u06a9\u0648\u0626\u06cc \u0628\u06be\u0627\u0626\u06cc \u0622\u0626\u06d2"}, {"speaker": "B", "start": 346.2, "end": 355.3, "text": "\u067e\u0686\u06be\u0644\u06d2 \u062f\u0646 \u06a9\u06cc\u0627 \u0622\u067e \u0622\u06af\u06d2 \u0645\u062a \u06a9\u0631\u0646\u0627 \u0622\u067e \u0679\u06be\u0627\u0626\u06cc\u06d2 \u0686\u0627\u06c1\u06cc\u06d2 \u0628\u0633 \u0628\u06cc\u0679\u06be\u06cc\u06ba \u0645\u06cc\u06ba \u067e\u0631\u0686\u06c1 \u0628\u06be\u06cc \u062c\u0627\u062a\u0627 \u06c1\u0648\u06ba \u06af\u0627 \u0627\u0646\u06c1\u0648\u06ba \u06a9\u0648 \u0628\u062a\u0627 \u062f\u06cc\u06ba \u0627\u0633 \u06a9\u0648 \u0648\u06cc\u0679\u06cc\u0645\u0646 \u0688\u06cc \u06a9\u0627 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u0627 \u0646\u0627"}], "language": "auto", "duration_s": 355.6, "num_segments": 91}