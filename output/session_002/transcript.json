{"utterances": [{"speaker": "A", "start": 10.13, "end": 22.79, "text": "\u0905\u091a\u094d\u091b\u093e \u0939\u0948 \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0915\u0930 \u0932\u0947\u0924\u0940 \u0939\u0948 \u0915\u093f \u0935\u0939 \u0926\u094b \u0917\u094b\u0932\u0940 \u0938\u0941\u092c\u0939 \u090f\u0915 \u0917\u094b\u0932\u0940 \u0926\u0941\u092c\u0939\u0930 \u0914\u0930 \u0926\u094b \u0917\u094b\u0932\u0940 \u0932\u093e\u092d \u0907\u0938 \u091a\u0932\u0924\u093e \u0939\u0948 \u0914\u0930 \u0915\u0939\u093e\u0902 \u0938\u0947 \u091f\u094d\u0930\u0940\u091f\u092e\u0947\u0902\u091f \u0906\u092a\u0915\u093e \u091a\u0932 \u0935\u093e\u0932\u093e \u0939\u0948"}, {"speaker": "B", "start": 22.79, "end": 24.35, "text": "\u092f\u0939 \u092c\u0939\u0941\u0924 \u0924\u0930\u0939 \u0939\u0948"}, {"speaker": "A", "start": 24.35, "end": 26.39, "text": "\u0921\u0949\u0915\u094d\u091f\u0930"}, {"speaker": "B", "start": 26.39, "end": 28.11, "text": "\u0938\u092e\u0930\u0940\u0928 \u0906\u091c\u0942\u0930 \u0920\u0940\u0915"}, {"speaker": "A", "start": 28.11, "end": 29.49, "text": "\u0939\u0948 \u0914\u0930 \u0926\u092c\u093e\u0908 \u0915\u094d\u092f\u094b\u0902 \u0906\u092a\u0928\u0947"}, {"speaker": "B", "start": 29.49, "end": 48.77, "text": "\u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u092a\u0947\u0921\u093c\u093e \u0930\u0939\u0940 \u0939\u0948 \u0938\u093f\u0930\u094d\u092b \u091a\u093e\u0930 \u0939\u092b\u093c\u0924\u0947 \u0916\u093e\u0932\u0940 \u0939\u0948 \u0914\u0930 \u0909\u0938 \u092c\u093e\u0926 \u091f\u0947\u0938\u094d\u091f \u0915\u0930 \u0930\u0939\u093e \u0939\u0948 \u0906\u092a\u0915\u093e \u0930\u0942\u0916\u0940"}, {"speaker": "A", "start": 51.2, "end": 55.96, "text": "\u092c\u093e\u0926 \u0939\u092e \u0926\u093f\u092f\u093e \u0939\u0941\u0906 \u092f\u0939 \u0928\u0940\u091a\u0947 \u0906 \u0917\u092f\u093e \u0914\u0930 \u0926\u094b\u092c\u093e\u0930\u093e \u0917\u093f\u0930 \u0917\u092f\u093e \u0925\u0940"}, {"speaker": "B", "start": 55.96, "end": 60.93, "text": "\u0932\u0947\u0915\u093f\u0928 \u0926\u093f\u092f\u093e \u0925\u0940 \u092e\u0948\u0902 \u091c\u094b \u0916\u093e\u0932\u0940 \u0925\u0940 \u0928\u093e \u092e\u0947\u0930\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u092a\u0902\u0927\u0930 \u0928\u094c \u0915\u0940"}, {"speaker": "A", "start": 60.93, "end": 66.48, "text": "\u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0939\u0948 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0906\u092a\u0928\u0947 \u0915\u0930\u093e\u092f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948 \u091c\u0940 \u092f\u0939 \u092c\u0939\u0941\u0924 \u092c\u0939\u0941\u0924 \u0928\u0939\u0940\u0902 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0939\u0948 \u0924\u094b \u091f\u0947\u0938\u094d\u091f \u0915\u0930\u0928\u093e \u0939\u0948 \u0926\u094b\u092c\u093e\u0930\u093e \u0926\u0947\u0916\u0928\u093e"}, {"speaker": "A", "start": 67.8, "end": 75.04, "text": "\u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0947 \u091f\u0940\u090f\u0938\u0947\u0938 \u0926\u094d\u0935\u093e\u0930\u093e \u091f\u0940\u090f\u0938\u0947\u0938 \u092b\u091f\u0940 \u092b\u091f\u0940 \u092b\u094b\u0932\u094d\u0921 \u0932\u093f\u0916\u0924\u093e \u0939\u0942\u0902 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0935\u0939 \u0915\u094d\u092f\u093e \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0906\u0924\u0940 \u0939\u0948 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0905\u092d\u0940 \u0915\u094d\u092f\u093e -\u0915\u094d\u092f\u093e \u0907\u0936\u0941\u0938 \u092a\u0930\u0947\u0936\u093e\u0928 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0906\u092a\u0915\u094b"}, {"speaker": "B", "start": 75.04, "end": 79.18, "text": "\u090f\u0915 \u092c\u093e\u0926 \u0928\u0939\u0940\u0902 \u0939\u094b \u091c\u093e\u090f\u0917\u093e \u092e\u0948\u0902\u0928\u0947 \u092c\u0922\u093c\u0928\u093e \u0939\u0948 \u092c\u0947\u091f \u092c\u0922\u093c\u0928\u093e \u0939\u0948 \u0906\u092a\u0915\u094b \u0920\u0940\u0915"}, {"speaker": "A", "start": 79.18, "end": 79.4, "text": "\u0939\u0948"}, {"speaker": "B", "start": 84.02, "end": 85.98, "text": "\u0915\u0941\u091b \u0939\u094b \u091c\u093e\u090f\u0917\u093e \u0914\u0930"}, {"speaker": "A", "start": 85.98, "end": 88.68, "text": "\u0930\u093e\u0924 \u092e\u0947\u0902 \u091c\u0940 \u091c\u094d\u091e\u093e\u0926"}, {"speaker": "B", "start": 88.68, "end": 89.3, "text": "\u0939\u0948"}, {"speaker": "B", "start": 90.84, "end": 95.3, "text": "\u091c\u094b \u0915\u0930\u0947\u0902 \u0924\u094b \u092f\u0939"}, {"speaker": "A", "start": 95.97, "end": 101.25, "text": "\u092a\u094d\u0932\u0947\u091f\u0930 \u091c\u0948\u0938\u093e \u092f\u0939 \u092c\u0922\u093c \u0917\u092f\u093e \u0939\u0948 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0915\u093f \u0906\u092a \u091c\u0917\u0939 \u092a\u0930 \u092f\u0939"}, {"speaker": "B", "start": 102.03, "end": 102.57, "text": "\u0915\u093f"}, {"speaker": "A", "start": 102.57, "end": 105.67, "text": "\u0924\u094b \u0907\u0938 \u0906\u0902\u0938\u093e \u0915\u0930\u093e \u092b\u0941\u0932\u0947 \u092e\u0947\u0902 \u0924\u0915\u0932\u0940\u0915 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0909\u0938 \u0938\u093e\u0930\u0938"}, {"speaker": "B", "start": 105.67, "end": 108.21, "text": "\u092b\u0941\u0932\u0924\u093e \u0939\u0948 \u0906\u092a\u0915\u093e \u091c\u094b"}, {"speaker": "A", "start": 108.21, "end": 110.61, "text": "\u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092a\u094d\u0930\u0949\u092c\u094d\u0932\u092e \u0939\u0948 \u0935\u0948\u091f \u092f\u0939 \u0915\u093f\u0924\u0928\u093e \u092c\u0947\u091f \u092c\u0921\u093c\u093e"}, {"speaker": "B", "start": 126.85, "end": 131.67, "text": "\u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0915\u0930\u0928\u093e \u0939\u093e\u0930\u094d\u091f"}, {"speaker": "A", "start": 131.67, "end": 135.37, "text": "\u0930\u0947\u091f \u092c\u0922\u093c \u091c\u093e\u0924\u093e \u0939\u0948 \u0926\u093f\u0932 \u0915\u0940 \u0930\u092b\u094d\u0924\u093e\u0930 \u0924\u0947\u091c \u0939\u094b\u0924\u0940 \u0939\u0948 \u0905\u092d\u0940 \u0939\u0948 \u0930\u0916\u0947\u0902 \u0939\u093e\u0925 \u0930\u0916\u0947\u0902"}, {"speaker": "B", "start": 141.67, "end": 143.07, "text": "\u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c"}, {"speaker": "A", "start": 143.07, "end": 161.26, "text": "\u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c"}, {"speaker": "B", "start": 163.96, "end": 165.36, "text": "\u092f\u0939"}, {"speaker": "A", "start": 166.86, "end": 167.88, "text": "\u0938\u092c\u0938\u094d\u0915\u094d\u0930\u093e\u0907\u092c \u092f\u0939"}, {"speaker": "A", "start": 188.74, "end": 197.38, "text": "\u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0939\u092e \u0906\u092a\u0915\u093e \u091f\u0947\u0938\u094d\u091f \u0926\u0941\u092c\u093e\u0930\u093e \u0915\u0930\u0935\u093e \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 \u0920\u0940\u0915 \u0939\u0948 \u0914\u0930 \u092f\u0939 \u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930"}, {"speaker": "A", "start": 204.62, "end": 217.02, "text": "\u092f\u0939 \u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939 \u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939 \u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939 \u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902"}, {"speaker": "B", "start": 217.02, "end": 217.28, "text": "\u0914\u0930 \u092f\u0939"}, {"speaker": "A", "start": 217.28, "end": 223.16, "text": "\u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939 \u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939 \u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939 \u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939"}, {"speaker": "B", "start": 223.16, "end": 226.02, "text": "\u092c\u0939\u0941\u0924 \u0915\u093e\u092e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930"}, {"speaker": "A", "start": 226.02, "end": 226.9, "text": "\u092f\u0939 \u092c\u0939\u0941\u0924"}, {"speaker": "B", "start": 226.9, "end": 227.36, "text": "\u0915\u093e\u092e\u0932 \u0939"}, {"speaker": "A", "start": 239.06, "end": 239.42, "text": "\u091a\u0932\u0947,"}, {"speaker": "A", "start": 242.6, "end": 262.5, "text": "\u092e\u0948\u0902 \u0926\u0947\u0924\u093e \u0906\u092a\u0915\u094b, \u092e\u0948\u0902 \u0926\u094b \u0924\u0940 \u091a\u0940\u091c\u093c\u0947\u0902 \u0926\u0947 \u0930\u0939\u093e \u0939\u0942\u0902, \u0905\u0917\u0930 \u090f\u0915 \u092c\u093e\u0930 \u0926\u0935\u093e\u0908 \u0915\u0930\u0947\u0902 \u0920\u0940\u0915 \u0939\u0948 \u0905\u092c \u0928\u0949\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u0926\u0947\u0916 \u0930\u0939\u0940 \u0939\u0948 \u0906\u092a\u0938\u0947 \u0935\u0939\u093e\u0901 \u0915\u093e \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0905\u0930\u0923\u0915\u094d\u0937\u093e \u0935\u0939 \u0926\u093f\u0916\u093e \u0926\u0947\u0902\u0917\u0947 \u0914\u0930 \u0909\u0938 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0947 \u0905\u0915\u093e\u0909\u0902\u091f\u093f\u0902\u0917 \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u0926\u0935\u093e\u0908"}, {"speaker": "A", "start": 262.5, "end": 265.92, "text": "\u0905\u0917\u0930 \u0939\u094b\u0917\u093e \u0924\u094b \u092e\u0948\u0902 \u0936\u0941\u0930\u0942 \u0915\u0930 \u0926\u0942\u0902\u0917\u093e \u0915\u093e\u0930\u094d\u0921 \u0906\u092a\u0915\u0940 \u092c\u093e\u0930 \u091c\u0930\u0942\u0930 \u0932\u0947\u0915\u0930 \u0906\u090f\u0902\u0917\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948"}, {"speaker": "B", "start": 265.92, "end": 278.48, "text": "\u0935\u0947\u091f"}, {"speaker": "A", "start": 278.48, "end": 281.82, "text": "\u0915\u0940 \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u0940 \u0914\u0930 \u0920\u0940\u0915 \u0939\u0948"}, {"speaker": "B", "start": 281.82, "end": 288.08, "text": "\u0907\u0938\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092a\u0930 \u0928\u093f\u0936\u093e\u0928 \u0939\u0941\u0906 \u0925\u093e \u092e\u0948\u0902 \u0906\u092a\u0915\u094b"}, {"speaker": "A", "start": 288.08, "end": 297.84, "text": "\u0926\u0947 \u0930\u0939\u093e \u0939\u0942\u0902 \u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u0926\u0947 \u0930\u0939\u093e \u0939\u0942\u0902 \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0938\u0947"}], "language": "auto", "duration_s": 299.1, "num_segments": 88}