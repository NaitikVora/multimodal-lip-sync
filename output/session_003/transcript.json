{"utterances": [{"speaker": "A", "start": 5.44, "end": 7.18, "text": "\u0645\u0631\u062d\u0628\u0627 \u0641\u0631\u06cc\u062f \u0635\u0627\u062d\u0628"}, {"speaker": "A", "start": 8.62, "end": 13.4, "text": "\u06a9\u06cc\u0633\u06d2 \u06c1\u06cc\u06ba \u0622\u067e \u0641\u0631\u06cc\u062f \u0635\u0627\u062d\u0628 \u0627\u0686\u06be\u0627 \u0622\u067e \u067e\u06c1\u0644\u06cc \u0628\u0627\u0631 \u062f\u06a9\u06be\u0627 \u0631\u06c1\u06d2"}, {"speaker": "B", "start": 13.4, "end": 13.78, "text": "\u06c1\u06cc\u06ba \u067e\u06c1\u0644\u06cc \u0628\u0627\u0631"}, {"speaker": "A", "start": 13.78, "end": 14.2, "text": "\u062f\u06a9\u06be\u0627 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 14.2, "end": 19.4, "text": "\u0627\u0648\u0631 \u0634\u06af\u0631 \u062a\u0648 \u0622\u067e \u06a9\u06cc \u0628\u06c1\u062a \u0628\u06be\u0627\u0626\u06cc \u062c\u0627 \u0631\u06c1\u06cc \u06c1\u06d2 \u0686\u0627\u06c1\u06cc\u06d2 \u067e\u0627\u0646\u0686 \u0633\u0648 \u0686\u0627\u0644\u06cc\u0633 \u06a9\u06d2 \u063a\u0631\u06cc\u0628 \u0622\u067e \u06a9\u06cc \u0634\u06af\u0631 \u0622 \u0631\u06c1\u06cc \u06c1\u06d2"}, {"speaker": "A", "start": 19.4, "end": 29.6, "text": "\u0645\u06cc\u06ba \u0648\u06c1\u0627\u06ba \u0631\u06c1\u062a\u0627 \u06c1\u0648\u06ba \u06af\u06be\u0627\u0624\u06ba \u0645\u06cc\u06ba \u06c1\u06cc\u06ba \u062f\u06cc \u0622\u0626\u06cc \u06a9\u06be\u0627\u0646 \u0645\u06cc\u06ba \u0631\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u06cc\u06a9 \u06c1\u0641\u062a\u06c1"}, {"speaker": "B", "start": 29.6, "end": 31.54, "text": "\u06c1\u0648 \u06af\u06cc\u0627 \u0622\u067e \u0627\u0646 \u06a9\u06d2 \u0628\u06cc\u0679\u06d2 \u06c1\u06cc\u06ba \u062a\u0648"}, {"speaker": "A", "start": 31.54, "end": 38.06, "text": "\u0648\u06c1\u0627\u06ba \u067e\u0631 \u062a\u0648 \u0635\u062d\u06cc\u062d \u062a\u06be\u06d2 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u06cc\u06c1\u0627\u06ba \u067e\u0631 \u0622\u06a9\u06d2 \u0627\u0686\u0627\u0646\u06a9 \u06c1\u0641\u062a\u06c1 \u0628\u06be\u0631 \u0633\u06d2 \u0634\u062f\u06cc\u062f \u062c\u0644\u0646 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2"}, {"speaker": "A", "start": 38.98, "end": 46.04, "text": "\u06af\u0627\u0624\u06ba \u0645\u06cc\u06ba \u0627\u06cc\u0633\u0627 \u0646\u06c1\u06cc\u06ba \u062a\u06be\u0627 \u0633\u0628 \u0627\u0644\u062d\u0645\u062f\u0644\u0644\u06c1 \u0646\u0648\u0631\u0645\u0644 \u0628\u06be\u06cc \u0622\u067e \u0648\u06c1\u0627\u06ba"}, {"speaker": "B", "start": 46.04, "end": 48.54, "text": "\u0686\u06cc\u06a9 \u06a9\u0631\u062a\u06d2 \u062a\u06be\u06d2 \u06af\u0627\u0624\u06ba \u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u0634\u06af\u0631 \u0648\u063a\u06cc\u0631\u06c1 \u06c1\u0627\u06ba"}, {"speaker": "A", "start": 48.54, "end": 49.48, "text": "\u0628\u0627\u062a \u06c1\u06d2 \u06c1\u0648\u06ba \u0686\u06a9\u0646\u06d2 \u06a9\u0627"}, {"speaker": "B", "start": 51.5, "end": 55.0, "text": "\u06a9\u06cc\u0627 \u0634\u06af\u0631 \u0622\u067e \u0686\u06cc\u06a9 \u06c1\u06cc \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u0622\u067e \u06a9\u06cc\u0633\u0627 \u067e\u062a\u06c1 \u0686\u0644\u06d2 \u06af\u0627 \u06a9\u06c1 \u06a9\u062a\u0646\u06cc \u06a9\u0646\u0679\u0631\u0648\u0644 \u06c1\u0648\u0626\u06cc \u06a9\u06c1"}, {"speaker": "A", "start": 55.0, "end": 58.3, "text": "\u06af\u06be\u0631 \u0645\u06cc\u06ba \u0628\u0686\u06d2 \u062a\u0627\u0646\u06af \u06c1\u0648 \u06af\u0626\u06d2"}, {"speaker": "A", "start": 59.24, "end": 63.34, "text": "\u062c\u0628 \u0633\u0648\u0688\u06cc\u06d2 \u06c1\u06cc\u06ba \u062a\u0648\u0648\u0626\u06cc \u06c1\u06cc\u06ba \u0627\u0646\u062a\u0631\u0646\u062a \u0633\u06d2 \u067e\u06cc\u0631\u0648\u06ba \u0645\u06cc\u06ba \u06cc\u06c1 \u062c\u06af\u0631 \u0628\u06be\u06cc \u062f\u0627\u0631\u062a\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 65.82, "end": 66.24, "text": "\u06cc\u06c1"}, {"speaker": "A", "start": 66.24, "end": 72.86, "text": "\u062c\u06af\u0631 \u067e\u06c1 \u062f\u0627\u0631\u062a\u0627 \u06c1\u06d2 \u06cc\u06c1 \u062f\u0631 \u067e\u0631 \u06cc\u06c1 \u062c\u06af\u0631 \u06c1\u06d2 \u06cc\u06c1 \u0634\u06a9\u0631 \u06c1\u06d2 \u0627\u0648\u0631 \u06cc\u06c1 \u062f\u0627\u0646\u06af \u062f\u0631 \u067e\u0631 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u06cc\u06c1 \u062c\u06af\u0631 \u06c1\u0648\u06af\u06cc \u06c1\u06d2"}, {"speaker": "B", "start": 72.86, "end": 92.82, "text": "\u0622\u067e \u0646\u06d2 \u0634\u06af\u0631 \u062f\u06cc\u06a9\u06be\u06cc \u067e\u0627\u0646\u0686 \u0633\u0648 \u0622\u067e \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u0645\u06cc\u0631\u06cc \u0628\u0627\u062a \u0633\u0646\u0646\u0627 \u0627\u06af\u0631 \u0634\u06af\u0631 \u0627\u062a\u0646\u06cc \u06c1\u0627\u0626\u06d2 \u0631\u06c1\u06d2 \u06af\u06cc \u0627\u06cc\u0633\u06cc \u0645\u0631\u06cc\u0636 \u06a9\u06cc \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0622\u067e \u06a9\u0648 \u0627\u0646 \u06a9\u0648 \u06af\u0627\u0624\u06ba \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u067e\u062a\u0627 \u0686\u0644\u062a\u0627 \u06c1\u0648\u06af\u0627 \u0628\u0627\u0642\u06cc \u0622\u0628\u0648 \u0622\u0628\u0627 \u06a9\u06cc \u0648\u06cc\u0633\u06d2 \u0645\u06af\u0631 \u06a9\u0627\u0645 \u062a\u0648 \u0627\u0646\u062f\u0631 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u0648\u06af\u0627 \u0634\u06af\u0631 \u0627\u0648\u0631 \u0634\u06af\u0631 \u06a9\u06cc\u0627 \u06a9\u0631\u062a\u06cc \u06c1\u06d2 \u0627\u067e\u0646\u06d2 \u0622\u067e \u06a9\u0648 \u0646\u0645\u0648\u062f\u0627\u0631 \u06a9\u0631\u062a\u06cc \u06c1\u06d2 \u062c\u0628 \u0646\u0645\u0648\u062f\u0627\u0631 \u06a9\u0631\u062a\u06cc \u06c1\u06d2 \u0627\u0646\u06cc\u0686\u0631\u06cc \u062a\u0648 \u0627\u067e\u0646\u06d2 \u0622\u067e \u06a9\u0648 \u0645\u0644\u0688 \u0627\u067e \u06a9\u0631\u062a\u06cc \u06c1\u06d2 \u0627\u067e\u0646\u06d2 \u062c\u0633\u0645 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06d2 \u0628\u0691\u06be\u0627\u062a\u06cc"}, {"speaker": "B", "start": 92.82, "end": 112.54, "text": "\u06c1\u06d2 \u0627\u067e\u0646\u06d2 \u0622\u067e \u06a9\u0648 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u062c\u0628 \u0648\u06c1 \u067e\u0648\u0644\u06cc \u0627\u067e\u0646\u06d2 \u067e\u06cc\u06a9 \u067e\u06c1 \u0622 \u062c\u0627\u062a\u06cc \u06c1\u06d2 \u067e\u06be\u0631 \u0648\u06c1 \u0622\u067e \u06a9\u0648 \u0627\u0679\u06cc\u06a9 \u06a9\u0631\u062a\u06cc \u06c1\u06d2 \u062a\u0648 \u0645\u06cc\u06ba \u06cc\u06c1 \u062a\u0635\u0648\u0631 \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0627\u0646 \u06a9\u0648 \u0634\u06af\u0631 \u0627\u0628\u06be\u06cc \u06a9\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0634\u06af\u0631 \u067e\u0631\u0627\u0646\u06cc \u06c1\u06d2 \u0645\u0637\u0644\u0628 \u062e\u0631\u0627\u0628 \u0634\u06af\u0631 \u0646\u06c1\u06cc\u06ba \u0648\u06c1 \u062a\u0648 \u06c1\u06d2 \u062e\u0631\u0627\u0628 \u0634\u06af\u0631 \u067e\u0631\u0627\u0646\u06cc \u06c1\u06d2 \u06cc\u0639\u0646\u06cc \u0634\u06af\u0631 \u0622\u067e \u06a9\u06cc \u0627\u0628\u06be\u06cc \u062e\u0631\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06cc\u06c1 \u0634\u06af\u0631 \u0686\u0644 \u0631\u06c1\u06cc \u06c1\u0648\u06af\u06cc \u062e\u0631\u0627\u0628 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u062c\u0628 \u0645\u0631\u06cc\u0636 \u0645\u06cc\u06ba \u06a9\u06c1\u062a\u0627 \u06c1\u06d2 \u0645\u06cc\u0631\u06d2 \u067e\u06cc\u0631\u0648\u06ba \u0645\u06cc\u06ba \u062c\u0644\u0646 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2 \u0686\u0648\u0628\u0646 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2 \u0627\u0633 \u06a9\u0627 \u0645\u0637\u0644\u0628 \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u0627\u0628\u06be\u06cc \u06a9\u06cc \u062c\u0644\u0646 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0634\u06af\u0631 \u067e\u0631\u0627\u0646\u06cc \u0686\u0648\u0628\u0646 \u06c1\u06d2"}, {"speaker": "B", "start": 112.54, "end": 123.24, "text": "\u062a\u0648 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u062f\u0648\u0627\u0626\u06cc\u0627\u06ba \u06a9\u0686\u06be \u0633\u0679\u0627\u0631\u0679 \u06a9\u0631\u062a\u0627 \u06c1\u0648\u06ba \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u067e\u06cc\u0631\u0648\u06ba \u06a9\u06cc \u062c\u0644\u0646 \u0686\u0648\u0628\u0646 \u06a9\u06d2 \u0644\u0626\u06d2 \u0634\u06af\u0631 \u06a9\u06d2 \u0644\u0626\u06d2 \u06a9\u0686\u06be \u0679\u06cc\u0633 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0644\u06a9\u06be \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba \u0648\u06c1 \u0622\u067e \u06a9\u0631\u0648\u0627 \u062f\u06cc\u06ba \u0645\u06cc\u0679\u0631 \u06c1\u06d2 \u0634\u06af\u0631 \u06a9\u0627 \u0622\u0644\u06c1 \u06c1\u06d2 \u0686\u06cc\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u06c1\u06d2 \u062a\u0648 \u0622\u067e \u0646\u06d2 \u0630\u0631\u0627 \u0634\u06af\u0631 \u0628\u06be\u06cc \u0646\u0627\u067e\u0646\u06cc \u06c1\u06d2 \u0627\u0633 \u06a9\u06d2 \u067e\u0631"}, {"speaker": "B", "start": 124.14, "end": 137.6, "text": "\u062c\u06cc \u0628\u0627\u0644\u06a9\u0644 \u0628\u0627\u0644\u06a9\u0644 \u0622\u067e \u0646\u06d2 \u0634\u06af\u0631 \u0628\u06be\u06cc \u0646\u0627\u067e\u0646\u06cc \u06c1\u06d2 \u0634\u06af\u0631 \u0622\u067e \u0646\u0627\u067e\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u0622\u067e \u06a9\u0648 \u067e\u062a\u06c1 \u0686\u0644\u06d2 \u06af\u0627 \u0634\u06af\u0631 \u0645\u06cc\u06ba \u06a9\u062a\u0646\u06cc \u0635\u062f\u0627 \u06c1\u06d2 \u06a9\u062a\u0646\u06cc \u062e\u0631\u0627\u0628\u06cc \u06c1\u06d2 \u0627\u0648\u0631 \u0627\u0628\u06be\u06cc \u062f\u0648\u0627\u0626\u06cc \u0645\u06cc\u06ba \u0679\u06cc\u0633 \u0628\u06be\u06cc \u06a9\u0686\u06be \u0644\u06a9\u06be \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba \u0648\u06c1 \u0628\u06be\u06cc \u0627\u0648\u0631 \u067e\u06cc\u0631\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u06be\u06cc \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u062f\u06d2 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u0646\u06c1\u06cc\u06ba \u0648\u06c1 \u0641\u0627\u0626\u062f\u06c1 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0631\u06c1\u06cc \u06c1\u06d2 \u0648\u06c1"}, {"speaker": "A", "start": 137.6, "end": 139.28, "text": "\u0686\u06cc\u0646\u062c"}, {"speaker": "B", "start": 139.28, "end": 141.76, "text": "\u06a9\u0631\u062a\u0627 \u06c1\u0648\u06ba \u0645\u06cc\u06ba \u0627\u0648\u0631 \u0627\u06cc\u06a9 \u06c1\u0641\u062a\u06d2 \u0645\u06cc\u06ba \u062f\u06cc\u06a9\u06be \u0644\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba \u067e\u06be\u0631 \u06a9\u062a\u0646\u0627 \u0641\u0631\u0642 \u0622\u062a\u0627 \u06c1\u06d2"}, {"speaker": "A", "start": 141.76, "end": 142.62, "text": "\u0631\u0648\u0632\u06c1"}, {"speaker": "B", "start": 142.62, "end": 143.14, "text": "\u0631\u06a9\u06be\u06cc\u06ba \u06af\u06d2 \u0622\u067e"}, {"speaker": "A", "start": 143.14, "end": 144.98, "text": "\u0631\u06a9\u06be\u06cc\u06ba"}, {"speaker": "B", "start": 144.98, "end": 147.14, "text": "\u06af\u06d2 \u0646\u0627 \u067e\u06be\u0631 \u0627\u0628 \u0631\u0645\u0636\u0627\u0646 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u067e\u06be\u0631 \u0622\u067e \u06a9\u0648 \u062f\u06cc\u06a9\u06be \u0644\u06cc\u06ba"}, {"speaker": "A", "start": 147.14, "end": 148.26, "text": "\u06af\u06d2 \u0679\u06be\u06cc\u06a9"}, {"speaker": "B", "start": 148.26, "end": 150.28, "text": "\u06c1\u06d2 \u0646\u0627 \u0627\u0648\u0631 \u06a9\u0648\u0626\u06cc \u0686\u06cc\u0632 \u062c\u0648 \u06c1\u06d2 \u0628\u062a\u0627\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 150.28, "end": 156.26, "text": "\u06a9\u0645\u0632\u0648\u0631\u06cc \u06c1\u06d2 \u06a9\u0645\u0632\u0648\u0631\u06cc"}, {"speaker": "B", "start": 156.26, "end": 157.36, "text": "\u06a9\u06cc\u0644\u0626\u06d2 \u0645\u06cc\u062a\u0631\u06cc \u0642\u0628\u0627\u0644 \u0628\u06cc\u0679\u06cc \u0644\u06a9\u06be\u0648"}, {"speaker": "A", "start": 157.36, "end": 168.52, "text": "\u0627\u0686\u06be\u0627 \u062c\u0644\u06a9\u0627 \u0628\u06be\u06cc \u0688\u0627\u06a9\u0679\u0631 \u0635\u0627\u062d\u0628 \u0622\u06c1 \u0648\u06c1 \u0628\u06be\u06cc \u0627\u0633 \u06a9\u06cc \u0628\u06be\u06cc \u0648\u06c1 \u0644\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u0648\u0646\u0633\u06cc \u0644\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0644 \u06a9\u06cc \u0631\u0648\u0627\u0626\u06d2 \u06c1\u06cc\u06ba \u0648\u06c1 \u0628\u06be\u06cc \u0628\u062a\u0627 \u062f\u06cc\u06ba \u062a\u0627\u06a9\u06c1"}, {"speaker": "B", "start": 168.52, "end": 169.02, "text": "\u0645\u0639\u0644\u0648\u0645 \u06c1\u0648\u0646\u0627"}, {"speaker": "B", "start": 174.45, "end": 181.24, "text": "\u06cc\u06c1 \u06c1\u06d2 \u06cc\u06c1 \u062a\u06cc\u0646 \u06c1\u06d2 \u06cc\u06c1 \u062a\u06cc\u0646 \u06c1\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0627\u0633 \u06a9\u0648 \u0622\u067e \u06a9\u0646\u0679\u06cc\u0646\u06cc\u0648 \u06a9\u0631\u06cc\u06d2 \u06a9\u06c1 \u0627\u0633 \u06a9\u0648 \u06c1\u0645 \u0627\u0633 \u06a9\u0648 \u06c1\u0645 \u0646\u06cc\u0686\u06d2 \u06a9\u0631\u06cc\u06ba"}, {"speaker": "B", "start": 182.44, "end": 190.02, "text": "\u06a9\u0645\u0632\u0648\u0631\u06cc \u06a9\u06d2 \u0628\u0639\u062f \u0628\u06cc\u0648\u0627\u0646 \u06c1\u06d2 \u06a9\u0686\u06be \u0628\u06be\u06cc \u0628\u0648\u0644\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0634\u06af\u0631 \u0686\u0627\u0631\u0679\u0646\u06af \u0628\u062a\u0627\u0626\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0627\u0633\u0645\u06cc \u06a9\u06cc \u067e\u0631\u0648\u0627\u0626\u06cc\u0688 \u06a9\u0631\u06cc\u06ba \u0679\u06cc\u0633 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0628\u062a\u0627 \u062f\u06cc\u06ba \u0627\u0648\u0631 \u0631\u06cc\u067e\u0648\u0631\u0679 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0628\u062a\u0627 \u062f\u06cc\u06ba \u0679\u06cc\u0633 \u062c\u0648 \u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 190.02, "end": 190.6, "text": "\u0688\u0627\u06a9\u0679\u0631 \u0635\u0627\u062d\u0628 \u06cc\u06c1"}, {"speaker": "B", "start": 190.6, "end": 193.84, "text": "\u0628\u0644\u06cc\u0688 \u0679\u06cc\u0633 \u06c1\u06d2 \u0688\u0627\u0644 \u0633\u06d2 \u06a9\u0631\u0648\u0627\u0646\u06d2 \u06c1\u06cc\u06ba \u06cc\u0627 \u0633\u06cc\u0641\u06cc \u0633\u06d2 \u06a9\u0631\u0648\u0627\u0646\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 193.84, "end": 197.36, "text": "\u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0627\u0648\u0631 \u06cc\u06c1 \u0633\u06cc\u0645 \u0679\u0627\u0626\u0645 \u0631\u06cc\u067e\u0648\u0631\u0679 \u0645\u0644\u06d2 \u06af\u06cc \u0627\u06cc\u06a9 \u062f\u0646 \u0645\u06cc\u06ba \u0645\u0644 \u062c\u0627\u062a\u06cc"}, {"speaker": "B", "start": 197.36, "end": 215.12, "text": "\u06c1\u06d2 \u0627\u0648\u0631 \u0645\u06cc\u06ba \u0686\u0627\u06c1 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0627\u06cc\u06a9 \u06c1\u0627\u062a\u06be \u06c1\u0641\u062a\u06c1 \u062f\u0648\u0627\u0626\u06cc \u0628\u06be\u06cc \u0634\u0631\u0648\u0639 \u06a9\u0631\u06cc\u06ba \u0646\u0627 \u0627\u06cc\u06a9 \u06c1\u0627\u062a\u06be \u062f\u0648\u0627\u0626\u06cc \u0627\u06cc\u06a9 \u06c1\u0641\u062a\u06c1 \u06a9\u0631 \u06a9\u06d2 \u067e\u06be\u0631 \u0622\u067e \u0622 \u06a9\u0631 \u0631\u06cc\u0688\u0646\u06af \u0628\u062a\u0627 \u062f\u06cc\u0626\u06d2 \u06af\u0627 \u0627\u0646 \u06a9\u0627 \u0622\u0646\u0627 \u0636\u0631\u0648\u0631\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0622\u067e \u0622 \u06a9\u0631 \u0627\u06cc\u06a9 \u06c1\u0641\u062a\u06d2 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u067e\u06cc\u0631 \u06a9\u0648 \u0622 \u06a9\u0631 \u0628\u062a\u0627 \u062f\u06cc\u0626\u06d2 \u06af\u0627 \u06a9\u06c1 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u0622\u067e \u0646\u06d2 \u0627\u06cc\u06a9 \u06c1\u0641\u062a\u06d2 \u06a9\u06cc \u062f\u0648\u0627\u0626\u06cc \u062f\u06cc \u062a\u06be\u06cc \u0627\u0648\u0631 \u06cc\u06c1 \u06c1\u0645 \u0646\u06d2 \u062e\u0648\u0646 \u0679\u06cc\u0633 \u0628\u06be\u06cc \u06a9\u0631\u0648\u0627 \u0644\u06cc \u06cc\u06c1 \u0628\u06be\u06cc \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u06cc\u06c1 \u0634\u06af\u0631 \u06a9\u06cc \u0631\u06cc\u0688\u0646\u06af \u0622 \u0631\u06c1\u06cc \u06c1\u06d2 \u062c\u0648 \u062f\u0648\u0627\u0626\u06cc \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u062f\u06d2 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u0648\u06c1 \u0632\u06cc\u0627\u062f\u06c1 \u0645\u062a \u062f\u06cc\u062c\u0626\u06d2 \u06af\u0627 \u0627\u06cc\u06a9 \u06c1\u0641\u062a\u06d2 \u06a9\u06cc \u062f\u06cc \u062c\u0627\u0626\u06d2 \u06af\u0627"}, {"speaker": "A", "start": 215.12, "end": 218.8, "text": "\u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u06cc\u06c1 \u06a9\u06be\u0627\u0646\u06d2 \u0633\u06d2 \u067e\u06cc\u0646\u0634\u06cc \u06a9\u0631 \u0644\u06d2 \u06cc\u0627 \u06a9\u06be\u0627\u0646\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0628\u06be\u06cc \u0686\u06cc\u06a9"}, {"speaker": "B", "start": 218.8, "end": 227.48, "text": "\u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u06a9\u06be\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u0628\u06be\u06cc \u0686\u06cc\u06a9 \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u0645\u06cc\u06ba \u0686\u0627\u0631\u0679 \u0622\u067e \u06a9\u0648 \u0644\u06a9\u06be \u06a9\u0631 \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba \u0622\u067e \u0628\u062a\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u06cc\u06c1 \u0622 \u06a9\u0631 \u0644\u06cc\u06ba \u06af\u06d2 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0646\u0627 \u0622\u067e \u062a\u06a9\u0644\u06cc\u0641 \u0645\u062a \u062f\u06cc\u062c\u0626\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u0622\u067e \u06a9\u06cc \u0633\u0648\u0627\u0644 \u0644\u0648\u06af \u0633\u0627\u0645\u0646\u06d2 \u0686\u06cc\u0632 \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u06af\u0626\u06cc"}, {"speaker": "A", "start": 227.48, "end": 230.44, "text": "\u062e\u0648\u062f \u0628\u062e\u0648\u062f \u06cc\u06c1 \u0686\u06cc\u0632 \u062e\u062a\u0645 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0646\u06c1\u06cc\u06ba \u06a9\u06c1\u06d2 \u06af\u0627 \u0645\u06af\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2"}, {"speaker": "B", "start": 230.44, "end": 236.02, "text": "\u06af\u06cc \u0627\u06af\u0631 \u0622\u067e \u06a9\u06cc \u0634\u06af\u0631 \u0635\u062d\u06cc\u062d \u06c1\u0648 \u06af\u0626\u06cc \u062a\u0648 \u06cc\u06c1 \u062e\u062a\u0645 \u06c1\u0648\u062a\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u062c\u0627\u0646\u0627 \u0627\u0648\u0631 \u0622\u067e \u06a9\u06cc \u0634\u06af\u0631 \u0627\u0686\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u0631\u06c1\u06cc \u062a\u0648 \u06cc\u06c1 \u062c\u0644\u0646 \u0627\u0648\u0631 \u0622\u06af\u06d2 \u067e\u0691\u062a\u06cc \u062c\u0627\u0626\u06d2 \u06af\u0627 \u062f\u0648"}, {"speaker": "A", "start": 236.02, "end": 243.54, "text": "\u0633\u0648 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0631\u06cc\u0646\u0688\u0645 \u06c1\u0648\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2 \u06cc\u06c1 \u06a9\u0645 \u06c1\u0648 \u06af\u06cc\u0627 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u062c\u06cc \u0686\u0644\u06cc\u06ba"}, {"speaker": "B", "start": 243.54, "end": 248.36, "text": "\u0628\u0633 \u0622\u067e \u0628\u06cc\u0679\u06be\u06cc\u06ba \u067e\u0686\u06be\u0627 \u0628\u06be\u06cc\u062c\u0648\u0627 \u0627\u0648\u06a9\u06d2 \u0627\u0644\u0644\u06c1 \u0627\u06cc\u0633\u06d2 \u0628\u06cc\u0679\u06be \u06a9\u0631 \u062f\u0648"}], "language": "auto", "duration_s": 250.5, "num_segments": 73}