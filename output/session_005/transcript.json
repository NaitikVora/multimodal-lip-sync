{"utterances": [{"speaker": "A", "start": 7.54, "end": 9.36, "text": "\u0634\u0631\u06cc\u0641 \u0635\u0627\u062d\u0628 \u06a9\u06cc\u0633\u06d2 \u06c1\u06cc\u06ba\u061f"}, {"speaker": "B", "start": 9.36, "end": 9.78, "text": "\u0645\u062d\u0645\u062f"}, {"speaker": "A", "start": 9.78, "end": 11.32, "text": "\u0634\u0631\u06cc\u0641 \u0635\u0627\u062d\u0628"}, {"speaker": "B", "start": 11.32, "end": 12.64, "text": "\u0645\u062d\u0645\u062f \u0634\u0631\u06cc\u0641 \u0635\u0627\u062d\u0628"}, {"speaker": "A", "start": 13.56, "end": 14.08, "text": "\u06a9\u06cc\u0633\u06d2"}, {"speaker": "B", "start": 14.08, "end": 15.14, "text": "\u062f\u0628\u06cc\u062a \u06c1\u06cc\u06ba \u0634\u0631\u06cc\u0641 \u0635\u0627\u062d\u0628 \u06a9\u06cc\u061f"}, {"speaker": "A", "start": 15.93, "end": 26.81, "text": "\u062f\u0628\u06cc\u062a \u06c1\u06d2\u060c \u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u06af\u0631 \u0628\u0691\u06be\u0627 \u06c1\u06d2 \u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u06af\u0631 \u0628\u0691\u06be\u0627 \u06c1\u06d2\u061f \u0628\u062a\u0627\u0626\u06cc\u06ba \u06a9\u06cc\u0627 \u06a9\u06cc\u0627 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u0628\u06be\u06cc \u0634\u06af\u0631 \u062c\u0648 \u06c1\u06d2 \u0646\u0627 \u0622\u0626\u06cc \u0622\u0631\u06c1\u06cc \u06c1\u06d2 \u0628\u06c1\u062a \u0627\u0686\u06be\u0627 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u062f\u0648 \u062a\u06cc\u0646 \u062f\u0646 \u0633\u06d2 \u062a\u0648 \u0628\u06c1\u062a \u0632\u06cc\u0627\u062f\u06c1"}, {"speaker": "A", "start": 27.93, "end": 32.39, "text": "\u06a9\u062a\u0646\u06cc \u0622\u0626\u06cc \u0622\u0631\u06c1\u06cc \u06c1\u06d2\u061f \u062f\u0648 \u0633\u06a9\u0633\u06cc \u0633\u06cc\u0628\u0646\u060c \u062f\u0648 \u0646\u0627\u0626\u0646\u0679\u06cc \u0646\u0627\u0626\u0646\u060c \u0633\u0631\u06cc \u0633\u06cc\u0648\u0646\u0679\u06cc \u062a\u06be\u0631\u06cc"}, {"speaker": "B", "start": 34.73, "end": 36.76, "text": "\u062a\u0648 \u0628\u06c1\u062a \u0632\u06cc\u0627\u062f\u06c1 \u0628\u0691\u06be \u06af\u0626\u06cc \u06c1\u06d2 \u0622\u067e \u06a9\u06cc"}, {"speaker": "B", "start": 38.74, "end": 46.62, "text": "\u0622\u067e \u06a9\u0648 \u06a9\u062a\u0646\u0627 \u0639\u0631\u0635\u06c1 \u06c1\u0648\u06af\u0626\u06d2 \u0634\u06af\u0631 \u06a9\u0648 \u0627\u0633 \u062f\u0648\u0631\u0627\u0646\u06cc\u0627\u06ba \u06a9\u062a\u0646\u0627\u060c \u0627\u06cc\u06a9 \u0633\u0627\u0644 \u06a9\u0627 \u06c1\u0648 \u06af\u06cc\u0627\u061f \u0686\u0627\u0631 \u0633\u0627\u0644 \u06c1\u0648 \u06af\u06cc\u0627 \u06cc\u0648\u0631\u06cc\u0634\u0646 \u0644\u06a9\u06be \u062f\u0648 \u0641\u0648\u0631 \u06cc\u0626\u0631\u0632 \u06a9\u0627 \u06a9\u0648\u0626\u06cc \u0628\u062f \u067e\u0631\u06cc\u0632\u06cc \u06a9\u06cc \u06c1\u06d2 \u067e\u06cc\u0686\u06be \u0645\u06cc\u06ba\u061f"}, {"speaker": "A", "start": 46.62, "end": 48.42, "text": "\u0646\u06c1\u06cc\u06ba\u060c \u06a9\u0686\u06be"}, {"speaker": "B", "start": 48.42, "end": 50.4, "text": "\u06af\u06be\u0631"}, {"speaker": "A", "start": 50.4, "end": 51.92, "text": "\u0645\u06cc\u06ba \u0679\u06cc\u0646\u0634\u0646 \u06c1\u06d2 \u06a9\u0686\u06be \u06af\u06be\u0631 \u0645\u06cc\u06ba \u0679\u06cc\u0646\u0634\u0646 \u06c1\u06d2 \u0679\u06cc\u0646\u0634\u0646 \u0686\u0644"}, {"speaker": "B", "start": 51.92, "end": 53.16, "text": "\u0631\u06c1\u06cc \u06c1\u06d2 \u06a9\u0686\u06be \u0632\u06cc\u0627\u062f\u06c1 \u0627\u0633 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0628\u06be\u06cc"}, {"speaker": "A", "start": 53.16, "end": 57.18, "text": "\u0627\u06cc\u06a9 \u0645\u0633\u0626\u0644\u06c1 \u0627\u0648\u0631 \u06c1\u06d2 \u06cc\u0648\u0631\u06cc\u0646 \u06a9\u0627 \u062c\u0648 \u06c1\u06d2"}, {"speaker": "A", "start": 57.96, "end": 60.7, "text": "\u0631\u0627\u062a \u06a9\u0648 \u062a\u06cc\u0646 \u0686\u0627\u0631 \u062f\u0641\u0639\u06c1 \u0645\u062c\u06be\u06d2 \u06af\u06be\u0648\u0679\u0646\u0627 \u067e\u0691\u062a\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 60.7, "end": 64.74, "text": "\u0648\u06c1 \u0634\u06af\u0631 \u06c1\u0627\u0626\u06d2 \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0628\u06be\u06cc \u062a\u0648 \u06c1\u0648 \u0633\u06a9\u062a\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 65.42, "end": 69.74, "text": "\u0627\u0648\u0631 \u067e\u0633\u0679\u0631\u06cc\u0679 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2\u060c \u062d\u062f\u0648\u062f \u0628\u0691\u06be \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u067e\u0634\u0627\u067e \u06a9\u06cc \u062a\u06be\u06cc\u0644\u06d2 \u06a9\u06d2 \u067e\u0627\u0633 \u0648\u06c1 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0628\u06be\u06cc \u06c1\u0648 \u0633\u06a9\u062a\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 70.34, "end": 71.32, "text": "\u0627\u0633 \u0646\u0627\u06a9\u0639 \u06a9\u0627 \u0679\u06cc\u0633\u0679 \u06c1\u06d2"}, {"speaker": "B", "start": 71.84, "end": 78.24, "text": "\u0645\u0631\u062f\u0648\u06ba \u0645\u06cc\u06ba \u06a9\u06cc\u0627 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u061f 50 idiot \u06a9\u06d2 \u0628\u0639\u062f \u062c\u0648 \u06c1\u06d2 \u0648\u06c1 \u067e\u0634\u0627\u067e \u06a9\u06cc Wit Zomit \u06a9\u06d2 \u06cc\u06c1 \u0628\u0691\u06be"}, {"speaker": "B", "start": 78.24, "end": 98.16, "text": "\u062c\u0627\u062a\u06cc \u06cc\u06c1 \u0628\u0691\u06be\u062a\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2 \u0627\u06af\u0631 \u0622\u067e \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u06a9\u0648\u0626\u06cc \u062f\u0648\u0627\u0626\u06cc \u0646\u06c1 \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u06cc\u06ba \u0645\u06af\u0631 \u067e\u06c1\u0644\u06d2 \u06cc\u06c1 \u062f\u06cc\u06a9\u06be\u0646\u0627 \u067e\u0691\u062a\u0627 \u06c1\u06d2 \u0633\u0627\u0626\u0632 \u0628\u0691\u06be\u06cc \u06a9\u06c1"}, {"speaker": "B", "start": 98.16, "end": 115.94, "text": "\u0646\u06c1\u06cc\u06ba \u0628\u0691\u06be\u06cc \u062a\u0648 \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u06cc\u06a9 \u0679\u06cc\u0633\u0679 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u06c1\u0645 \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u0645\u0631\u0636 \u06c1\u0645\u0627\u0631\u06d2 \u067e\u0627\u0633 \u0622\u062a\u0627 \u06c1\u06d2 \u067e\u0686\u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u0648\u06c1 \u06a9\u06c1\u062a\u0627 \u06c1\u06d2 \u0645\u062c\u06be\u06d2 \u067e\u0634\u0627\u0628 \u0632\u0627\u062f\u06c1 \u0622\u0631\u06c1\u0627 \u06c1\u06d2 \u062a\u0648 \u067e\u06c1\u0644\u06cc \u0686\u06cc\u0632 \u062a\u0648 \u06c1\u0645\u0627\u0631\u06d2 \u0630\u06c1\u0646 \u0645\u06cc\u06ba \u0622\u062a\u06cc \u06c1\u06d2 \u0634\u06af\u0631 \u06a9\u0646\u0679\u0631\u0648\u0644 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0627\u0648\u0631 \u062f\u0648\u0633\u0631\u06cc \u0686\u06cc\u0632 \u06c1\u0645 \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06c1\u0648 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u0634\u06af\u0631 \u06a9\u0646\u0679\u0631\u0648\u0644 \u0646\u06c1 \u06c1\u0648 \u0648\u06c1 \u0628\u06be\u06cc \u0628\u0686\u0627\u0624 \u0627\u0648\u0631 \u067e\u0631\u0648\u0633\u0679\u06cc\u0679 \u0628\u0691\u06be\u0627 \u0648\u06c1 \u0628\u06be\u06cc \u0628\u0686\u0627\u0624 \u0622\u067e \u06a9\u0645 \u0627\u06cc\u06a9 \u0679\u06cc\u0633\u0679 \u067e\u0631\u0648\u0633\u0679\u06cc\u0679 \u06a9\u0627 \u0644\u06a9\u06be \u06a9\u0631 \u062f\u06cc\u06ba \u0648\u06c1 \u0622\u067e \u0679\u06cc\u0633\u0679 \u0636\u0631\u0648\u0631 \u06a9\u0631\u0648\u0627\u0646\u06cc \u062c\u0627\u0626\u06d2 \u06af\u0627"}, {"speaker": "B", "start": 116.92, "end": 123.4, "text": "\u0634\u06af\u0631 \u0628\u0691\u06be\u0646\u06d2 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0628\u06be\u06cc \u067e\u0634\u0627\u0628 \u0632\u0627\u062f\u06c1 \u0622\u0631\u06c1\u0627 \u06c1\u0648\u06af\u0627 \u0627\u0646\u0633\u0648\u0646\u06cc \u067e\u06c1 \u0622 \u06a9\u06cc\u0648\u06ba \u0646\u06c1\u06cc\u06ba \u0622 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u0622\u067e \u0646\u06c1\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u062c\u06be\u0646\u062c\u0679\u06d2 \u0631\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u062a\u0646\u06cc \u062f\u0648\u0627\u0626\u06cc\u0627\u06ba \u06a9\u06be\u0627\u062a\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 124.52, "end": 124.88, "text": "\u0622"}, {"speaker": "B", "start": 124.88, "end": 126.04, "text": "\u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u0646\u0627 \u0627\u06af\u0631 \u0645\u06cc\u06ba \u0644\u06a9\u06be \u06a9\u0631 \u062f\u0648\u06ba"}, {"speaker": "A", "start": 134.04, "end": 134.76, "text": "\u06a9\u0648\u0646\u0633\u06cc \u0627\u0646\u0633\u0648\u0646\u06cc"}, {"speaker": "B", "start": 134.76, "end": 136.4, "text": "\u0644\u06af\u0627\u062a\u06cc \u06c1\u06d2"}, {"speaker": "A", "start": 138.14, "end": 138.7, "text": "\u0646\u06cc\u06a9\u0633 \u06a9\u0627\u0631\u0688"}, {"speaker": "B", "start": 138.7, "end": 139.72, "text": "\u0644\u06cc\u062a\u06cc \u06c1\u06d2 \u067e\u06cc\u0646 \u0648\u0627\u0644\u06cc \u06c1\u06d2"}, {"speaker": "A", "start": 140.18, "end": 140.72, "text": "\u0646\u06c1\u06cc\u06ba \u0646\u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 140.72, "end": 145.06, "text": "\u0633\u0631\u0646\u062c \u0648\u0627\u0644\u06cc \u06c1\u06d2 \u06c1\u0627\u06ba \u0633\u0631\u0646\u062c \u0648\u0627\u0644\u06cc \u06a9\u0648\u0626\u06cc \u0628\u06be\u06cc \u0644\u06a9\u06be\u0646\u0627 \u06c1\u06d2 \u0627\u0686\u06be\u06cc \u0627\u0646\u0633\u0648\u0646\u06cc \u062c\u0648 \u0622\u067e \u062c\u0648 \u0644\u06af\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u06c1\u0627\u06ba"}, {"speaker": "A", "start": 145.06, "end": 146.18, "text": "\u0645\u06cc\u0631\u06cc \u062f\u06cc\u06a9\u06be \u0644\u06cc\u0646\u0627 \u06c1\u0648"}, {"speaker": "B", "start": 146.18, "end": 150.44, "text": "\u06c1\u0645\u0627\u0631\u06cc \u062f\u06cc\u06a9\u06be \u0644\u06cc\u0646\u0627 \u06c1\u0648 \u06c1\u0645\u0627\u0631\u06cc \u062f\u06cc\u06a9\u06be \u0644\u06cc\u0646\u0627 \u06c1\u0648 \u06c1\u0645\u0627\u0631\u06cc \u062f\u06cc\u06a9\u06be \u0644\u06cc\u0646\u0627 \u06c1\u0648 \u0622 \u062c\u0627\u0626\u06cc\u06ba \u0628\u0627\u067e"}, {"speaker": "A", "start": 150.44, "end": 151.3, "text": "\u06c1\u0627\u06ba"}, {"speaker": "B", "start": 151.3, "end": 151.78, "text": "\u0627\u0648\u0631 \u06a9\u06cc\u0627"}, {"speaker": "B", "start": 152.7, "end": 153.74, "text": "\u0645\u062d\u0628\u062a \u0628\u0691\u06be\u06d2 \u06af\u06cc \u0627\u0648\u0631"}, {"speaker": "B", "start": 155.72, "end": 165.17, "text": "\u0633\u0679\u0627\u0631\u0679\u0646\u06af \u0627\u0646\u0633\u0648\u0646\u06cc \u0628\u0691\u06be\u0646\u06d2 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u062f\u0648\u0627\u0626\u06cc \u0634\u06a9\u0631 \u0628\u0691\u06be\u06d2 \u06af\u06cc \u0627\u0646 \u06a9\u06cc \u0622\u0626\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc \u0648\u06c1 \u062f\u0648\u0631 \u0633\u0627\u062a\u06be \u06a9\u0679 \u06a9\u0631 \u06a9\u06d2 \u062c\u0627 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0646\u0627 \u0628\u0627\u067e \u0644\u0648\u06af"}, {"speaker": "B", "start": 166.11, "end": 170.19, "text": "\u0627\u0686\u06be\u0627 \u0688\u06cc\u0633\u06cc\u062c\u0646 \u06c1\u06d2 \u0627\u06af\u0631 \u0622\u067e \u0627\u0646\u0633\u0648\u0646\u06cc \u067e\u0631 \u0622 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u0646\u0627 \u062c\u06be\u0646\u062c\u0691 \u062e\u062a\u0645 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u062a\u0648 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0634\u0631\u0648\u0639 \u06a9\u0631\u0648\u06ba \u06af\u0627"}, {"speaker": "B", "start": 170.77, "end": 172.15, "text": "\u062a\u0642\u0631\u06cc\u0628\u0627\u064b \u0686\u06be\u067e\u06cc\u0633 \u0627\u0648\u0631 \u0628\u0627\u0626\u06cc\u0633 \u0633\u06d2"}, {"speaker": "B", "start": 172.91, "end": 178.63, "text": "\u0635\u0628\u062d \u0645\u06cc\u06ba \u0686\u06be\u067e\u06cc\u0633 \u0627\u0648\u0631 \u0631\u0627\u062a \u0645\u06cc\u06ba \u0628\u0627\u0626\u06cc\u0633 \u06c1\u0648\u06ba \u06af\u0627 \u062a\u0648 \u0627\u0633 \u0633\u06d2 \u0622\u067e \u06a9\u06cc \u0634\u06a9\u0631 \u0628\u06be\u06cc \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u06cc \u062f\u0648\u0627\u0626\u06cc\u0627\u06ba \u0628\u06be\u06cc \u0645\u06cc\u06ba \u06a9\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u0648\u06ba"}, {"speaker": "B", "start": 179.17, "end": 188.55, "text": "\u0627\u0648\u0631 \u0628\u0627\u0642\u06cc \u062a\u0648 \u06a9\u0686\u06be \u062f\u0648\u0627\u0626\u06cc\u0627\u06ba \u0628\u06cc\u0633\u06cc \u0631\u06c1\u0646\u06d2 \u062f\u06cc\u06ba \u06af\u06d2 \u0627\u0686\u06be\u0627 \u0627\u0628\u06be\u06cc \u0622\u067e \u0646\u06d2 \u0645\u062c\u06be\u06d2 \u06a9\u06c1\u0627 \u0627\u06cc\u06a9 \u062a\u0648 \u0645\u06cc\u0631\u06cc \u06a9\u0645\u067e\u0644\u06cc\u0646 \u06c1\u06d2 \u06c1\u0627\u0626\u06cc \u0634\u06a9\u0631 \u06a9\u06cc \u0627\u06cc\u06a9 \u062a\u0648 \u0645\u062c\u06be\u06d2 \u0627\u06cc\u0633 \u067e\u06cc\u0686 \u067e\u0631 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u062f\u0648\u0633\u0631\u0627 \u0645\u062c\u06be\u06d2 \u0628\u0634\u0627\u0628 \u0632\u06cc\u0627\u062f\u06c1 \u0622 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0627\u06cc\u0633\u06cc"}, {"speaker": "A", "start": 188.55, "end": 189.67, "text": "\u06c1\u06d2 \u0628\u0633 \u06cc\u06c1"}, {"speaker": "A", "start": 190.69, "end": 196.59, "text": "\u0627\u06cc\u0631\u06cc\u0627 \u062c\u0648 \u06c1\u06d2 \u0646\u0627 \u06cc\u06c1 \u06a9\u0644 \u0631\u0648\u0679 \u062c\u0633 \u0637\u0631\u0641 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u0648\u06c1 \u062a\u0642\u0631\u06cc\u0628 \u0628\u0627\u0644\u06a9\u0644 \u0627\u0639\u0644\u06cc\u0645 \u0634\u0631\u0648\u0639 \u06c1\u0648 \u062c\u0627\u062a\u0627"}, {"speaker": "B", "start": 196.59, "end": 206.49, "text": "\u06c1\u06d2 \u0628\u0634\u0627\u0628 \u06a9\u06cc \u0630\u0627\u062a \u062f\u0646 \u0645\u06cc\u06ba \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u06d2 \u0631\u0627\u062a \u0645\u06cc\u06ba \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u06d2 \u062f\u0646 \u0645\u06cc\u06ba \u0628\u06be\u06cc \u06c1\u06d2 \u0627\u0648\u0631 \u0631\u0627\u062a \u0645\u06cc\u06ba \u0628\u06be\u06cc \u06c1\u06d2 \u0631\u0627\u062a \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u062f\u0646 \u0635\u0648\u0631\u062a \u0622\u06a9\u0631 \u06c1\u06d2 \u0644\u06cc\u06af\u0648 \u0635\u0628\u062d \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0641\u0627\u0626\u062f\u06c1 \u06c1\u06d2 \u0627\u06af\u0631 \u0632\u06cc\u0627\u062f\u06c1 \u06a9\u0628 \u06c1\u06d2 \u062f\u0646 \u0645\u06cc\u06ba \u06cc\u0627 \u0631\u0627\u062a \u0645\u06cc\u06ba"}, {"speaker": "B", "start": 208.74, "end": 212.86, "text": "\u0632\u06cc\u0627\u062f\u06c1 \u062f\u0646 \u0645\u06cc\u06ba \u0644\u06cc\u06a9\u0646 \u0631\u0627\u062a \u0645\u06cc\u06ba \u0628\u06be\u06cc \u067e\u0627\u06a9 \u067e\u0627\u06a9 \u062a\u06cc\u0646 \u062a\u06cc\u0646 \u0686\u0627\u0631 \u0686\u0627\u0631 \u062f\u0628\u0627\u0626\u06cc\u06ba \u06af\u06d2"}, {"speaker": "B", "start": 217.77, "end": 219.75, "text": "\u0645\u0644\u06a9\u0648 \u0635\u062d\u06cc\u062d \u06c1\u0648 \u06af\u06cc\u0627 \u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0627\u0633 \u06a9\u0648 \u06c1\u0645 \u06a9\u0631 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba"}, {"speaker": "B", "start": 221.54, "end": 224.14, "text": "\u0679\u06be\u06cc\u06a9 \u06c1\u06d2 \u0627\u0628 \u062f\u06cc\u06a9\u06be\u0648 \u0627\u0628 \u062c\u0648 \u062f\u0628\u0627\u0626\u06cc\u06ba \u0622\u06af\u06d2 \u0628\u062a\u0627\u0624\u06ba \u06af\u06d2 \u06cc\u06c1 \u06a9\u06cc\u0627 \u06a9\u06cc\u0627 \u06c1\u06d2"}, {"speaker": "B", "start": 233.3, "end": 234.64, "text": "\u0688\u0627\u0648\u0679\u0631 \u0631\u0648\u06cc\u0633\u0679\u0627 \u0627\u0648\u0631 \u0641\u06cc\u0646\u0648 \u06af\u06cc\u0679"}, {"speaker": "B", "start": 236.42, "end": 240.0, "text": "\u0627\u0686\u06be\u0627 \u062f\u0631\u062f \u0628\u06c1\u062a \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u06d2 \u06a9\u06be\u0648 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06d2 \u067e\u0646\u062f\u0648\u06ba \u0645\u06cc\u06ba \u0645\u06cc\u06ba \u06a9\u06cc\u0627 \u06c1\u0644\u06a9\u0627 \u0628\u0648\u0644\u062a\u0627 \u06c1\u06d2 \u0646\u06c1\u06cc\u06ba"}, {"speaker": "A", "start": 240.0, "end": 245.26, "text": "\u0632\u06cc\u0627\u062f\u06c1 \u0637\u0648\u0631 \u067e\u0631 \u06cc\u06c1 \u062c\u0648 \u06c1\u06d2 \u0646\u0627 \u062f\u0627\u0626\u06d2 \u0633\u0627\u0626\u0679 \u062c\u0648 \u06c1\u06d2 \u0627\u0633 \u0645\u06cc\u06ba \u0622\u06c1 \u062a\u0648 \u0632\u06cc\u0627\u062f\u06c1"}, {"speaker": "B", "start": 245.26, "end": 252.78, "text": "\u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u0627\u0686\u06be\u0627 \u062c\u0628 \u0632\u06cc\u0627\u062f\u06c1 \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u0646\u0627 \u062c\u0628 \u0632\u06cc\u0627\u062f\u06c1 \u062f\u0631\u062f \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u0627\u0628 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06cc \u0634\u06af\u0631 \u06a9\u0646\u0679\u0631\u0648\u0644 \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u0648\u06ba \u0648\u06c1 \u067e\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u06cc \u062a\u0648 \u06c1\u0648 \u062c\u0627\u0626\u06d2"}, {"speaker": "B", "start": 253.34, "end": 259.62, "text": "\u0634\u06af\u0631 \u0644\u06a9\u06be\u062a\u06d2 \u06c1\u06cc\u06ba \u0686\u0627\u0631\u0679\u0646\u06af \u0648\u063a\u06cc\u0631\u06c1 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u0622\u067e \u0644\u06a9\u06be \u06a9\u0631 \u06af\u0626\u06d2 \u06c1\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u06a9\u0686\u06be \u0644\u06a9\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u0644\u06cc\u06a9\u0646 \u0648\u06c1 \u0628\u06be\u06cc \u0628\u0633 \u0622 \u06a9\u06d2 \u067e\u06cc\u0686\u06be\u06d2 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u0686\u06cc\u06a9 \u06a9\u0631\u062a\u06d2"}, {"speaker": "A", "start": 259.62, "end": 261.02, "text": "\u0631\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u0644\u06cc\u0645\u0648\u0679\u0631 \u0644\u06cc\u06d2"}, {"speaker": "B", "start": 261.02, "end": 278.89, "text": "\u062c\u06af\u06c1 \u0633\u06d2 \u0644\u06af\u062a\u0627 \u06c1\u06d2 \u0627\u0686\u06be\u0627 \u0628\u06c1\u062a \u0632\u06cc\u0627\u062f\u06c1 \u0627\u06cc\u0633\u0627 \u0628\u06be\u06cc \u0686\u0627\u067e \u06a9\u0648 \u0627\u06cc\u0679 \u06a9\u0631\u06cc\u06ba \u0645\u0644\u0646\u06cc \u06a9\u0627 \u0633\u0627\u0626\u06cc \u06c1\u06d2 \u0646\u0627 \u062f\u0648\u0627\u0626\u06cc\u0627\u06ba \u0645\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0646\u0633\u0644\u06cc\u0646 \u0622\u067e \u06a9\u06cc \u0648\u0627\u0644\u06cc \u0645\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u0648 \u0633\u0631\u0646\u062c \u0648\u0627\u0644\u06cc \u0644\u06af\u0627\u062a\u06cc \u06c1\u06d2 \u0646\u0627 \u062c\u06cc \u0628\u0633 \u0648\u06c1\u06cc \u0648\u0627\u0644\u06cc \u0627\u0633 \u0633\u06d2 \u0644\u06af\u0627 \u06c1\u06d2 \u0637\u0631\u06cc\u0642\u06c1 \u067e\u06be\u0631 \u0628\u06be\u06cc \u0627\u06cc\u06a9 \u0628\u0627\u062a \u0633\u0645\u062c\u06be \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0627\u06af\u0631 \u0686\u0627\u067e \u0622\u062a\u0627 \u06c1\u0648\u06af\u0627 \u0645\u062c\u06be\u06d2 \u067e\u06be\u0631 \u0628\u06be\u06cc \u0627\u06cc\u06a9 \u0628\u0627\u062a \u0633\u0645\u062c\u06be \u062c\u0627\u0626\u06d2 \u0627\u0648\u0631 \u062f\u06a9\u06be\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0686\u06cc\u0632\u0627 \u062c\u06cc\u0633\u0627 \u0622\u067e \u0628\u06cc\u0679\u06be\u06cc\u06ba \u0645\u06cc\u06ba \u067e\u0631 \u0686\u0627\u067e \u06a9\u0648"}, {"speaker": "A", "start": 278.89, "end": 279.49, "text": "\u062f\u06cc\u06a9\u06be\u062a\u0627 \u06c1\u0648\u06ba"}, {"speaker": "B", "start": 281.59, "end": 283.85, "text": "\u0622\u067e \u06a9\u0627 \u0628\u06be\u06cc \u06c1\u06d2 \u062c\u06cc \u0627\u0686\u06be\u0627 \u0622\u067e \u06a9\u0627 \u0628\u06be\u06cc \u062f\u06cc\u06a9\u06be\u0627 \u06c1\u0648\u06ba"}], "language": "auto", "duration_s": 286.0, "num_segments": 98}